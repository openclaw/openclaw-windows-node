{
  "card": {
    "type": "AdaptiveCard",
    "version": "1.5",
    "header": "Mercury",
    "body": [
      {
        "type": "Container",
        "backgroundImage": {
          "url": "openclaw-asset:backdrop",
          "fillMode": "Cover"
        },
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "verticalContentAlignment": "Center",
                "items": [
                  {
                    "type": "Image",
                    "url": "openclaw-asset:planet-muted",
                    "altText": "Mercury, dimmed to indicate retrograde",
                    "size": "Small",
                    "$when": "${value == 'Yes' && $host.widgetSize == 'small'}"
                  },
                  {
                    "type": "Image",
                    "url": "openclaw-asset:planet-muted",
                    "altText": "Mercury, dimmed to indicate retrograde",
                    "size": "Medium",
                    "$when": "${value == 'Yes' && $host.widgetSize != 'small'}"
                  },
                  {
                    "type": "Image",
                    "url": "openclaw-asset:planet-lit",
                    "altText": "Mercury, bright to indicate no retrograde",
                    "size": "Small",
                    "$when": "${value == 'No' && $host.widgetSize == 'small'}"
                  },
                  {
                    "type": "Image",
                    "url": "openclaw-asset:planet-lit",
                    "altText": "Mercury, bright to indicate no retrograde",
                    "size": "Medium",
                    "$when": "${value == 'No' && $host.widgetSize != 'small'}"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "spacing": "Medium",
                "verticalContentAlignment": "Center",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "In retrograde",
                    "size": "Medium",
                    "weight": "Bolder",
                    "color": "Light",
                    "wrap": true,
                    "maxLines": 2,
                    "$when": "${value == 'Yes'}"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Not in retrograde",
                    "size": "Medium",
                    "weight": "Bolder",
                    "color": "Light",
                    "wrap": true,
                    "maxLines": 2,
                    "$when": "${value == 'No'}"
                  },
                  {
                    "type": "TextBlock",
                    "text": "${$root.content.clearDetail}",
                    "size": "Small",
                    "color": "Light",
                    "spacing": "Small",
                    "wrap": true,
                    "maxLines": 2,
                    "$when": "${value == 'No' && $host.widgetSize != 'small'}"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "data": {
    "clearDetail": "Something else must be bumming you out."
  }
}
