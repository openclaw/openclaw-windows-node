<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A2UI rendering tests that drive the real WinUI3 / WindowsAppSDK runtime.
    A class-fixture spins a dedicated STA dispatcher thread and starts a single
    hidden Application + Window once per test process; tests marshal onto the
    UI thread to construct surfaces and walk the resulting visual tree.

    Runs only on Windows. Slower than pure-data tests (~seconds to bootstrap,
    tens of ms per assertion) but exercises the actual XAML produced by the
    A2UI renderers.
  -->

  <PropertyGroup>
    <!-- Override the net10.0 default from tests/Directory.Build.props -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>

    <!-- Deliberately NOT setting <UseWinUI>true</UseWinUI>: that flag turns the
         project into a WinUI app (forces WinExe output, swaps the test SDK's
         entry point for the XAML-generated one) and breaks the testhost wiring
         that copies Microsoft.TestPlatform.* DLLs. We don't author any XAML
         here — we just reference WinUI3 types programmatically — so we keep the
         standard test-SDK pipeline and pull WinUI in via the package reference
         + ProjectReference to OpenClaw.Tray.WinUI. -->

    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>OpenClaw.Tray.UITests</RootNamespace>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefineConstants Condition="'$(LocalAiProofBaseline)' == 'true'">$(DefineConstants);LOCAL_AI_BASELINE</DefineConstants>

    <!-- System.Drawing.Common 4.7.0 advisory comes in transitively via the
         Tray.WinUI ProjectReference. The main project warns; we don't want it
         to escalate to an error here just because tests/Directory.Build.props
         sets TreatWarningsAsErrors=true. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Axe.Windows" Version="2.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MicrosoftWindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(MicrosoftWindowsSdkBuildToolsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MicrosoftWindowsAppSDKVersion</_Parameter1>
      <_Parameter2>$(MicrosoftWindowsAppSDKVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClaw.TestSupport\OpenClaw.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\OpenClaw.Tray.WinUI\OpenClaw.Tray.WinUI.csproj" Aliases="global,TrayRuntime" />
    <ProjectReference Include="..\..\src\OpenClaw.Shared\OpenClaw.Shared.csproj" />
    <ProjectReference Include="..\OpenClaw.GatewayFixtureHost\OpenClaw.GatewayFixtureHost.csproj" />
    <ProjectReference Include="..\OpenClaw.TestSupport\OpenClaw.TestSupport.csproj" />
  </ItemGroup>

  <!--
    UIThreadFixture bootstraps the registered Windows App Runtime. The production
    tray stays self-contained, but its SDK SelfContained.targets emits native
    framework files as None/CopyToOutputDirectory items that flow through the
    project reference into GetCopyToOutputDirectoryItems. Do not copy its Input
    module into this framework-bootstrapped testhost: loading both copies registers
    InputNonClientPointerSource twice and fail-fasts when SetupWindow enables its
    title bar. Keep the exclusion at this consumer, not the production project.
  -->
  <Target Name="UseFrameworkInputRuntime" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_FrameworkInputRuntimeCopy Include="@(AllItemsFullPathWithTargetPath)"
                                  Condition="'%(TargetPath)' == 'Microsoft.UI.Input.dll'" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_FrameworkInputRuntimeCopy)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_FrameworkInputRuntimeCopy)" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_FrameworkInputRuntimeCopy)" />
      <AllItemsFullPathWithTargetPath Remove="@(_FrameworkInputRuntimeCopy)" />
    </ItemGroup>
  </Target>

  <!-- Normal incremental builds also retire the one conflicting pre-fix output.
       A lock is a build failure, not permission to stop an unrelated process. -->
  <Target Name="RemoveStaleAppLocalInputRuntime" BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(TargetDir)Microsoft.UI.Input.dll" />
  </Target>

  <Target Name="UseSourceSetupAssetsForPriConsumerCopy"
          AfterTargets="AddPriPayloadFilesToCopyToOutputDirectoryItems">
    <ItemGroup>
      <!-- Like the tray consumer, use stable sources rather than transient
           SetupEngine.UI PRI expansion files, retaining the qualified URI paths. -->
      <_AllChildProjectItemsWithTargetPath
          Remove="@(_AllChildProjectItemsWithTargetPath)"
          Condition="$([System.String]::Copy('%(_AllChildProjectItemsWithTargetPath.TargetPath)').StartsWith('OpenClaw.SetupEngine.UI\Assets\Setup\'))" />
      <_SetupPriAssetSource Include="..\..\src\OpenClaw.Tray.WinUI\Assets\Setup\**\*" />
      <_AllChildProjectItemsWithTargetPath Include="@(_SetupPriAssetSource)">
        <TargetPath>OpenClaw.SetupEngine.UI\Assets\Setup\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_AllChildProjectItemsWithTargetPath>
    </ItemGroup>
  </Target>

  <!-- A WinExe ProjectReference copies its named PRI but not its compiled
       window payload. The unpackaged testhost also needs a default PRI name. -->
  <Target Name="CopyStoreMigrationWindowTestResources" AfterTargets="Build">
    <ItemGroup>
      <_TrayTestResourceRoot Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(Filename)' == 'OpenClaw.Tray.WinUI' and '%(Extension)' == '.dll'" />
    </ItemGroup>
    <Error Condition="'@(_TrayTestResourceRoot)' == ''"
           Text="The production tray reference is required for mounted migration window tests." />
    <Copy SourceFiles="@(_TrayTestResourceRoot->'%(RootDir)%(Directory)Windows\StoreMigrationWindow.xbf')"
          DestinationFolder="$(TargetDir)Windows" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TrayTestResourceRoot->'%(RootDir)%(Directory)Pages\ChatPage.xbf')"
          DestinationFolder="$(TargetDir)Pages" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TrayTestResourceRoot->'%(RootDir)%(Directory)Pages\LocalAiPage.xbf')"
          DestinationFolder="$(TargetDir)Pages" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TrayTestResourceRoot->'%(RootDir)%(Directory)OpenClaw.Tray.WinUI.pri')"
          DestinationFiles="$(TargetDir)resources.pri" SkipUnchangedFiles="true" />
  </Target>

</Project>
