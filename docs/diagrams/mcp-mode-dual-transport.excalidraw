        {
          "type": "text",
          "id": "text-004"
        }
      ]
    },
    {
      "type": "text",
      "id": "text-004",
      "x": 280,
      "y": 152,
      "width": 300,
      "height": 30,
      "text": "NodeService",
      "fontSize": 20,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "rect-003"
    },
    {
      "type": "text",
      "id": "text-005",
      "x": 280,
      "y": 195,
      "width": 940,
      "height": 192,
      "text": "List<INodeCapability> _capabilities\n\nprivate void Register(INodeCapability cap)\n{\n    _capabilities.Add(cap);\n    _nodeClient?.RegisterCapability(cap);\n}",
      "fontSize": 15,
      "fontFamily": 3,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
