    {
      "type": "text",
      "id": "text-001",
      "x": 40,
      "y": 20,
      "width": 1300,
      "height": 42,
      "text": "Single capability registry, two transports",
      "fontSize": 28,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-002",
      "x": 40,
      "y": 68,
      "width": 1420,
      "height": 45,
      "text": "NodeService holds one List<INodeCapability>. Register() adds to that list and registers with the gateway client; the MCP bridge reads the same live list for tools/list.",
      "fontSize": 15,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "rect-003",
      "x": 260,
      "y": 140,
