                        "id": "refresh-text-913",
                        "text": "Use an existing gateway",
                        "style": "heading",
                        "color": "ink"
                      },
                      {
                        "id": "refresh-text-914",
                        "text": "Connect through Connection settings, not an inline remote-install wizard.",
                        "style": "body",
                        "color": "muted"
                      },
                      {
                        "id": "refresh-buttons-915",
                        "layout": "row",
                        "gap": "2",
                        "align": "center",
                        "children": [
                          {
                            "note": "Prototype: navigate to the separate Settings page, not an overlay or browser pop-up. Production: open the companion in a separate native window.",
                            "id": "refresh-button-912",
                            "component": "Button",
                            "props": {
                              "children": "Open Settings",
                              "variant": "secondary"
                            },
                            "on": {
                              "tap": {
                                "navigate": "settings",
                                "setState": {
                                  "companionAdvanced": true,
                                  "nativeAgentsExpanded": true,
                                  "settingsTab": "settings"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "refresh-stack-924",
                "layout": "stack",
                "gap": "3",
                "visibleWhen": {
                  "setupStep": "capabilities"
                },
                "children": [
                  {
                    "id": "refresh-text-918",
                    "text": "Capabilities and permissions",
                    "style": "heading",
                    "color": "ink"
                  },
                  {
                    "id": "refresh-text-919",
                    "text": "Review camera, microphone, location, notifications and screen capture before installation.",
                    "style": "body",
                    "color": "ink"
                  },
                  {
                    "id": "refresh-buttons-923",
                    "layout": "row",
                    "gap": "2",
                    "align": "center",
                    "children": [
                      {
                        "id": "refresh-button-920",
