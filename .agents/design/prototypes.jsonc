                        "radius": "sm",
                        "grow": true,
                        "on": {
                          "tap": {
                            "toggle": "dashboardAgents"
                          }
                        },
                        "children": [
                          {
                            "note": "Circular identity badge, matching the upstream switcher structure with the companion's Agents robot artwork.",
