                            "layout": "stack",
                            "align": "center",
                            "justify": "center",
                            "background": "control",
                            "radius": "pill",
                            "width": "var(--space-6)",
                            "height": "var(--space-6)",
                            "children": [
                              {
                                "note": "Unmodified Windows companion artwork from src\\OpenClaw.Tray.WinUI\\Assets\\SidebarIcons\\Agents.svg. Embedded for offline preview. Native Hub uses these colored SVGs normally and system-foreground FontIcons in high contrast; this image preview does not simulate that native substitution.",
                                "id": "dashboard-assistant-avatar-image",
                                "image": "data:image/svg+xml;base64,",
                                "fit": "contain",
                                "width": "var(--space-5)",
                                "height": "var(--space-5)",
                                "alt": ""
