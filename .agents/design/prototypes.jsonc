  "screens": [
    {
      "note": "Layout reference: openclaw/openclaw@857173632fc708b8824c3129cad6abe6347eaa79. Preserves the reviewed Dashboard shell; dashboardPage selects distinct workspace surfaces. All added data and actions are synthetic. Marked gateway-only destinations are not native feature commitments.",
      "id": "hub",
      "name": "Workspace | all pages",
      "sectionId": "workspace",
      "device": "winui-modern",
      "fit": "screen",
      "root": {
        "id": "dashboard-root",
        "layout": "stack",
        "background": "paper",
        "grow": true,
        "children": [
          {
            "id": "colleague-workspace-styles",
            "component": "WorkspaceReferenceStyles",
            "props": {}
          },
          {
            "id": "hub-companion-menu-styles",
            "component": "CompanionMenuStyles"
          },
          {
            "id": "hub-fluent-styles",
            "component": "FluentPageStyles"
          },
          {
            "note": "Uses existing Fluent subtle tokens for the scene-graph sidebar hotspots; replaces authoring hover outlines only in this sidebar.",
            "id": "dashboard-subtle-styles",
            "component": "SidebarSubtleStyles"
          },
          {
            "id": "dashboard-titlebar",
            "layout": "row",
            "gap": "2",
            "padding": "3",
            "align": "center",
            "height": "var(--space-7)",
            "children": [
              {
                "id": "dashboard-nav-toggle",
                "component": "PaneToggleButton",
                "on": {
                  "tap": {
                    "toggle": "dashboardNav"
                  }
                }
              },
              {
                "id": "dashboard-app-title",
                "text": "OpenClaw",
                "style": "body"
              }
            ]
          },
          {
            "id": "dashboard-window-body",
            "layout": "stack",
            "direction": "horizontal",
            "gap": "1",
            "padding": "2",
            "grow": true,
            "children": [
              {
                "id": "dashboard-sidebar",
                "layout": "stack",
                "gap": "2",
                "padding": "0",
