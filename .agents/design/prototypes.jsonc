      "modals": [
        {
          "id": "preview-boundary",
          "root": {
            "id": "settings-refresh-stack-10",
            "layout": "stack",
            "gap": "3",
            "padding": "5",
            "children": [
              {
                "id": "settings-refresh-text-6",
                "text": "Preview only",
                "style": "heading",
                "color": "ink"
              },
              {
                "id": "settings-refresh-text-7",
                "text": "This action is shown for layout review. Nothing is saved, installed, sent, approved, captured, or connected.",
                "style": "body",
                "color": "ink"
              },
              {
                "id": "settings-refresh-text-8",
                "text": "Gateway-owned surfaces and unsupported native destinations stay separate from the Windows port.",
                "style": "small",
                "color": "muted"
              },
              {
                "id": "settings-refresh-button-9",
                "component": "Button",
                "props": {
                  "children": "Close",
                  "variant": "secondary"
                },
                "on": {
                  "tap": {
                    "closeModal": true
                  }
                }
              }
            ]
          },
          "title": "Design preview"
        }
      ]
    },
    {
      "note": "Windows-specific flow from docs/ONBOARDING_WIZARD.md: security, welcome, capability/readiness gate, progress, installed handoff, gateway-driven onboard, complete. Error/retry previews preserve ownership and do not perform setup.",
      "id": "setup",
      "name": "Onboarding | safe preview",
      "sectionId": "windows",
      "device": "winui-modern",
      "fit": "screen",
      "root": {
        "id": "setup-root",
        "layout": "stack",
        "gap": "1",
        "background": "paper",
        "grow": true,
        "children": [
          {
            "id": "setup-fluent-styles",
            "component": "FluentPageStyles"
          },
          {
            "id": "setup-styles",
            "component": "SidebarSubtleStyles"
          },
          {
            "id": "refresh-stack-971",
            "layout": "stack",
            "direction": "horizontal",
            "gap": "3",
            "padding": "3",
            "align": "center",
            "height": "var(--space-7)",
            "children": [
              {
                "id": "refresh-text-968",
                "text": "OpenClaw",
                "style": "small",
                "color": "ink"
              },
              {
                "id": "refresh-button-970",
                "component": "Button",
                "props": {
                  "children": "Back to app",
                  "variant": "secondary"
                },
                "on": {
                  "tap": {
                    "navigate": "hub"
                  }
                }
              },
              {
                "id": "refresh-spacer-969",
                "spacer": true,
                "grow": true
              }
            ]
          },
          {
            "id": "refresh-setup-body",
            "layout": "scroll",
            "gap": "3",
            "padding": "6",
            "margin": "2",
            "background": "surface",
            "radius": "md",
            "grow": true,
            "children": [
              {
                "id": "refresh-text-899",
                "text": "Set up OpenClaw",
                "style": "heading",
                "color": "ink"
              },
              {
                "id": "refresh-stack-901",
                "component": "FluentInfoBar",
                "props": {
                  "glyph": "",
                  "message": "Every step is simulated. No installation, permission, network, credential or startup change occurs.",
                  "severity": "info",
                  "title": "Preview information"
                }
              },
              {
                "id": "refresh-stack-905",
                "layout": "stack",
                "gap": "3",
                "visibleWhen": {
                  "setupStep": "security"
                },
                "children": [
                  {
                    "id": "refresh-text-902",
                    "text": "Understand device access",
                    "style": "heading",
                    "color": "ink"
                  },
                  {
                    "id": "refresh-text-903",
                    "text": "Your assistant can use capabilities you enable on this PC. Review permissions and approve sensitive actions.",
                    "style": "body",
                    "color": "ink"
                  },
                  {
                    "id": "refresh-button-904",
                    "component": "Button",
                    "props": {
                      "children": "Continue",
                      "variant": "primary"
                    },
                    "on": {
                      "tap": {
                        "setState": {
                          "setupStep": "welcome"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "id": "refresh-stack-917",
                "layout": "stack",
                "gap": "3",
                "visibleWhen": {
                  "setupStep": "welcome"
                },
                "children": [
                  {
                    "id": "refresh-text-906",
                    "text": "Choose a gateway",
                    "style": "heading",
                    "color": "ink"
                  },
                  {
                    "id": "refresh-stack-911",
                    "layout": "stack",
                    "gap": "3",
                    "padding": "4",
                    "appearance": {
                      "background": "surface",
                      "radius": "md",
                      "borderColor": "line",
                      "borderWidth": 1
                    },
                    "children": [
                      {
                        "id": "refresh-text-908",
                        "text": "Set up locally",
                        "style": "heading",
                        "color": "ink"
                      },
                      {
                        "id": "refresh-text-909",
                        "text": "Create a dedicated app-owned WSL gateway. Readiness and replacement safeguards remain required.",
                        "style": "body",
                        "color": "muted"
                      },
                      {
                        "id": "refresh-buttons-910",
                        "layout": "row",
                        "gap": "2",
                        "align": "center",
                        "children": [
                          {
                            "id": "refresh-button-907",
                            "component": "Button",
                            "props": {
                              "children": "Preview local setup",
                              "variant": "primary"
                            },
                            "on": {
                              "tap": {
                                "setState": {
                                  "setupStep": "capabilities"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "refresh-stack-916",
                    "layout": "stack",
                    "gap": "3",
                    "padding": "4",
                    "appearance": {
                      "background": "surface",
                      "radius": "md",
                      "borderColor": "line",
                      "borderWidth": 1
                    },
                    "children": [
