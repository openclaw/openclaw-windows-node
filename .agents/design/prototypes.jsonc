                          {
                            "id": "dashboard-assistant-chevron",
                            "text": "",
                            "margin": {
                              "right": "3"
                            },
                            "style": "caption",
                            "color": "muted"
                          }
                        ]
                      },
                      {
                        "note": "Compact New session action to the right of the assistant switcher, matching the Mac Dashboard header placement. Its tap starts a new conversation without opening the assistant menu. Native port: accessible name and tooltip New session.",
                        "id": "dashboard-new-session",
                        "component": "Button",
                        "props": {
                          "children": "",
                          "accessibleName": "New session",
                          "variant": "secondary"
                        },
                        "on": {
                          "tap": {
                            "setState": {
                              "dashboardAgents": false,
