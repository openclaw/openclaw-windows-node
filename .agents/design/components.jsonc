    {
      "name": "WorkspacePreviewSave",
      "note": "Disabled submit affordance retains the reference dialog layout without falsely implying that edited values can be saved.",
      "props": {
        "children": "Save automation",
        "variant": "primary",
        "accessibleName": ""
      },
      "root": {
        "id": "workspace-preview-save",
        "el": "button",
        "attrs": {
          "aria-label": "{accessibleName}",
          "disabled": "disabled",
          "title": "Layout-only form. Saving is not available in this click-through."
        },
        "class": "ds-btn ds-btn-{variant}",
        "layout": {
          "mode": "horizontal",
          "padding": {
            "x": "3",
            "y": "1"
          },
          "align": "center",
          "justify": "center",
          "width": "hug"
        },
        "children": [
          "{children}"
        ]
      }
    },
    {
      "name": "WorkspaceActionButton",
      "note": "Existing Button pattern with an inline Fluent Add or Edit glyph, following the colleague's automation actions.",
      "props": {
        "children": "New automation",
        "variant": "primary",
        "accessibleName": "",
        "glyph": ""
      },
      "root": {
        "id": "workspace-action-button",
        "el": "button",
