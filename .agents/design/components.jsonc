                          "align": "center",
                          "gap": "2",
                          "padding": {
                            "x": "3",
                            "y": "2"
                          },
                          "width": "fill"
                        },
                        "children": [
                          {
                            "id": "workspace-session-1-title",
                            "el": "span",
                            "layout": {
