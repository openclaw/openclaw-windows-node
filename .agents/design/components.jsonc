                              "r": "3"
                            }
                          },
                          {
                            "id": "chat-composer-settings-path",
                            "el": "path",
                            "attrs": {
                              "d": "M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "chat-composer-send",
                    "el": "button",
                    "class": "ds-btn",
                    "attrs": {
                      "type": "button",
                      "title": "Send",
                      "aria-label": "Send"
                    },
                    "layout": {
                      "mode": "horizontal",
                      "align": "center",
                      "justify": "center",
                      "width": 32,
                      "height": 32
                    },
                    "appearance": {
                      "background": "accent",
                      "color": "accentInk",
                      "radius": "sm"
                    },
                    "children": [
                      {
                        "id": "chat-composer-send-glyph",
                        "el": "svg",
                        "attrs": {
                          "width": "18",
                          "height": "18",
                          "viewBox": "0 0 24 24",
                          "fill": "none",
                          "aria-hidden": "true",
                          "stroke": "currentColor",
                          "stroke-width": "2",
                          "stroke-linecap": "round",
                          "stroke-linejoin": "round"
                        },
                        "children": [
                          {
                            "id": "chat-composer-send-path",
                            "el": "path",
                            "attrs": {
                              "d": "M12 19V5M5 12l7-7 7 7"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "ChatThread",
      "note": "A short thread: the \"does chat hang together\" check — a user turn (softer `accentSubtle` bubble on the right, with a hover Copy) and an assistant turn (avatar + Copy / Read aloud / context-usage readout), then the composer. Thread/bubble max-width 720px is a Reactor port note.",
      "root": {
        "id": "chat-thread-root",
        "el": "div",
        "layout": {
          "mode": "vertical",
          "gap": "3",
          "width": "fill"
        },
        "children": [
          {
            "id": "chat-thread-user",
            "el": "div",
            "layout": {
              "mode": "horizontal",
              "justify": "end",
              "width": "fill"
            },
            "children": [
              {
                "id": "chat-thread-user-stack",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "1",
                  "align": "end"
                },
                "children": [
                  {
                    "id": "chat-thread-user-bubble",
                    "el": "div",
                    "layout": {
                      "mode": "vertical",
                      "padding": {
                        "x": "4",
                        "y": "3"
                      }
                    },
                    "appearance": {
                      "fontFamily": "body",
                      "textStyle": "body",
                      "background": "accentSubtle",
                      "color": "accentInk",
                      "radius": "bubble"
                    },
                    "children": [
                      "Can you list the Windows node capabilities?"
                    ]
                  },
                  {
                    "id": "chat-thread-user-footer",
                    "el": "div",
                    "layout": {
                      "mode": "horizontal",
                      "gap": "2",
                      "padding": {
                        "x": "2"
                      },
                      "align": "center"
                    },
                    "appearance": {
                      "fontFamily": "body",
                      "textStyle": "caption",
                      "color": "muted"
                    },
                    "children": [
                      {
                        "id": "chat-thread-user-time",
                        "el": "span",
                        "children": [
                          "2:14 PM"
                        ]
                      },
                      {
                        "id": "chat-thread-user-copy",
                        "el": "button",
                        "class": "ds-btn",
                        "attrs": {
                          "type": "button",
                          "title": "Copy",
                          "aria-label": "Copy message"
                        },
                        "layout": {
                          "mode": "horizontal",
                          "align": "center",
                          "justify": "center",
                          "width": 20,
                          "height": 20
                        },
                        "appearance": {
                          "color": "muted",
                          "radius": "sm"
                        },
                        "children": [
                          {
                            "id": "chat-thread-user-copy-glyph",
                            "el": "svg",
                            "attrs": {
                              "width": "14",
                              "height": "14",
                              "viewBox": "0 0 24 24",
                              "fill": "none",
                              "aria-hidden": "true",
                              "stroke": "currentColor",
                              "stroke-width": "2",
                              "stroke-linecap": "round",
                              "stroke-linejoin": "round"
                            },
                            "children": [
                              {
                                "id": "chat-thread-user-copy-rect",
                                "el": "rect",
                                "attrs": {
                                  "x": "9",
                                  "y": "9",
                                  "width": "11",
                                  "height": "11",
                                  "rx": "2"
                                }
                              },
                              {
                                "id": "chat-thread-user-copy-path",
                                "el": "path",
                                "attrs": {
                                  "d": "M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "chat-thread-assistant",
            "component": "ChatBubble",
            "props": {
              "time": "2:14 PM",
              "usage": "12.5K/200K (6%)",
              "children": "Paired to the gateway — 6 capabilities are live, including system.run and clipboard access."
            }
          },
          {
            "id": "chat-thread-composer",
            "component": "ChatComposer"
          }
        ]
      }
    },
    {
      "name": "ExampleScreen",
      "note": "A representative Connection screen composed from the pieces above — the \"does it hang together\" check for the whole system. The status board is a freeform layer so the two cards can overlap into a Fluent-style dashboard, exercising v3 absolute positioning alongside Auto Layout.",
      "root": {
        "id": "example-screen-root",
        "el": "section",
        "class": "ds-screen",
        "layout": {
          "mode": "vertical",
          "gap": "5",
          "width": "fill"
        },
        "children": [
          {
            "id": "example-screen-head",
            "el": "header",
            "class": "ds-screen-head",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "start",
              "justify": "space-between",
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-heading",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "1"
                },
                "children": [
                  {
                    "id": "example-screen-eyebrow",
                    "el": "p",
                    "class": "ds-eyebrow",
                    "children": [
                      "Connection"
                    ]
                  },
                  {
                    "id": "example-screen-title",
                    "el": "h2",
                    "class": "ds-screen-title",
                    "children": [
                      "OpenClaw Windows Hub"
                    ]
                  }
                ]
              },
              {
                "id": "example-screen-status",
                "component": "Badge",
                "props": {
                  "tone": "positive",
                  "children": "Connected"
                }
              }
            ]
          },
          {
            "id": "example-screen-board",
            "el": "div",
            "class": "ds-grid",
            "layout": {
              "mode": "horizontal",
              "width": "fill",
              "height": 176,
              "gap": "3"
            },
            "children": [
              {
                "id": "example-screen-gateway",
                "component": "Card",
                "props": {
                  "title": "Gateway",
                  "body": "Paired to OpenClawGateway · last seen just now."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              },
              {
                "id": "example-screen-node",
                "component": "Card",
                "props": {
                  "title": "Windows node",
                  "body": "6 capabilities exposed over MCP."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              }
            ]
          },
          {
            "id": "example-screen-row",
            "el": "div",
            "class": "ds-row",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "end",
              "wrap": true,
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-field",
                "component": "Field",
                "props": {
                  "label": "Gateway address",
                  "placeholder": "127.0.0.1:18789"
                },
                "layout": {
                  "grow": true
                }
              },
              {
                "id": "example-screen-connect",
                "component": "Button",
                "props": {
                  "children": "Connect",
                  "variant": "primary"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
