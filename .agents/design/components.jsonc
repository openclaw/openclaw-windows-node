                              "stroke": "currentColor",
                              "stroke-width": "2",
                              "stroke-linecap": "round",
                              "stroke-linejoin": "round"
                            },
                            "children": [
                              {
                                "id": "chat-thread-user-copy-rect",
                                "el": "rect",
                                "attrs": {
