    {
      "name": "NativeCaptureUnavailable",
      "note": "Explicit evidence gap. Do not restyle light/dark screenshots and claim native high-contrast proof.",
      "root": {
        "id": "native-capture-unavailable",
        "el": "p",
        "class": "native-hc-note",
        "children": [
          "Native high-contrast capture is not available. Choose Light or Dark in the prototype toolbar to review actual WinUI pixels. This is not a high-contrast rendering of the page."
        ]
      }
    },
    {
      "name": "WorkspaceReferenceStyles",
      "note": "Layout from the user-provided OpenClaw Windows Prototype. Remaps its independent palette and differently numbered spacing scale to this repository's tokens. No reference stylesheet, scripts, or runtime services are shipped.",
      "root": {
        "id": "workspace-reference-styles",
        "el": "style",
        "children": [
          "[data-proto-node-id^='colleague-'] {{ min-width:0; }}",
          "[data-proto-node-id='colleague-agents-grid'] {{ grid-template-columns:repeat(auto-fit,minmax(min(100%,calc(var(--space-8)*3 + var(--space-5))),1fr)) !important; }}",
          "[data-proto-node-id='refresh-page-agents'],[data-proto-node-id='refresh-page-dashboards'],[data-proto-node-id='refresh-page-dashboard-detail'],[data-proto-node-id='refresh-page-systems'],[data-proto-node-id='refresh-page-automations'],[data-proto-node-id='refresh-page-plugins'] {{ max-width:calc(var(--space-8)*15 + var(--space-6) + var(--space-2)); container-type:inline-size; }}",
          ".workspace-ref-glyph {{ display:flex;align-items:center;justify-content:center;width:calc(var(--space-6) + var(--space-2));height:calc(var(--space-6) + var(--space-2));flex-shrink:0;font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:var(--space-5);color:var(--color-accent); }}",
          ".workspace-ref-title {{ font-family:var(--font-body);font-size:var(--text-body-size);line-height:var(--text-body-line-height);font-weight:600;color:var(--color-ink); }}",
          ".workspace-ref-status {{ display:inline-flex;align-items:center;gap:var(--space-2);font-family:var(--font-body);font-size:var(--text-caption-size);color:var(--color-ink); }}",
          ".workspace-ref-dot {{ width:var(--space-2);height:var(--space-2);border-radius:var(--radius-pill);background:var(--color-positive); }}",
          ".workspace-ref-status[data-tone='muted'] .workspace-ref-dot {{ background:var(--color-muted); }}",
          ".workspace-ref-progress {{ display:block;width:100%;height:var(--space-1);border:0;border-radius:var(--radius-sm);overflow:hidden;background:var(--color-line);accent-color:var(--color-accent); }}",
          ".workspace-ref-progress::-webkit-progress-bar {{ background:var(--color-line); }}",
          ".workspace-ref-progress::-webkit-progress-value {{ background:var(--color-accent);border-radius:var(--radius-sm); }}",
          ".workspace-ref-preview-lines {{ height:var(--space-6);background:repeating-linear-gradient(180deg,var(--color-line) 0 calc(var(--space-1)/2),transparent calc(var(--space-1)/2) var(--space-3)); }}",
          ".workspace-ref-desktop {{ height:calc(var(--space-8)*2 + var(--space-6));position:relative;border:calc(var(--space-1)/4) solid var(--color-line);border-radius:var(--radius-md);background:var(--color-paper);overflow:hidden; }}",
          ".workspace-ref-desktop::before {{ content:'';position:absolute;inset:15% 30% 30%;border:calc(var(--space-1)/2) solid var(--color-accent);border-radius:50% 20% 50% 20%;transform:rotate(-25deg); }}",
          ".workspace-ref-desktop::after {{ content:'';position:absolute;bottom:0;left:0;right:0;height:var(--space-4);background:var(--color-line); }}",
          ".workspace-ref-desktop span {{ position:absolute;bottom:var(--space-5);left:var(--space-3);right:var(--space-3);font-size:var(--text-caption-size);color:var(--color-ink); }}",
          "[data-proto-node-id^='colleague-job-row'],[data-proto-node-id='colleague-jobs-header'] {{ grid-template-columns:minmax(0,2fr) minmax(0,1.2fr) var(--space-7) calc(var(--space-8) + var(--space-6)) !important;min-width:calc(var(--space-8)*6 + var(--space-7)); }}",
          "[data-proto-node-id='colleague-jobs-table'] {{ overflow-x:auto; }}",
          ".workspace-ref-field {{ display:flex;flex-direction:column;gap:var(--space-2);color:var(--color-ink);font:inherit; }}",
          ".workspace-ref-field input,.workspace-ref-field select,.workspace-ref-field textarea {{ width:100%;padding:var(--space-2) var(--space-3);border:calc(var(--space-1)/4) solid var(--color-controlLine);border-bottom-color:var(--color-muted);border-radius:var(--radius-sm);background:var(--color-control);color:var(--color-ink);font:inherit; }}",
          ".workspace-ref-field :focus-visible {{ outline:calc(var(--space-1)/2) solid var(--color-accent);outline-offset:calc(var(--space-1)/2); }}",
          "[data-proto-node-id^='colleague-'].ds-btn-subtle {{ background:transparent;border-color:transparent;color:var(--color-accent);box-shadow:none; }}",
          "[data-proto-node-id='colleague-jobs-table'] {{ flex-shrink:0; }}",
          "[data-proto-node-id^='colleague-job-edit-'].ds-btn {{ width:var(--space-6);height:var(--space-6);padding:var(--space-1);flex-shrink:0; }}",
          "[data-proto-node-id^='colleague-'][data-proto-node-id$='-grid']:not([data-proto-node-id='colleague-agents-grid']) {{ grid-template-columns:repeat(auto-fit,minmax(min(100%,max(calc((100% - var(--space-4))/2),calc(var(--space-8)*3 + var(--space-5)))),1fr)) !important; }}"
        ]
      }
    },
    {
      "name": "WorkspaceCardTitle",
      "note": "Semibold body hierarchy using the repository type scale.",
      "props": {
        "label": "Title"
      },
      "root": {
        "id": "workspace-card-title",
        "el": "strong",
        "class": "workspace-ref-title",
        "children": [
          "{label}"
        ]
      }
    },
    {
      "name": "WorkspaceReferenceGlyph",
      "note": "Reference page glyphs rendered through Segoe Fluent Icons.",
      "props": {
        "glyph": ""
      },
      "root": {
        "id": "workspace-reference-glyph",
        "el": "span",
        "class": "workspace-ref-glyph",
        "attrs": {
          "aria-hidden": "true"
        },
        "children": [
          "{glyph}"
        ]
      }
    },
    {
      "name": "WorkspaceReferenceStatus",
      "note": "Text plus a status dot, never color alone.",
      "props": {
        "label": "Available",
        "tone": "positive"
      },
      "root": {
        "id": "workspace-reference-status",
        "el": "span",
        "class": "workspace-ref-status",
