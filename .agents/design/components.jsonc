          "background": "control",
          "borderColor": "controlLine",
          "radius": "composer"
        },
        "children": [
          {
            "id": "chat-composer-input",
            "el": "div",
            "attrs": {
              "contenteditable": "true",
              "role": "textbox",
              "aria-multiline": "true",
              "aria-label": "Message input"
            },
            "layout": {
              "padding": "2",
              "width": "fill",
              "height": 56
            },
            "appearance": {
              "fontFamily": "body",
              "textStyle": "body",
              "color": "muted"
            },
            "control": {
              "chrome": "none",
              "focus": { "kind": "underline", "color": "accent" }
            },
            "children": [
              "{placeholder}"
            ]
          },
          {
            "id": "chat-composer-toolbar",
