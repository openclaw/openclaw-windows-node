                      "radius": "pill"
                    },
                    "control": { "chrome": "none", "focus": { "kind": "outline", "color": "accent" } },
                    "states": {
                      "hover": { "background": "chatActionHover" },
                      "pressed": { "background": "chatActionPressed", "color": "chatActionPressedText" },
                      "hoverPressed": { "background": "chatActionPressed", "color": "chatActionPressedText" },
                      "disabled": { "background": "chatActionDisabled", "color": "chatActionDisabledText" }
                    },
                    "children": [
                      {
                        "id": "chat-composer-send-glyph",
                        "el": "span",
                        "attrs": { "aria-hidden": "true" },
                        "appearance": { "textStyle": "chatIcon" },
                        "children": [ "\uE74A" ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "ChatThread",
      "note": "Fixture-shaped composition of the shared ChatUserBubble, bubbleless ChatBubble and Workspace ChatComposer. The 848px reference frame includes two 40px host gutters around the 768px reading column; transcript prose has a further 16px inset. It paints the native content layer once, with transparent chat content and translucent card/user surfaces above it. Actual Mica depends on the desktop, activation and transparency settings, so the browser's neutral backplate is not an exact wallpaper-dependent Mica reproduction. Native timeline virtualization, anchored composer placement and responsive gutters remain host behavior.",
      "root": {
        "id": "chat-thread-root",
        "el": "div",
        "layout": {
          "mode": "vertical",
          "gap": "3",
          "width": 848,
          "padding": { "x": "chatGutter", "y": "4" }
        },
        "appearance": { "background": "chatLayer" },
        "children": [
          {
            "id": "chat-thread-user",
            "el": "div",
            "layout": {
              "mode": "horizontal",
              "justify": "end",
              "width": "fill",
              "padding": { "x": "4" }
            },
            "children": [
              {
                "id": "chat-thread-user-bubble",
                "component": "ChatUserBubble"
              }
            ]
          },
          {
            "id": "chat-thread-assistant",
            "component": "ChatBubble",
            "margin": { "x": "4", "y": "3" },
            "props": {
              "time": "11:01 PM",
              "usage": "200/128.0K (0%)"
            }
          },
          {
            "id": "chat-thread-composer",
            "component": "ChatComposer"
          }
        ]
      }
    },
    {
      "name": "ChatCopyButton",
      "note": "Shared native ChatCopyButton for user turns, assistant turns and code. 32x32 target, 4px padding, 4px corners, no border, and the 14px Segoe Fluent Copy glyph U+E8C8. Rest foreground is ChatSecondaryTextBrush. Native clipboard confirmation changes to Check U+E73E, announces Copied and resets after two seconds; clipboard behavior is not implemented by the preview. Hover, press, disabled and focus visuals are represented.",
      "root": {
        "id": "chat-copy-root",
        "el": "button",
        "attrs": {
          "type": "button",
          "title": "Copy",
          "aria-label": "Copy"
        },
        "layout": {
          "mode": "horizontal",
          "align": "center",
          "justify": "center",
          "padding": "1",
          "width": 32,
