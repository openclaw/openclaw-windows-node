                            "children": [
                              "Draft the release notes"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "workspace-footer-spacer",
                    "el": "div",
                    "layout": {
                      "mode": "vertical",
                      "grow": true
                    }
                  },
                  {
                    "id": "workspace-footer",
                    "el": "div",
                    "layout": {
                      "mode": "horizontal",
                      "gap": "1",
                      "align": "center",
                      "width": "fill"
                    },
                    "children": [
                      {
                        "id": "workspace-owner",
                        "component": "UserIdentityBadge",
                        "props": {
                          "name": "{owner}",
                          "status": "{status}"
                        },
                        "layout": {
                          "grow": true
                        }
                      },
                      {
                        "id": "workspace-bell",
                        "el": "div",
                        "attrs": {
                          "role": "button",
                          "aria-label": "Notifications"
                        },
                        "layout": {
                          "mode": "horizontal",
                          "align": "center",
                          "justify": "center",
                          "width": 40,
                          "height": 40
                        },
                        "appearance": {
                          "color": "muted",
                          "radius": "sm"
                        },
                        "children": [
                          {
                            "id": "workspace-bell-glyph",
                            "el": "svg",
                            "attrs": {
                              "width": "18",
                              "height": "18",
                              "viewBox": "0 0 24 24",
                              "fill": "none",
                              "stroke": "currentColor",
                              "stroke-width": "2",
                              "stroke-linecap": "round",
                              "stroke-linejoin": "round",
                              "aria-hidden": "true"
                            },
                            "children": [
                              {
                                "id": "workspace-bell-body",
                                "el": "path",
                                "attrs": {
                                  "d": "M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"
                                }
                              },
                              {
                                "id": "workspace-bell-clapper",
                                "el": "path",
                                "attrs": {
                                  "d": "M13.7 21a2 2 0 0 1-3.4 0"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "workspace-content",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "grow": true,
                  "padding": "5",
                  "width": "fill"
                },
                "children": [
                  {
                    "id": "workspace-content-thread",
                    "component": "ChatThread"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "ExampleScreen",
      "note": "A representative Connection screen composed from the pieces above — the \"does it hang together\" check for the whole system. The status board is a freeform layer so the two cards can overlap into a Fluent-style dashboard, exercising v3 absolute positioning alongside Auto Layout.",
      "root": {
        "id": "example-screen-root",
        "el": "section",
        "class": "ds-screen",
        "layout": {
          "mode": "vertical",
          "gap": "5",
          "width": "fill"
        },
        "children": [
          {
            "id": "example-screen-head",
            "el": "header",
            "class": "ds-screen-head",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "start",
              "justify": "space-between",
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-heading",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "1"
                },
                "children": [
                  {
                    "id": "example-screen-eyebrow",
                    "el": "p",
                    "class": "ds-eyebrow",
                    "children": [
                      "Connection"
                    ]
                  },
                  {
                    "id": "example-screen-title",
                    "el": "h2",
                    "class": "ds-screen-title",
                    "children": [
                      "OpenClaw Windows Hub"
                    ]
                  }
                ]
              },
              {
                "id": "example-screen-status",
                "component": "Badge",
                "props": {
                  "tone": "positive",
                  "children": "Connected"
                }
              }
            ]
          },
          {
            "id": "example-screen-board",
            "el": "div",
            "class": "ds-grid",
            "layout": {
              "mode": "horizontal",
              "width": "fill",
              "height": 176,
              "gap": "3"
            },
            "children": [
              {
                "id": "example-screen-gateway",
                "component": "Card",
                "props": {
                  "title": "Gateway",
                  "body": "Paired to OpenClawGateway · last seen just now."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              },
              {
                "id": "example-screen-node",
                "component": "Card",
                "props": {
                  "title": "Windows node",
                  "body": "6 capabilities exposed over MCP."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              }
            ]
          },
          {
            "id": "example-screen-row",
            "el": "div",
            "class": "ds-row",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "end",
              "wrap": true,
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-field",
                "component": "Field",
                "props": {
                  "label": "Gateway address",
                  "placeholder": "127.0.0.1:18789"
                },
                "layout": {
                  "grow": true
                }
              },
              {
                "id": "example-screen-connect",
                "component": "Button",
                "props": {
                  "children": "Connect",
                  "variant": "primary"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
