        "children": [
          {
            "id": "workspace-reference-dot",
            "el": "span",
            "class": "workspace-ref-dot",
            "attrs": {
              "aria-hidden": "true"
            }
          },
          "{label}"
        ]
      }
    },
    {
      "name": "WorkspaceReferenceProgress",
      "note": "Illustrative utilization values from the colleague's fixtures.",
