        "attrs": {
          "type": "button",
          "aria-label": "Dismiss account menu"
        }
      }
    },
    {
      "name": "PaneToggleButton",
      "note": "Titlebar pane control using HubWindow.xaml NavPaneToggleButton's Segoe Fluent Icons U+E90C, always visible without a brand logo. Transparent rest, subtle hover/press, and a keyboard-focus rectangle. Uses spacing 6 for its 32px hit target and spacing 4 for its 16px glyph.",
      "root": {
        "id": "pane-toggle-button",
        "el": "button",
        "attrs": {
          "type": "button",
          "aria-label": "Toggle navigation pane",
          "title": "Toggle navigation pane",
          "style": "width:var(--space-6);height:var(--space-6);padding:0"
        },
        "layout": {
          "mode": "horizontal",
          "align": "center",
          "justify": "center"
        },
        "appearance": {
          "background": "$none",
          "color": "ink",
          "radius": "sm"
        },
        "control": {
          "chrome": "none",
          "focus": {
            "kind": "outline",
            "color": "accent"
          }
        },
        "states": {
          "hover": {
            "background": "subtleHover"
          },
          "pressed": {
            "background": "subtlePressed"
          },
          "hoverPressed": {
            "background": "subtlePressed"
          }
        },
        "children": [
          {
            "id": "pane-toggle-glyph",
            "el": "span",
            "attrs": {
              "aria-hidden": "true",
              "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:var(--space-4);line-height:1"
            },
            "children": [
              ""
            ]
          }
        ]
      }
    },
    {
      "name": "Button",
      "note": "Primary action. One per view — it's where the eye should land. Padding mirrors WinUI's default ButtonPadding (11,5,11,6), snapped to spacing tokens 3 (12≈11) and 1 (4≈5/6). In-app MinWidth 100px keeps short labels (OK / Connect) from cramping and gives side-by-side buttons a consistent footprint; that minimum has no spacing-token equivalent, so it stays a port note and the preview hugs its label.",
      "props": {
        "children": "Save changes",
        "variant": "primary",
        "accessibleName": ""
      },
      "root": {
        "id": "button-root",
        "el": "button",
        "attrs": {
          "aria-label": "{accessibleName}"
        },
        "class": "ds-btn ds-btn-{variant}",
        "layout": {
          "mode": "horizontal",
          "padding": {
            "x": "3",
            "y": "1"
          },
          "align": "center",
          "justify": "center",
          "width": "hug"
        },
        "children": [
          "{children}"
        ]
      }
    },
    {
      "name": "Field",
      "note": "Text input with a quiet label above it — the field is the subject. Input padding mirrors WinUI TextControlThemePadding (10,5,6,6), snapped to tokens 2 (8≈10/6 horizontal) and 1 (4≈5/6 vertical). In-app MinHeight 32px lines a field up with a Button on the same row; that minimum stays a port note.",
      "props": {
        "label": "Gateway address",
        "placeholder": "127.0.0.1:18789"
      },
      "root": {
