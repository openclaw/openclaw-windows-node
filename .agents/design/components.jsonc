                      },
                      {
                        "id": "workspace-sessions-header",
                        "el": "div",
                        "layout": {
                          "mode": "horizontal",
                          "gap": "2",
                          "align": "center",
                          "justify": "space-between",
                          "padding": {
                            "x": "3"
