                                "id": "workspace-placeholder-icon",
                                "el": "span",
                                "layout": {
                                  "mode": "horizontal",
                                  "align": "center"
                                },
                                "appearance": {
                                  "textStyle": "workspacePlaceholder",
                                  "color": "nativeText"
                                },
                                "children": [
                                  ""
                                ]
                              },
                              {
                                "id": "workspace-placeholder-title",
                                "el": "span",
                                "layout": {
                                  "mode": "horizontal",
                                  "align": "center"
                                },
                                "appearance": {
                                  "textStyle": "subtitle",
                                  "color": "nativeText"
                                },
                                "children": [
                                  "Connect to gateway to start chatting"
                                ]
                              },
                              {
                                "id": "workspace-open-connection",
                                "el": "button",
                                "layout": {
                                  "mode": "horizontal",
                                  "align": "center",
                                  "justify": "center",
                                  "height": 32,
                                  "padding": {
                                    "left": "buttonHorizontal",
                                    "top": "buttonTop",
                                    "right": "buttonHorizontal",
                                    "bottom": "buttonBottom"
                                  }
                                },
                                "attrs": {
                                  "type": "button"
                                },
                                "appearance": {
                                  "textStyle": "body",
                                  "color": "nativeText",
                                  "background": "control",
                                  "borderColor": "controlLine",
                                  "borderWidth": 1,
                                  "radius": "sm"
                                },
                                "control": {
                                  "chrome": "none",
                                  "focus": {
                                    "kind": "outline",
                                    "color": "accent"
                                  }
                                },
                                "states": {
                                  "hover": {
                                    "background": "controlHover"
                                  },
                                  "pressed": {
                                    "background": "controlDisabled"
                                  },
                                  "disabled": {
                                    "background": "controlDisabled",
                                    "color": "disabledText"
                                  }
                                },
                                "children": [
                                  "Open Connection"
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },

    {
      "name": "SetupProgressIndicator",
      "note": "Setup control. The wizard step dots (SetupProgressIndicator.cs). Non-interactive, non-focusable, accessibility-hidden, so no hover/pressed states. The active step is a 20x8 pill in `accent` (SetupIndicatorAccentBrush = SystemAccentColorLight2 dark / Dark1 light); inactive steps are 8x8 dots in `muted` (SetupInactiveDotBrush = ControlStrongFill). Dot spacing is token `2` (8px); every dot uses the `sm` radius (4px).",
      "root": {
        "id": "setup-progress-root",
        "el": "div",
        "attrs": { "role": "img", "aria-label": "Step 2 of 4" },
        "layout": { "mode": "horizontal", "gap": "2", "align": "center" },
        "children": [
          { "id": "setup-progress-d1", "el": "span", "layout": { "width": 8, "height": 8 }, "appearance": { "background": "muted", "radius": "sm" } },
          { "id": "setup-progress-d2", "el": "span", "layout": { "width": 20, "height": 8 }, "appearance": { "background": "accent", "radius": "sm" } },
          { "id": "setup-progress-d3", "el": "span", "layout": { "width": 8, "height": 8 }, "appearance": { "background": "muted", "radius": "sm" } },
          { "id": "setup-progress-d4", "el": "span", "layout": { "width": 8, "height": 8 }, "appearance": { "background": "muted", "radius": "sm" } }
        ]
      }
    },
    {
      "name": "ProviderArtwork",
      "note": "Non-interactive provider tile from Controls/ProviderArtwork.xaml. Native size is 42x42: a 24x24 content grid, 8px padding and a 1px border on each side. The Border explicitly requests Dark, binding SolidBackgroundFillColorBaseBrush and CardStrokeColorDefaultBrush even on light pages. The scalable SVG preserves those bounds and 4px outer corners when SetupOptionCard displays it through the native 32x32 Viewbox. The 24px Fluent fallback glyph is representative, not provider branding; image loading stays native.",
      "root": {
        "id": "provider-artwork-root",
        "el": "svg",
        "attrs": { "viewBox": "0 0 42 42", "aria-hidden": "true", "focusable": "false" },
        "layout": {
          "width": 42,
          "height": 42
        },
        "children": [
          {
            "id": "provider-artwork-backplate",
            "el": "rect",
            "attrs": {
              "x": 0.5, "y": 0.5, "width": 41, "height": 41, "rx": 3.5,
              "fill": "var(--color-providerArtworkFill)",
              "stroke": "var(--color-providerArtworkStroke)",
              "stroke-width": 1
            }
          },
          {
            "id": "provider-artwork-glyph",
            "el": "text",
            "attrs": { "x": 21, "y": 21, "text-anchor": "middle", "dominant-baseline": "central", "fill": "currentColor" },
            "appearance": { "textStyle": "providerSymbol", "color": "providerArtworkText" },
            "children": [ "\uE99A" ]
          }
        ]
      }
    },
    {
      "name": "SetupOptionCard",
      "note": "One-row provider group derived from AiSetupPage.xaml at 0131e4ce1f7937b22c69b289564087061687fa14. The outer Border owns CardBackgroundFillColorDefaultBrush, a 1px CardStrokeColorDefaultBrush stroke and 8px corners. Inherited SettingsCardPadding is 16 on all sides. A 32px ProviderArtwork Viewbox precedes the Body Strong/Caption stack by 12px; stack spacing is 4px. Body action text precedes a 13px chevron with 14px margin. By design, the catalog interaction matches CapabilityOptionRow: subtleHover/subtlePressed fill, sm corners and the shared renderer transition. The outer border and bottom divider remain setupCardStroke in every state. Pointer exit restores transparency without layout changes or tinting child text/artwork. This intentionally differs from the stock CompactChoice square corners, SettingsCard state brushes and 83ms transition; native min/max sizes and adaptive reflow remain port notes. This row is an action, not a selected ListViewItem.",
      "props": {
        "title": "Sign in with GitHub",
        "detail": "Use your Copilot subscription. No API key needed.",
        "action": "Sign in"
      },
      "root": {
        "id": "setup-option-root",
        "el": "div",
        "layout": { "mode": "vertical", "width": "fill" },
        "appearance": {
          "background": "setupCardFill",
          "borderColor": "setupCardStroke",
          "borderWidth": 1,
          "radius": "md"
        },
        "children": [
          {
            "id": "setup-option-action",
            "el": "button",
            "attrs": { "type": "button", "aria-label": "{title}" },
            "layout": {
              "mode": "horizontal",
              "padding": "4",
              "align": "center",
              "width": "fill"
            },
            "appearance": {
              "background": "$none",
              "borderWidth": 0,
              "radius": "sm",
              "textAlign": "left"
            },
            "control": {
              "chrome": "none",
              "focus": { "kind": "outline", "color": "accent" }
            },
            "states": {
              "hover": { "background": "subtleHover" },
              "pressed": { "background": "subtlePressed" },
              "hoverPressed": { "background": "subtlePressed" },
              "disabled": { "color": "disabledText", "background": "setupOptionDisabled" }
            },
            "children": [
              {
                "id": "setup-option-art-slot",
                "el": "span",
                "layout": { "mode": "horizontal", "width": 32, "height": 32 },
                "margin": { "right": "3" },
                "children": [
                  { "id": "setup-option-art", "component": "ProviderArtwork", "layout": { "width": 32, "height": 32 } }
                ]
              },
              {
                "id": "setup-option-text",
                "el": "div",
                "layout": { "mode": "vertical", "gap": "1", "grow": true },
                "children": [
                  { "id": "setup-option-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "bodyStrong", "color": "nativeText" }, "children": [ "{title}" ] },
                  { "id": "setup-option-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
                ]
              },
              {
                "id": "setup-option-action-label",
                "el": "span",
                "layout": { "mode": "horizontal", "width": "hug" },
                "margin": { "left": "3" },
                "appearance": { "textStyle": "body", "color": "nativeText" },
                "children": [ "{action}" ]
              },
              {
                "id": "setup-option-chevron",
                "el": "span",
                "attrs": { "aria-hidden": "true" },
                "margin": { "left": "infoIconGap" },
                "appearance": { "textStyle": "setupActionIcon", "color": "nativeText" },
                "children": [ "\uE76C" ]
              }
            ]
          },
          {
            "id": "setup-option-divider",
            "el": "div",
            "attrs": { "aria-hidden": "true" },
            "layout": { "height": 1, "width": "fill" },
            "appearance": { "background": "setupCardStroke" }
          }
        ]
      }
    },
    {
      "name": "CapabilityOptionRow",
      "note": "CapabilitiesPage.xaml Balanced profile in a one-row group. The group owns the alpha-preserving CardBackgroundFillColorDefaultBrush backplate, 1px CardStrokeColorDefaultBrush border and 8px corners. Its transparent row has exact 16,12 padding. Body Strong title and the shared BadgeAccent sit together on the first line, 8px apart and vertically centered; Caption detail follows 4px below. Nested instances clear the standalone backplate so their enclosing group paints it once. Subtle hover/pressed are preview approximations; native ListView selection, focus and high-contrast template states remain native behavior.",
      "props": {
        "title": "Balanced",
        "detail": "Commands, Canvas, screen capture and voice."
      },
      "root": {
        "id": "capability-row-root",
        "el": "div",
        "layout": { "mode": "vertical", "width": "fill" },
        "appearance": { "background": "setupCardFill", "borderColor": "setupCardStroke", "borderWidth": 1, "radius": "md" },
        "children": [
          {
            "id": "capability-row-action",
            "el": "button",
            "attrs": { "type": "button", "aria-label": "{title}: {detail}" },
            "layout": {
              "mode": "vertical",
              "gap": "1",
              "padding": { "x": "4", "y": "3" },
              "align": "start",
              "width": "fill"
            },
            "appearance": {
              "background": "$none",
              "borderWidth": 0,
              "radius": "sm",
              "textAlign": "left"
            },
            "control": {
              "chrome": "none",
              "focus": { "kind": "outline", "color": "accent" }
            },
            "states": {
              "hover": { "background": "subtleHover" },
              "pressed": { "background": "subtlePressed" },
              "hoverPressed": { "background": "subtlePressed" }
            },
            "children": [
              {
                "id": "capability-row-heading",
                "el": "div",
                "layout": { "mode": "horizontal", "gap": "2", "align": "center", "width": "hug" },
                "children": [
                  { "id": "capability-row-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "bodyStrong", "color": "nativeText" }, "children": [ "{title}" ] },
                  { "id": "capability-row-badge", "component": "BadgeAccent" }
                ]
              },
              { "id": "capability-row-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
            ]
          }
        ]
      }
    },
    {
      "name": "SetupPhaseStatus",
      "note": "Setup control. The inline phase result row (Controls/SetupPhaseStatus.xaml). Non-interactive. A horizontal row, token `2` (8px) gap, pairing a status indicator with `caption` text (max width 160px) in `muted`. Running shows a 20x20 ProgressRing; Complete shows the Segoe Fluent StatusOk check (U+E73E) in `positive` (SystemFillColorSuccess); Failed shows StatusErr (U+EA39) in `critical` (SystemFillColorCritical); Cancelled shows Exit (U+E711) in `muted`. Previewed in the Complete state.",
      "props": {
        "children": "Gateway connected"
      },
      "root": {
        "id": "setup-phase-root",
        "el": "div",
        "attrs": { "role": "status" },
        "layout": { "mode": "horizontal", "gap": "2", "align": "center" },
        "children": [
          {
            "id": "setup-phase-glyph",
            "el": "span",
            "attrs": {
              "aria-hidden": "true",
              "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:16px"
            },
            "appearance": { "color": "positive" },
            "children": [ "\uE73E" ]
          },
          {
            "id": "setup-phase-text",
            "el": "span",
            "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" },
            "children": [ "{children}" ]
          }
        ]
      }
    },
    {
      "name": "SetupWizardShell",
      "note": "Illustrative onboarding frame composed from shared controls, not an executable wizard. The capability group follows CapabilitiesPage.xaml: one setupCardFill backplate with a 1px setupCardStroke border and md corners behind transparent rows. The grouped preview has one straight, full-width 1px setupCardStroke separator between options, with no spacing or rounded ends. Balanced reuses CapabilityOptionRow with its standalone group paint cleared; Open has no recommended badge. Native 40,4,40,24 page padding is represented by chatGutter/1/5. The footer retains shared Button and SetupProgressIndicator instances; navigation, native minimum sizes and mascot behavior remain outside this preview.",
      "root": {
        "id": "setup-wizard-root",
        "el": "section",
        "layout": {
          "mode": "vertical",
          "gap": "5",
          "padding": { "left": "chatGutter", "right": "chatGutter", "top": "1", "bottom": "5" },
          "width": "fill"
        },
        "appearance": { "background": "paper" },
        "children": [
          {
            "id": "setup-wizard-header",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "1", "align": "center" },
            "children": [
              { "id": "setup-wizard-title", "el": "h1", "appearance": { "fontFamily": "display", "textStyle": "title", "color": "ink", "textAlign": "center" }, "children": [ "Set up your Windows node" ] },
              { "id": "setup-wizard-status", "el": "p", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted", "textAlign": "center" }, "children": [ "Step 2 of 4 · Choose capabilities" ] }
            ]
          },
          {
            "id": "setup-wizard-card",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "2", "width": "fill" },
            "children": [
              { "id": "setup-wizard-card-title", "el": "h2", "appearance": { "fontFamily": "display", "textStyle": "subtitle", "color": "ink" }, "children": [ "Choose what this node can do" ] },
              {
                "id": "setup-wizard-option-group",
                "el": "div",
                "layout": { "mode": "vertical", "width": "fill" },
                "appearance": { "background": "setupCardFill", "borderColor": "setupCardStroke", "borderWidth": 1, "radius": "md" },
                "children": [
                  {
                    "id": "setup-wizard-opt-1",
                    "component": "CapabilityOptionRow",
                    "appearance": { "background": "$none", "borderColor": "$none", "borderWidth": 0, "radius": "$none" }
                  },
                  {
                    "id": "setup-wizard-option-divider",
                    "el": "div",
                    "attrs": { "aria-hidden": "true" },
                    "layout": { "width": "fill", "height": 1 },
                    "appearance": { "background": "setupCardStroke", "radius": "$none" }
                  },
                  {
                    "id": "setup-wizard-opt-2",
                    "el": "button",
                    "attrs": { "type": "button" },
                    "layout": { "mode": "vertical", "gap": "1", "padding": { "x": "4", "y": "3" }, "width": "fill", "align": "start" },
                    "appearance": { "background": "$none", "borderWidth": 0, "radius": "sm", "textAlign": "left" },
                    "control": { "chrome": "none", "focus": { "kind": "outline", "color": "accent" } },
                    "states": {
                      "hover": { "background": "subtleHover" },
                      "pressed": { "background": "subtlePressed" },
                      "hoverPressed": { "background": "subtlePressed" }
                    },
                    "children": [
                      { "id": "setup-wizard-open-title", "el": "span", "appearance": { "textStyle": "bodyStrong", "color": "nativeText" }, "children": [ "Open" ] },
                      { "id": "setup-wizard-open-detail", "el": "span", "appearance": { "textStyle": "caption", "color": "muted" }, "children": [ "All eight capabilities, including Camera, Location and Browser control." ] }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "setup-wizard-footer",
            "el": "div",
            "layout": { "mode": "horizontal", "gap": "2", "align": "center", "justify": "space-between", "width": "fill" },
            "children": [
              { "id": "setup-wizard-back", "component": "ButtonStandard", "props": { "children": "Back" }, "layout": { "width": 100 } },
              { "id": "setup-wizard-progress", "component": "SetupProgressIndicator" },
              { "id": "setup-wizard-next", "component": "Button", "props": { "children": "Continue" }, "layout": { "width": 100 } }
            ]
          }
        ]
      }
    },
    {
      "name": "SettingsSectionHeader",
      "note": "Settings control. The group label above a stack of settings cards (used across SettingsPage / PermissionsPage / SandboxPage), including General in SettingsWindowShell. Non-interactive. `bodyStrong` BodyStrongTextBlockStyle in `ink` gives the heading semibold weight without changing its 14px size or 20px line height, with margin 4,18,4,4 (previewed as token `1` sides, `4` top, `1` bottom; the 18px top is off-grid and a port note).",
      "props": { "children": "Permissions" },
      "root": {
        "id": "settings-section-header-root",
        "el": "h2",
        "margin": { "top": "4", "right": "1", "bottom": "1", "left": "1" },
        "appearance": { "fontFamily": "body", "textStyle": "bodyStrong", "color": "ink" },
        "children": [ "{children}" ]
      }
    },
    {
      "name": "SettingsCard",
      "note": "Settings composite derived from SettingsPage.xaml's hand-rolled Border, with iconless Windows Settings alignment. The outer frame paints CardBackgroundFillColorDefaultBrush once, with a 1px CardStrokeColorDefaultBrush border and md (8px) corners. The passive row has 16px padding, no leading icon or reserved gutter, and a growing left-aligned Body/Caption column with no title/detail gap and a 24px trailing margin. Only the normal Change button has hover/pressed states or a keyboard stop. The row and backplate stay unchanged under the pointer. The two-line sample is content-sized at 68px inside its 1px frame, not a fixed height.",
      "props": {
        "title": "Startup",
        "detail": "Launch OpenClaw when you sign in to Windows."
      },
      "root": {
        "id": "settings-card-root",
        "el": "div",
        "layout": { "mode": "vertical", "width": "fill" },
        "appearance": { "background": "setupCardFill", "borderColor": "setupCardStroke", "borderWidth": 1, "radius": "md" },
        "children": [
          {
            "id": "settings-card-row",
            "el": "div",
            "layout": { "mode": "horizontal", "gap": "0", "padding": "4", "align": "center", "width": "fill" },
            "appearance": { "background": "$none", "textAlign": "left" },
            "children": [
              {
                "id": "settings-card-text",
                "el": "div",
                "layout": { "mode": "vertical", "gap": "0", "grow": true },
                "margin": { "right": "5" },
                "children": [
                  { "id": "settings-card-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
                  { "id": "settings-card-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
                ]
              },
              { "id": "settings-card-action", "component": "ButtonStandard", "props": { "children": "Change" } }
            ]
          }
        ]
      }
    },
    {
      "name": "SettingsToggleRow",
      "note": "Settings composite with the same single setupCardFill backplate, 1px setupCardStroke border and md corners as SettingsCard. The passive row has 16px padding and no icon gutter. Its left-aligned Body/Caption column has no title/detail gap and a 24px trailing margin. Only the shared ToggleSwitch has hover/pressed states, changes checked state, or participates in keyboard navigation. Its native 40x20 track is centered in a 36px-high compact control slot. The two-line sample is 68px inside its frame. SettingsExpanderRow reuses ToggleSwitch directly in its own item layout, not this padded standalone card. Shipping behavior is unchanged.",
      "props": {
        "title": "Run at startup",
        "detail": "Start the OpenClaw tray automatically."
      },
      "root": {
        "id": "settings-toggle-root",
        "el": "div",
        "layout": { "mode": "vertical", "width": "fill" },
        "appearance": { "background": "setupCardFill", "borderColor": "setupCardStroke", "borderWidth": 1, "radius": "md" },
        "children": [
          {
            "id": "settings-toggle-row",
            "el": "div",
            "layout": { "mode": "horizontal", "gap": "0", "padding": "4", "align": "center", "width": "fill" },
            "appearance": { "background": "$none", "textAlign": "left" },
            "children": [
              {
                "id": "settings-toggle-text",
                "el": "div",
                "layout": { "mode": "vertical", "gap": "0", "grow": true },
                "margin": { "right": "5" },
                "children": [
                  { "id": "settings-toggle-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
                  { "id": "settings-toggle-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
                ]
              },
              {
                "id": "settings-toggle-control",
                "el": "div",
                "layout": { "mode": "horizontal", "align": "center", "justify": "center", "width": 40, "height": 36 },
                "children": [
                  { "id": "settings-toggle-switch", "component": "ToggleSwitch", "props": { "label": "{title}" } }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "SettingsExpanderRow",
      "note": "Settings composite based on Community Toolkit SettingsExpander/SettingsCard at 34a57f969bf7966e0a3cbe9d4d10a47758d097a0, adapted to the requested iconless Windows Settings alignment. The entire header is one disclosure target with subtleHover/subtlePressed feedback, click/Enter/Space activation and browser-native expanded accessibility. The child row remains passive except for its shared ToggleSwitch. Native details/summary keeps each instance independent, preserves child switch state, and removes collapsed content from layout and keyboard navigation without shrinking focusable children to zero. Starts expanded. Header and child have a 16px left inset, 16px vertical padding, zero title/detail gap, a 24px trailing text margin, Body 20px and Caption 16px line heights: both shown rows are content-sized at 68px. The flex summary removes the browser triangle and RTL workaround. Header padding is 16,16,4,16; the trailing 32x32 slot has 8px right margin and a centered 16px Segoe Fluent ChevronDown glyph. This decorative span is part of the same header target, not a second button. The glyph retains the original fixed downward direction; state-linked direction and animation remain unimplemented. Child padding is 16,16,44,16, with the shared 40x20 switch centered in a 36px slot; no wrapper padding. WinUI Expander.xaml at 09cfc8ff3fbf556166dd813ae9b81646716f54bf animates downward opening from negative measured content height to zero over 333ms (0,0,0,1), and closing back over 167ms (1,1,0,1) before collapsing visibility. Its clipped translation and AnimatedChevronUpDownSmallVisualSource need additional disclosure support beyond the installed Colophon toggle transitions, so this preview opens/closes immediately. Native animation, system motion preferences, minimums and adaptive reflow remain port requirements. Application code is unchanged.",
      "props": {
        "title": "Advanced sandbox",
        "detail": "Fine-tune the command execution sandbox."
      },
      "root": {
        "id": "settings-expander-root",
        "el": "details",
        "attrs": { "open": "" },
        "layout": { "mode": "none", "width": "fill" },
        "appearance": { "background": "setupCardFill", "borderColor": "setupCardStroke", "borderWidth": 1, "radius": "md" },
        "children": [
          {
            "id": "settings-expander-header",
            "el": "summary",
            "attrs": { "role": "button", "tabindex": "0", "aria-label": "{title}" },
            "layout": { "mode": "horizontal", "gap": "0", "padding": { "left": "4", "top": "4", "right": "1", "bottom": "4" }, "align": "center", "width": "fill" },
            "appearance": { "background": "$none", "borderWidth": 0, "radius": "md", "color": "ink", "textAlign": "left" },
            "states": {
              "hover": { "background": "subtleHover" },
              "pressed": { "background": "subtlePressed" },
              "hoverPressed": { "background": "subtlePressed" }
            },
            "children": [
              {
                "id": "settings-expander-header-card",
                "el": "span",
                "layout": { "mode": "vertical", "padding": "0", "grow": true },
                "children": [
                  {
                    "id": "settings-expander-text",
                    "el": "span",
                    "layout": { "mode": "vertical", "gap": "0" },
                    "margin": { "right": "5" },
                    "appearance": { "textAlign": "left" },
                    "children": [
                      { "id": "settings-expander-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
                      { "id": "settings-expander-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
                    ]
                  }
                ]
              },
              {
                "id": "settings-expander-chevron-slot",
                "el": "span",
                "attrs": { "aria-hidden": "true" },
                "layout": { "mode": "horizontal", "align": "center", "justify": "center", "width": 32, "height": 32 },
                "margin": { "right": "2" },
                "children": [
                  {
                    "id": "settings-expander-chevron",
                    "el": "span",
                    "appearance": { "textStyle": "chatIcon", "color": "ink" },
                    "children": [ "\uE70D" ]
                  }
                ]
              }
            ]
          },
          {
            "id": "settings-expander-divider",
            "el": "div",
            "attrs": { "aria-hidden": "true" },
            "layout": { "height": 1, "width": "fill" },
            "appearance": { "background": "setupCardStroke" }
          },
          {
            "id": "settings-expander-content",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "0", "padding": "0", "width": "fill" },
            "children": [
              {
                "id": "settings-expander-child",
                "el": "div",
                "layout": { "mode": "horizontal", "gap": "0", "padding": { "left": "4", "top": "4", "right": "settingsItemEnd", "bottom": "4" }, "align": "center", "width": "fill" },
                "appearance": { "background": "$none", "borderWidth": 0, "textAlign": "left" },
                "children": [
                  {
                    "id": "settings-expander-item-text",
                    "el": "div",
                    "layout": { "mode": "vertical", "gap": "0", "grow": true },
                    "margin": { "right": "5" },
                    "children": [
                      { "id": "settings-expander-item-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "Allow network access" ] },
                      { "id": "settings-expander-item-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "Let sandboxed commands reach the network." ] }
                    ]
                  },
                  {
                    "id": "settings-expander-item-control",
                    "el": "div",
                    "layout": { "mode": "horizontal", "align": "center", "justify": "center", "width": 40, "height": 36 },
                    "children": [
                      { "id": "settings-expander-item-switch", "component": "ToggleSwitch", "props": { "label": "Allow network access" } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "SettingsWindowShell",
      "note": "Settings composite, shown as a content-only window sample per user direction: no left navigation pane or hidden navigation keyboard stops. The full-width content column has 24px padding and a 4px card gap matching the supplied Windows Settings reference. General uses the shared semibold SettingsSectionHeader. SettingsToggleRow remains passive around its switch; SettingsExpanderRow has one actionable header and independently interactive expanded content. All settings text shares the iconless 16px left inset. Production Windows/HubWindow.xaml remains unchanged, including its NavigationView, MinWidth 1000, Mica backdrop, title bar, 900px maximum content width and bottom status/toolbar; this sample does not claim to reproduce the complete native window.",
      "root": {
        "id": "settings-window-root",
        "el": "section",
        "layout": { "mode": "vertical", "width": "fill" },
        "appearance": { "background": "paper" },
        "children": [
          {
            "id": "settings-window-content",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "1", "padding": "5", "grow": true, "width": "fill" },
            "children": [
              { "id": "settings-window-section", "component": "SettingsSectionHeader", "props": { "children": "General" } },
              { "id": "settings-window-row-1", "component": "SettingsToggleRow" },
              { "id": "settings-window-row-2", "component": "SettingsExpanderRow" }
