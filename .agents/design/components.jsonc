    {
      "name": "ConnectionStatusFlyout",
      "note": "Gateway/Operator/Node status flyout from Controls/GatewayStatusContent.xaml (#1541), opened from the Workspace connection affordance. A 304px column of three status rows split by 1px `line` (CardStrokeColorDefault) dividers, closing with an Open Connection link. Each row pairs a 10px status dot with a body-strong label over a caption `muted` detail; a trailing accent HyperlinkButton (Reconnect / Approve) appears only when that layer needs action. The dot binds the Fluent system fill that matches state: `positive` (SystemFillColorSuccess) connected, `warning` (SystemFillColorCaution) attention, `critical` (SystemFillColorCritical) error, `muted` (SystemFillColorNeutral) unknown. Row vertical padding 10px maps to token 2; column spacing 11px to token 3. The flyout sheet, `md` overlay radius and shadow are supplied by the WinUI Flyout presenter; previewed here as a `surface` sheet.",
      "root": {
        "id": "conn-status-root",
        "el": "div",
        "layout": {
          "mode": "vertical",
          "width": 304,
          "padding": "3"
        },
        "appearance": {
          "background": "surface",
          "color": "ink",
          "radius": "md",
          "shadow": "md"
        },
        "children": [
          {
            "id": "conn-status-gateway",
            "el": "div",
            "layout": {
              "mode": "horizontal",
              "gap": "3",
              "align": "center",
              "padding": {
                "y": "2"
              },
              "width": "fill"
            },
            "children": [
              {
                "id": "conn-status-gateway-dot",
                "el": "span",
                "attrs": {
                  "aria-hidden": "true"
                },
                "layout": {
                  "mode": "horizontal",
                  "width": 10,
                  "height": 10
                },
                "appearance": {
                  "background": "positive",
                  "radius": "pill"
                }
              },
              {
                "id": "conn-status-gateway-text",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "grow": true
                },
                "children": [
                  {
                    "id": "conn-status-gateway-label",
                    "el": "span",
                    "appearance": {
                      "fontFamily": "body",
                      "textStyle": "body",
                      "color": "ink"
                    },
                    "children": [
                      "Gateway"
                    ]
                  },
                  {
                    "id": "conn-status-gateway-detail",
                    "el": "span",
                    "appearance": {
                      "fontFamily": "body",
                      "textStyle": "caption",
                      "color": "muted"
                    },
                    "children": [
                      "Connected · OpenClawGateway"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "conn-status-divider-1",
            "el": "div",
            "layout": {
