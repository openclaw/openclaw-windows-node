    {
      "name": "NotificationFlyout",
      "note": "Populated state from Controls/NotificationFlyoutContent.xaml. Native presenter padding is 16,15,16,17, with a 1px flyoutStroke border, md corners and a 352px content column inside the 386px frame. flyoutFill maps the acrylic fallback, not the card brush. Native medium-shadow outside insets are 10,2,10,18; the flyout shadow token is a light CSS reference, not native composition proof. Notification cards preserve CardBackgroundFillColorDefaultBrush alpha through setupCardFill/setupCardStroke, 12px padding and 4px vertical margins; the ListView's -4px horizontal margin cancels each card's +4px margin. Columns are 11px apart; text stack gap is 3px. Title is Body Strong, severity and Cancel use native Fluent glyphs, and recurrence uses the caution background with 7,1 padding and 10px radius. Header/footer reuse HyperlinkButton with native 4,0 padding and transparent 1px borders. NotificationFlyoutEmpty shows the supplied screenshot's empty state. Acrylic noise, font rasterization, native shadow/dark recipe, high-contrast 2px presenter border, scrolling and notification actions remain unverified/native-owned; do not claim pixel identity.",
      "props": {
        "title": "Approval required",
        "message": "A Windows node capability is waiting for your approval.",
        "metadata": "Just now · Node",
        "count": "2×"
      },
      "root": {
        "id": "notif-root",
        "el": "div",
        "layout": {
          "mode": "vertical",
          "gap": "0",
          "padding": { "left": "4", "top": "flyoutTop", "right": "4", "bottom": "flyoutBottom" },
          "width": 386
        },
        "margin": { "left": "textControlLeft", "top": "half", "right": "textControlLeft", "bottom": "flyoutShadowBottom" },
        "appearance": {
          "background": "flyoutFill",
          "borderColor": "flyoutStroke",
          "borderWidth": 1,
          "color": "nativeText",
          "radius": "md",
          "shadow": "flyout"
        },
        "children": [
          {
            "id": "notif-header",
            "el": "div",
            "layout": {
              "mode": "horizontal",
              "justify": "end"
            },
            "margin": { "left": "half", "right": "half", "bottom": "2" },
            "children": [
              {
                "id": "notif-clear",
                "component": "HyperlinkButton",
                "props": { "children": "Clear all" },
                "appearance": {
                  "color": "accentText",
                  "borderColor": "subtleButtonBorder",
                  "borderWidth": 1
                }
              }
            ]
          },
          {
            "id": "notif-card",
            "el": "div",
            "layout": {
              "mode": "horizontal",
              "gap": "buttonHorizontal",
              "padding": "3",
              "align": "start",
              "width": "fill"
            },
            "margin": { "y": "1" },
            "appearance": {
              "background": "setupCardFill",
              "borderColor": "setupCardStroke",
              "borderWidth": 1,
              "color": "nativeText",
              "radius": "md"
            },
            "children": [
              {
                "id": "notif-card-glyph",
                "el": "span",
                "attrs": {
                  "aria-hidden": "true"
                },
                "layout": { "width": 16, "height": 16 },
                "margin": { "top": "half" },
                "appearance": {
                  "textStyle": "chatIcon",
                  "color": "nativeText"
                },
                "children": ["\uE7BA"]
              },
              {
                "id": "notif-card-text",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "notificationTextGap",
                  "grow": true
                },
                "children": [
                  {
                    "id": "notif-card-titlerow",
                    "el": "div",
                    "layout": {
                      "mode": "horizontal",
                      "gap": "2",
                      "align": "center"
                    },
                    "children": [
                      {
