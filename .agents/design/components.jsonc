                      "background": "accentSubtle",
                      "color": "accentInk",
                      "radius": "bubble"
                    },
                    "children": [
                      "Can you list the Windows node capabilities?"
                    ]
                  },
                  {
                    "id": "chat-thread-user-footer",
                    "el": "div",
                    "layout": {
                      "mode": "horizontal",
                      "gap": "2",
                      "padding": {
                        "x": "2"
                      },
                      "align": "center"
                    },
                    "appearance": {
                      "fontFamily": "body",
                      "textStyle": "caption",
                      "color": "muted"
                    },
                    "children": [
                      {
                        "id": "chat-thread-user-time",
                        "el": "span",
