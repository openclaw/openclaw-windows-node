        "el": "label",
        "class": "workspace-ref-field",
        "children": [
          "{label}",
          {
            "id": "workspace-input",
            "el": "input",
            "attrs": {
              "value": "{value}",
              "placeholder": "{placeholder}",
              "maxlength": "120"
            }
          }
        ]
