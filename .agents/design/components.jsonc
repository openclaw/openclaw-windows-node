                      }
                    ]
                  },
                  {
                    "id": "workspace-footer-spacer",
                    "el": "div",
                    "layout": {
                      "mode": "vertical",
                      "grow": true
                    }
                  },
                  {
                    "id": "workspace-footer",
                    "el": "div",
                    "layout": {
                      "mode": "horizontal",
                      "gap": "1",
                      "align": "center",
                      "width": "fill"
                    },
                    "children": [
                      {
                        "id": "workspace-owner",
                        "component": "UserIdentityBadge",
                        "props": {
                          "name": "{owner}",
                          "status": "{status}"
                        },
                        "layout": {
                          "grow": true
                        }
                      },
                      {
                        "id": "workspace-bell",
                        "el": "div",
                        "attrs": {
                          "role": "button",
                          "aria-label": "Notifications"
                        },
                        "layout": {
                          "mode": "horizontal",
                          "align": "center",
                          "justify": "center",
                          "width": 40,
                          "height": 40
                        },
                        "appearance": {
                          "color": "muted",
                          "radius": "sm"
                        },
                        "children": [
