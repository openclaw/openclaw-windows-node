                    },
                    "layout": {
                      "mode": "horizontal",
                      "align": "center",
                      "justify": "center",
                      "width": 32,
                      "height": 32
                    },
                    "appearance": {
                      "color": "muted",
                      "radius": "sm"
                    },
                    "children": [
                      {
                        "id": "chat-composer-settings-glyph",
                        "el": "svg",
                        "attrs": {
                          "width": "18",
                          "height": "18",
                          "viewBox": "0 0 24 24",
                          "fill": "none",
                          "aria-hidden": "true",
                          "stroke": "currentColor",
                          "stroke-width": "2",
                          "stroke-linecap": "round",
