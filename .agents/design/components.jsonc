    {
      "name": "ChatThread",
      "note": "A short thread: the \"does chat hang together\" check — a user turn (softer `accentSubtle` bubble on the right, with a hover Copy) and an assistant turn (avatar + Copy / Read aloud / context-usage readout), then the composer. Thread/bubble max-width 720px is a Reactor port note.",
      "root": {
        "id": "chat-thread-root",
        "el": "div",
        "layout": {
          "mode": "vertical",
          "gap": "3",
          "width": "fill"
        },
        "children": [
          {
            "id": "chat-thread-user",
            "el": "div",
            "layout": {
              "mode": "horizontal",
              "justify": "end",
              "width": "fill"
            },
            "children": [
              {
                "id": "chat-thread-user-stack",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "1",
                  "align": "end"
                },
                "children": [
                  {
                    "id": "chat-thread-user-bubble",
                    "el": "div",
                    "layout": {
                      "mode": "vertical",
                      "padding": {
                        "x": "4",
                        "y": "3"
                      }
                    },
                    "appearance": {
                      "fontFamily": "body",
                      "textStyle": "body",
                      "background": "accentSubtle",
                      "color": "accentInk",
                      "radius": "bubble"
                    },
                    "children": [
                      "Can you list the Windows node capabilities?"
                    ]
                  },
                  {
                    "id": "chat-thread-user-footer",
                    "el": "div",
                    "layout": {
                      "mode": "horizontal",
                      "gap": "2",
                      "padding": {
                        "x": "2"
                      },
                      "align": "center"
                    },
                    "appearance": {
                      "fontFamily": "body",
                      "textStyle": "caption",
                      "color": "muted"
                    },
                    "children": [
                      {
                        "id": "chat-thread-user-time",
                        "el": "span",
                        "children": [
                          "2:14 PM"
                        ]
                      },
                      {
                        "id": "chat-thread-user-copy",
                        "el": "div",
                        "attrs": {
                          "role": "button",
                          "title": "Copy",
                          "aria-label": "Copy message"
                        },
                        "layout": {
                          "mode": "horizontal",
                          "align": "center",
                          "justify": "center",
                          "width": 20,
                          "height": 20
                        },
                        "appearance": {
                          "color": "muted",
                          "radius": "sm"
                        },
                        "children": [
                          {
                            "id": "chat-thread-user-copy-glyph",
                            "el": "svg",
                            "attrs": {
                              "width": "14",
                              "height": "14",
                              "viewBox": "0 0 24 24",
                              "fill": "none",
                              "aria-hidden": "true",
                              "stroke": "currentColor",
                              "stroke-width": "2",
                              "stroke-linecap": "round",
                              "stroke-linejoin": "round"
                            },
                            "children": [
                              {
                                "id": "chat-thread-user-copy-rect",
                                "el": "rect",
                                "attrs": {
                                  "x": "9",
                                  "y": "9",
                                  "width": "11",
                                  "height": "11",
                                  "rx": "2"
                                }
                              },
                              {
                                "id": "chat-thread-user-copy-path",
                                "el": "path",
                                "attrs": {
                                  "d": "M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "chat-thread-assistant",
            "component": "ChatBubble",
            "props": {
              "time": "2:14 PM",
              "usage": "12.5K/200K (6%)",
              "children": "Paired to the gateway — 6 capabilities are live, including system.run and clipboard access."
            }
          },
          {
            "id": "chat-thread-composer",
            "component": "ChatComposer"
          }
        ]
      }
    },
    {
      "name": "ExampleScreen",
      "note": "A representative Connection screen composed from the pieces above — the \"does it hang together\" check for the whole system. The status board is a freeform layer so the two cards can overlap into a Fluent-style dashboard, exercising v3 absolute positioning alongside Auto Layout.",
      "root": {
        "id": "example-screen-root",
        "el": "section",
        "class": "ds-screen",
        "layout": {
          "mode": "vertical",
          "gap": "5",
          "width": "fill"
        },
        "children": [
          {
            "id": "example-screen-head",
            "el": "header",
            "class": "ds-screen-head",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "start",
              "justify": "space-between",
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-heading",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "1"
                },
                "children": [
                  {
                    "id": "example-screen-eyebrow",
                    "el": "p",
                    "class": "ds-eyebrow",
                    "children": [
                      "Connection"
                    ]
                  },
                  {
                    "id": "example-screen-title",
                    "el": "h2",
                    "class": "ds-screen-title",
                    "children": [
                      "OpenClaw Windows Hub"
                    ]
                  }
                ]
              },
              {
                "id": "example-screen-status",
                "component": "Badge",
                "props": {
                  "tone": "positive",
                  "children": "Connected"
                }
              }
            ]
          },
          {
            "id": "example-screen-board",
            "el": "div",
            "class": "ds-grid",
            "layout": {
              "mode": "horizontal",
              "width": "fill",
              "height": 176,
              "gap": "3"
            },
            "children": [
              {
                "id": "example-screen-gateway",
                "component": "Card",
                "props": {
                  "title": "Gateway",
                  "body": "Paired to OpenClawGateway · last seen just now."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              },
              {
                "id": "example-screen-node",
                "component": "Card",
                "props": {
                  "title": "Windows node",
                  "body": "6 capabilities exposed over MCP."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              }
            ]
          },
          {
            "id": "example-screen-row",
            "el": "div",
            "class": "ds-row",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "end",
              "wrap": true,
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-field",
                "component": "Field",
                "props": {
                  "label": "Gateway address",
                  "placeholder": "127.0.0.1:18789"
                },
                "layout": {
                  "grow": true
                }
              },
              {
                "id": "example-screen-connect",
                "component": "Button",
                "props": {
                  "children": "Connect",
                  "variant": "primary"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "NativeReferenceStyles",
      "note": "Reference-only adapter. Page pixels come from WinUI, not browser control reimplementations. Navigation hierarchy and artwork are extracted from HubWindow.xaml; dimensions follow the captured native NavigationView (40 DIP item pitch, 22 DIP icons).",
      "root": {
        "id": "native-reference-styles",
        "el": "style",
        "children": [
          ".native-reference-image {{ display:block; width:100%; height:auto; flex-shrink:0; }}",
          ".native-reference-titlebar {{ width:100%; height:var(--space-7); overflow:hidden; position:relative; flex-shrink:0; }}",
          ".native-reference-titlebar img {{ display:block; width:100%; height:100%; object-fit:fill; }}",
          "[data-proto-node-id='native-companion-titlebar'], [data-proto-node-id='floating-native-companion-titlebar'] {{ position:relative; }}",
          "[data-proto-node-id='companion-close'], [data-proto-node-id='floating-companion-close'] {{ position:absolute; right:0; top:0; width:var(--space-7); height:var(--space-7); padding:0; border:0; background:transparent; color:transparent; font-size:0; }}",
          "body:has([data-proto-node-id='settings-root']) .win-caption .wbtn {{ pointer-events:none; }}",
          ".native-reference-titlebar button {{ position:absolute; right:0; top:0; width:var(--space-7); height:100%; border:0; background:transparent; color:transparent; cursor:pointer; }}",
          ".native-reference-titlebar button:hover {{ background:var(--color-subtleHover); }}",
          ".native-source-nav {{ position:relative; width:100%; height:calc(var(--space-6) + var(--space-2)); display:flex; align-items:center; gap:var(--space-4); padding:0 var(--space-3); border:0; border-radius:var(--radius-sm); background:transparent; color:var(--color-ink); font-family:var(--font-body); font-size:var(--text-body-size); line-height:var(--text-body-line-height); text-align:left; }}",
          ".native-source-nav:hover {{ background:var(--color-subtleHover); outline:none; }}",
          ".native-source-nav[aria-current='page'] {{ background:var(--color-subtleHover); }}",
          ".native-source-nav[aria-current='page']::before {{ content:''; position:absolute; left:0; width:calc(var(--space-1)/2); height:var(--space-4); background:var(--color-accent); border-radius:var(--radius-pill); }}",
          ".native-source-nav img, .native-source-nav .native-nav-glyph {{ width:calc(var(--space-5) - var(--space-1)/2); height:calc(var(--space-5) - var(--space-1)/2); flex-shrink:0; object-fit:contain; }}",
          ".native-nav-glyph, .native-nav-chevron {{ font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif; }}",
          ".native-nav-glyph {{ font-size:calc(var(--space-5) - var(--space-1)/2); }}",
          ".native-nav-chevron {{ margin-left:auto; font-size:var(--space-3); }}",
          "[data-proto-node-id='refresh-settings-sidebar'], [data-proto-node-id='floating-refresh-settings-sidebar'] {{ flex-shrink:0; }}",
          "[data-proto-node-id^='native-panel-'], [data-proto-node-id^='floating-native-panel-'] {{ min-height:0; min-width:0; }}",
          ".native-reference-image {{ user-select:none; }}",
          ".native-source-nav {{ flex-shrink:0; }}",
          "[data-proto-node-id='native-navigation-scroll'] > *, [data-proto-node-id='floating-native-navigation-scroll'] > * {{ flex-shrink:0; }}",
          ".native-reference-dark, .native-hc-note {{ display:none !important; }}",
          "body:has([data-theme='dark'].is-active) .native-reference-light {{ display:none !important; }}",
          "body:has([data-theme='dark'].is-active) .native-reference-dark {{ display:block !important; }}",
          "body:has([data-theme='highContrast'].is-active) .native-reference-light, body:has([data-theme='highContrast'].is-active) .native-reference-dark {{ display:none !important; }}",
          "body:has([data-theme='highContrast'].is-active) .native-hc-note {{ display:block !important; }}",
          ".native-reference-titlebar img {{ clip-path:inset(0 calc(var(--space-8) * 2 + var(--space-3)) 0 0); }}",
          ".native-hc-note {{ padding:var(--space-5); color:var(--color-ink); font:inherit; }}"
        ]
      }
    },
    {
      "name": "NativeSourceNavImage",
      "note": "Production NavigationViewItem label and artwork. Preview only. Group expand and page selection are scene actions.",
      "props": {
        "label": "Connection",
        "icon": "",
        "current": "false",
        "chevron": ""
      },
      "root": {
        "id": "native-nav-root",
        "el": "button",
        "class": "native-source-nav",
        "attrs": {
          "type": "button",
          "aria-current": "{current}",
          "style": "color:var(--color-ink);font-family:var(--font-body)"
        },
        "control": {
          "chrome": "none",
          "focus": {
            "kind": "outline",
            "color": "accent"
          }
        },
        "children": [
          {
            "id": "native-nav-icon",
            "el": "img",
            "attrs": {
              "src": "{icon}",
              "alt": ""
            }
          },
          {
            "id": "native-nav-label",
            "el": "span",
            "children": [
              "{label}"
            ]
          },
          {
            "id": "native-nav-chevron",
            "el": "span",
            "class": "native-nav-chevron",
            "attrs": {
              "aria-hidden": "true"
            },
            "children": [
              "{chevron}"
            ]
          }
        ]
      }
    },
    {
      "name": "NativeSourceNavGlyph",
      "note": "Production NavigationViewItem label and artwork. Preview only. Group expand and page selection are scene actions.",
      "props": {
        "label": "Connection",
        "icon": "",
        "current": "false",
        "chevron": ""
      },
      "root": {
        "id": "native-nav-root",
        "el": "button",
        "class": "native-source-nav",
        "attrs": {
          "type": "button",
          "aria-current": "{current}",
          "style": "color:var(--color-ink);font-family:var(--font-body)"
        },
        "control": {
          "chrome": "none",
          "focus": {
            "kind": "outline",
            "color": "accent"
          }
        },
        "children": [
          {
            "id": "native-nav-icon",
            "el": "span",
            "class": "native-nav-glyph",
            "attrs": {
              "aria-hidden": "true"
            },
            "children": [
              "{icon}"
            ]
          },
          {
            "id": "native-nav-label",
            "el": "span",
            "children": [
              "{label}"
            ]
          },
          {
            "id": "native-nav-chevron",
            "el": "span",
            "class": "native-nav-chevron",
            "attrs": {
              "aria-hidden": "true"
            },
            "children": [
              "{chevron}"
            ]
          }
        ]
      }
    },
