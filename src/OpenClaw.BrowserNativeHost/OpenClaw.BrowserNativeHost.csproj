<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenClaw.BrowserNativeHost</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Keep the bootstrap executable small; do not bring speech/WinUI dependencies into Chrome. -->
  <ItemGroup>
    <Compile Include="../OpenClaw.Shared/Browser/BrowserNativeProtocol.cs" Link="BrowserNativeProtocol.cs" />
    <Compile Include="../OpenClaw.Shared/Browser/BrowserNativeRegistration.cs" Link="BrowserNativeRegistration.cs" />
    <Compile Include="../OpenClaw.Shared/Browser/ChromeExtensionInstallRequest.cs" Link="ChromeExtensionInstallRequest.cs" />
  </ItemGroup>
</Project>
