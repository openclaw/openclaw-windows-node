<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.VoiceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OpenClawTray.Presentation"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:OpenClawTray.Helpers">

    <Page.Resources>
        <!-- Reserved width for a field hosted in a SettingsCard; the card wraps it below its header when narrow. -->
        <x:Double x:Key="SettingsFieldMinWidth">240</x:Double>
        <Thickness x:Key="SectionHeaderMargin">4,18,4,4</Thickness>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid HorizontalAlignment="Stretch">
        <StackPanel presentation:PageContentLayout.IsEnabled="True" Spacing="4">

            <StackPanel Spacing="4" Margin="0,0,0,8">
            <TextBlock x:Uid="VoiceSettingsPage_PageTitle" x:Name="PageTitleText" Text="Voice &amp; Audio"
                       AutomationProperties.AutomationId="VoiceSettingsPageMarker"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Uid="VoiceSettingsPage_PageDescription" x:Name="PageDescriptionText"
                       Text="Configure speech-to-text and voice interaction settings. All speech processing runs locally on your device."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Speech model -->
            <StackPanel x:Name="ModelCard" Spacing="4">
                <TextBlock x:Uid="VoiceSettingsPage_ModelHeader" x:Name="ModelHeaderText" Text="Speech Model"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="4,6,4,4"/>
                <InfoBar x:Name="SttCapabilityNotice" x:Uid="VoiceSettingsPage_SttCapabilityDisabledNotice"
                         Title="Speech-to-text is disabled"
                         Message="Enable it in Permissions to change these settings."
                         Severity="Warning" IsOpen="False" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Uid="VoiceSettingsPage_OpenPermissionsLink"
                                Content="Open Permissions"
                                Click="OnOpenPermissionsClick"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Disabled as a unit while speech-to-text is off in Permissions. -->
                <ContentControl x:Name="SttSettings" IsTabStop="False" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        presentation:SettingsCardGroup.IsEnabled="True">
                <StackPanel>
                <toolkit:SettingsCard x:Name="ModelSizeCard" x:Uid="VoiceSettingsPage_ModelCombo"
                                      Header="Model Size">
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="VoiceSettingsPage_ModelRequirementText" x:Name="ModelRequirementText"
                                   Text="Voice input is not ready until at least one speech model is downloaded."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </toolkit:SettingsCard.Description>
                    <ComboBox x:Name="ModelCombo"
                              SelectionChanged="OnModelChanged"
                              MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="360" HorizontalAlignment="Left"
                              AutomationProperties.Name="{Binding Header, ElementName=ModelSizeCard}">
                        <ComboBoxItem x:Uid="VoiceSettingsPage_ModelTiny"  Content="Tiny (~75 MB): Fast, basic accuracy" Tag="tiny"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_ModelBase"  Content="Base (~142 MB): Good balance"        Tag="base"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_ModelSmall" Content="Small (~466 MB): High accuracy"      Tag="small"/>
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="LanguageCard">
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="VoiceSettingsPage_LanguageHeader" x:Name="LanguageHeaderText" Text="Language"/>
                    </toolkit:SettingsCard.Header>
                    <ComboBox x:Uid="VoiceSettingsPage_LanguageCombo" x:Name="LanguageCombo"
                              SelectionChanged="OnLanguageChanged"
                              MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="360" HorizontalAlignment="Left">
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangAuto" Content="Auto-detect" Tag="auto"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangEn"   Content="English"     Tag="en"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangEs"   Content="Spanish"     Tag="es"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangFr"   Content="French"      Tag="fr"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangDe"   Content="German"      Tag="de"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangJa"   Content="Japanese"    Tag="ja"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangZh"   Content="Chinese"     Tag="zh"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangKo"   Content="Korean"      Tag="ko"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangPt"   Content="Portuguese"  Tag="pt"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_LangIt"   Content="Italian"     Tag="it"/>
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="ModelDownloadCard">
                    <toolkit:SettingsCard.Header>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextBlockStyle}"/>
                            <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed"
                                         Minimum="0" Maximum="100"/>
                        </StackPanel>
                    </toolkit:SettingsCard.Header>
                    <StackPanel x:Name="DownloadActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TestVoiceButton" Click="OnTestVoiceClick"
                                AutomationProperties.LabeledBy="{Binding ElementName=TestVoiceButtonText}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="TestVoiceBtnIcon" Glyph="&#xE720;" FontSize="14"/>
                                <TextBlock x:Uid="VoiceSettingsPage_TestVoiceInput" x:Name="TestVoiceButtonText" Text="Test Voice Input"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DownloadButton" Click="OnDownloadClick"
                                AutomationProperties.LabeledBy="{Binding ElementName=DownloadButtonText}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                <TextBlock x:Uid="VoiceSettingsPage_DownloadButtonText" x:Name="DownloadButtonText" Text="Download Model"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </toolkit:SettingsCard>
                </StackPanel>
                </Border>

                <!-- Inline voice test area (toggled by test button) -->
                <Border x:Name="InlineTestArea" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <!-- Transcript area with speech bubbles -->
                        <ScrollViewer x:Name="InlineTestTranscriptScroll" MaxHeight="140"
                                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="InlineTestTranscriptPanel" Spacing="6"/>
                        </ScrollViewer>

                        <!-- Recording pill (shown while recording, below transcript) -->
                        <StackPanel x:Name="InlineTestPillHost" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Visibility="Collapsed"/>

                        <!-- Status text (only shown for errors/done) -->
                        <TextBlock x:Name="InlineTestStatus" Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- Centered buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="InlineTestStartBtn" Click="OnInlineTestStartClick"
                                    AutomationProperties.LabeledBy="{Binding ElementName=InlineTestBtnLabel}"
                                    Style="{StaticResource AccentButtonStyle}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="InlineTestBtnIcon" Glyph="&#xE720;" FontSize="14"/>
                                    <TextBlock x:Uid="VoiceSettingsPage_Record" x:Name="InlineTestBtnLabel" Text="Record" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="InlineTestCloseBtn" Click="OnInlineTestCloseClick"
                                    Padding="8" ToolTipService.ToolTip="Close test panel">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
                </ContentControl>
            </StackPanel>

            <!-- Voice chat -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="VoiceSettingsPage_VoiceChatHeader" x:Name="VoiceChatHeaderText" Text="Voice Chat"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="{StaticResource SectionHeaderMargin}"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        presentation:SettingsCardGroup.IsEnabled="True">
                <StackPanel>
                <toolkit:SettingsCard x:Name="SilenceCard" x:Uid="VoiceSettingsPage_SilenceSlider"
                                      Header="Silence timeout (seconds)">
                    <Slider x:Name="SilenceSlider"
                            Minimum="0.5" Maximum="5" StepFrequency="0.5"
                            ValueChanged="OnSilenceChanged"
                            MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="250"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding Header, ElementName=SilenceCard}"/>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="TtsResponseCard" x:Uid="VoiceSettingsPage_TtsResponseToggle"
                                      Header="Read responses aloud">
                    <ToggleSwitch x:Name="TtsResponseToggle" Toggled="OnTtsResponseToggled"
                                  MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="{Binding Header, ElementName=TtsResponseCard}"/>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="AudioFeedbackCard" x:Uid="VoiceSettingsPage_AudioFeedbackToggle"
                                      Header="Audio feedback sounds">
                    <ToggleSwitch x:Name="AudioFeedbackToggle" Toggled="OnAudioFeedbackToggled"
                                  MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="{Binding Header, ElementName=AudioFeedbackCard}"/>
                </toolkit:SettingsCard>
                </StackPanel>
                </Border>
            </StackPanel>

            <!-- Companion voice -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="VoiceSettingsPage_VoiceHeader" x:Name="VoiceHeaderText" Text="Companion Voice"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="{StaticResource SectionHeaderMargin}"/>
                <TextBlock x:Uid="VoiceSettingsPage_VoiceDescription" x:Name="VoiceDescriptionText"
                           Text="Choose the voice used when reading responses aloud."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Margin="4,0,4,4"/>
                <InfoBar x:Name="TtsCapabilityNotice" x:Uid="VoiceSettingsPage_TtsCapabilityDisabledNotice"
                         Title="Text-to-speech is disabled"
                         Message="Enable it in Permissions to change the local voice settings."
                         Severity="Warning" IsOpen="False" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Uid="VoiceSettingsPage_OpenPermissionsLink"
                                Content="Open Permissions"
                                Click="OnOpenPermissionsClick"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        presentation:SettingsCardGroup.IsEnabled="True">
                <StackPanel>
                <toolkit:SettingsCard x:Name="GatewayVoiceCard" x:Uid="VoiceSettingsPage_GatewayVoice"
                                      Header="Use connected Gateway voice">
                    <toolkit:SettingsCard.Description>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="VoiceSettingsPage_GatewayVoiceDescription" TextWrapping="Wrap"
                                       Text="Chat Read Aloud and automatic replies use the Gateway's configured voice. Text is sent to the Gateway and its speech provider. Keys stay on the Gateway. Local node and MCP speech are unchanged."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Uid="VoiceSettingsPage_GatewayVoiceNoFallback" TextWrapping="Wrap"
                                       Text="No automatic local fallback. If unavailable, turn this option off to use your local provider."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch x:Name="GatewayVoiceToggle" Toggled="OnGatewayVoiceToggled"
                                  MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="{Binding Header, ElementName=GatewayVoiceCard}"/>
                </toolkit:SettingsCard>

                <!-- Local provider and voices. Disabled as a unit while text-to-speech is off in Permissions;
                     the Gateway voice card above is a chat setting and stays available. -->
                <ContentControl x:Name="TtsSettings" IsTabStop="False" HorizontalContentAlignment="Stretch">
                <StackPanel>
                <toolkit:SettingsCard x:Name="TtsProviderCard" x:Uid="VoiceSettingsPage_TtsProviderCombo"
                                      Header="Provider">
                    <ComboBox x:Name="TtsProviderCombo"
                              SelectionChanged="OnTtsProviderChanged"
                              MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="360" HorizontalAlignment="Left"
                              AutomationProperties.Name="{Binding Header, ElementName=TtsProviderCard}">
                        <ComboBoxItem x:Uid="VoiceSettingsPage_TtsKokoro"     Content="Kokoro (local neural voices)"         Tag="kokoro"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_TtsPiper"      Content="Piper (local neural voices)"          Tag="piper"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_TtsWindows"    Content="Windows (built-in neural voices)"     Tag="windows"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_TtsElevenLabs" Content="ElevenLabs (cloud, requires API key)" Tag="elevenlabs"/>
                        <ComboBoxItem x:Uid="VoiceSettingsPage_TtsMiniMax" Content="MiniMax (cloud, requires API key)" Tag="minimax"/>
                    </ComboBox>
                </toolkit:SettingsCard>

                <!-- Kokoro voice picker (local neural TTS via kokoro.cpp) -->
                <StackPanel x:Name="KokoroVoicePanel" Visibility="Collapsed">
                    <toolkit:SettingsCard x:Name="KokoroVoiceCard" x:Uid="VoiceSettingsPage_KokoroVoiceCombo"
                                          Header="Voice">
                        <ComboBox x:Name="KokoroVoiceCombo"
                                  SelectionChanged="OnKokoroVoiceChanged"
                                  MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="400" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{Binding Header, ElementName=KokoroVoiceCard}"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="KokoroDownloadCard">
                        <toolkit:SettingsCard.Header>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="KokoroStatusText" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                <ProgressBar x:Name="KokoroDownloadProgress" Visibility="Collapsed"
                                             IsIndeterminate="False" Maximum="100" Height="6" MaxWidth="400" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </toolkit:SettingsCard.Header>
                        <toolkit:SettingsCard.Description>
                            <TextBlock x:Uid="VoiceSettingsPage_KokoroInfoText" x:Name="KokoroInfoText"
                                       Text="Voice packs download from GitHub releases (about 380 MB for English and Chinese, about 310 MB for Spanish). They run fully on this PC; no audio leaves your device."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </toolkit:SettingsCard.Description>
                        <StackPanel x:Name="KokoroActions" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="KokoroDownloadButton" Click="OnKokoroDownloadClick"
                                    AutomationProperties.LabeledBy="{Binding ElementName=KokoroDownloadButtonText}"
                                    Width="180" MinHeight="32">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="KokoroDownloadIcon" Glyph="&#xE896;" FontSize="14"/>
                                    <TextBlock x:Uid="VoiceSettingsPage_KokoroDownloadButtonText" x:Name="KokoroDownloadButtonText" Text="Download Voice Pack"/>
                                </StackPanel>
                            </Button>
                            <Button x:Uid="VoiceSettingsPage_KokoroDeleteButton" x:Name="KokoroDeleteButton" Click="OnKokoroDeleteClick"
                                    Content="Delete" Width="80" Visibility="Collapsed"/>
                            <Button x:Name="KokoroPreviewButton" Click="OnKokoroPreviewClick"
                                    AutomationProperties.LabeledBy="{Binding ElementName=KokoroPreviewLabel}"
                                    Width="100" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="KokoroPreviewIcon" Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Uid="VoiceSettingsPage_KokoroPreview" x:Name="KokoroPreviewLabel" Text="Preview"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- Piper voice picker (local neural TTS via Sherpa-ONNX) -->
                <StackPanel x:Name="PiperVoicePanel" Visibility="Collapsed">
                    <toolkit:SettingsCard x:Name="PiperVoiceCard" x:Uid="VoiceSettingsPage_PiperVoiceCombo"
                                          Header="Voice">
                        <ComboBox x:Name="PiperVoiceCombo"
                                  SelectionChanged="OnPiperVoiceChanged"
                                  MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="400" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{Binding Header, ElementName=PiperVoiceCard}"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="PiperDownloadCard">
                        <toolkit:SettingsCard.Header>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="PiperStatusText" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                <ProgressBar x:Name="PiperDownloadProgress" Visibility="Collapsed"
                                             IsIndeterminate="False" Maximum="100" Height="6" MaxWidth="400" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </toolkit:SettingsCard.Header>
                        <toolkit:SettingsCard.Description>
                            <TextBlock x:Uid="VoiceSettingsPage_PiperInfoText" x:Name="PiperInfoText"
                                       Text="Voices download from the sherpa-onnx project's GitHub releases (~25 MB low quality, up to ~150 MB high quality). They run fully on this PC; no audio leaves your device."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </toolkit:SettingsCard.Description>
                        <StackPanel x:Name="PiperActions" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PiperDownloadButton" Click="OnPiperDownloadClick"
                                    AutomationProperties.LabeledBy="{Binding ElementName=PiperDownloadButtonText}"
                                    Width="180" MinHeight="32">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="PiperDownloadIcon" Glyph="&#xE896;" FontSize="14"/>
                                    <TextBlock x:Uid="VoiceSettingsPage_PiperDownloadButtonText" x:Name="PiperDownloadButtonText" Text="Download Voice"/>
                                </StackPanel>
                            </Button>
                            <Button x:Uid="VoiceSettingsPage_PiperDeleteButton" x:Name="PiperDeleteButton" Click="OnPiperDeleteClick"
                                    Content="Delete" Width="80" Visibility="Collapsed"/>
                            <Button x:Name="PiperPreviewButton" Click="OnPiperPreviewClick"
                                    AutomationProperties.LabeledBy="{Binding ElementName=PiperPreviewLabel}"
                                    Width="100" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="PiperPreviewIcon" Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Uid="VoiceSettingsPage_PiperPreview" x:Name="PiperPreviewLabel" Text="Preview"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- Windows voice picker -->
                <StackPanel x:Name="WindowsVoicePanel" Visibility="Collapsed">
                    <toolkit:SettingsCard x:Name="WindowsVoiceCard" x:Uid="VoiceSettingsPage_WindowsVoiceCombo"
                                          Header="Voice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="WindowsVoiceCombo"
                                      SelectionChanged="OnWindowsVoiceChanged"
                                      MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                      AutomationProperties.Name="{Binding Header, ElementName=WindowsVoiceCard}"/>
                            <Button x:Name="PreviewVoiceButton" Click="OnPreviewVoiceClick"
                                    AutomationProperties.LabeledBy="{Binding ElementName=PreviewVoiceLabel}"
                                    Width="140">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="PreviewVoiceIcon" Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Uid="VoiceSettingsPage_PreviewVoice" x:Name="PreviewVoiceLabel" Text="Preview Voice"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- ElevenLabs settings -->
                <StackPanel x:Name="ElevenLabsPanel" Visibility="Collapsed">
                    <toolkit:SettingsCard x:Name="ElevenLabsApiKeyCard" x:Uid="VoiceSettingsPage_ElevenLabsApiKeyBox"
                                          Header="API Key">
                        <PasswordBox x:Name="ElevenLabsApiKeyBox"
                                     PasswordChanged="OnElevenLabsKeyChanged"
                                     MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{Binding Header, ElementName=ElevenLabsApiKeyCard}"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="ElevenLabsVoiceIdCard" x:Uid="VoiceSettingsPage_ElevenLabsVoiceIdBox"
                                          Header="Voice ID">
                        <TextBox x:Uid="VoiceSettingsPage_ElevenLabsVoiceIdField" x:Name="ElevenLabsVoiceIdBox"
                                 TextChanged="OnElevenLabsVoiceIdChanged"
                                 MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                 PlaceholderText="e.g. 21m00Tcm4TlvDq8ikWAM"
                                 AutomationProperties.Name="{Binding Header, ElementName=ElevenLabsVoiceIdCard}"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="ElevenLabsModelCard" x:Uid="VoiceSettingsPage_ElevenLabsModelBox"
                                          Header="Model (optional)">
                        <TextBox x:Uid="VoiceSettingsPage_ElevenLabsModelField" x:Name="ElevenLabsModelBox"
                                 TextChanged="OnElevenLabsModelChanged"
                                 MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                 PlaceholderText="e.g. eleven_turbo_v2"
                                 AutomationProperties.Name="{Binding Header, ElementName=ElevenLabsModelCard}"/>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="MiniMaxPanel" Visibility="Collapsed">
                    <toolkit:SettingsCard x:Name="MiniMaxApiKeyCard" x:Uid="VoiceSettingsPage_MiniMaxApiKeyBox"
                                          Header="API Key">
                        <PasswordBox x:Name="MiniMaxApiKeyBox"
                                     PasswordChanged="OnMiniMaxKeyChanged"
                                     MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{Binding Header, ElementName=MiniMaxApiKeyCard}"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="MiniMaxVoiceIdCard" x:Uid="VoiceSettingsPage_MiniMaxVoiceIdBox"
                                          Header="Voice ID">
                        <TextBox x:Uid="VoiceSettingsPage_MiniMaxVoiceIdField" x:Name="MiniMaxVoiceIdBox"
                                 TextChanged="OnMiniMaxVoiceIdChanged"
                                 MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                 PlaceholderText="e.g. male-qn-qingse"
                                 AutomationProperties.Name="{Binding Header, ElementName=MiniMaxVoiceIdCard}"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="MiniMaxModelCard" x:Uid="VoiceSettingsPage_MiniMaxModelBox"
                                          Header="Model">
                        <TextBox x:Uid="VoiceSettingsPage_MiniMaxModelField" x:Name="MiniMaxModelBox"
                                 TextChanged="OnMiniMaxModelChanged"
                                 MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                 PlaceholderText="speech-2.8-hd"
                                 AutomationProperties.Name="{Binding Header, ElementName=MiniMaxModelCard}"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="MiniMaxRegionCard" x:Uid="VoiceSettingsPage_MiniMaxRegionCombo"
                                          Header="Region">
                        <ComboBox x:Name="MiniMaxRegionCombo"
                                  SelectionChanged="OnMiniMaxRegionChanged"
                                  MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{Binding Header, ElementName=MiniMaxRegionCard}">
                            <ComboBoxItem x:Uid="VoiceSettingsPage_MiniMaxRegionGlobal" Content="Global" Tag="global_en"/>
                            <ComboBoxItem x:Uid="VoiceSettingsPage_MiniMaxRegionChina" Content="China" Tag="cn_zh"/>
                        </ComboBox>
                    </toolkit:SettingsCard>
                </StackPanel>
                </StackPanel>
                </ContentControl>
                </StackPanel>
                </Border>
            </StackPanel>

            <!-- Privacy notice -->
            <toolkit:SettingsCard Margin="0,8,0,0">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D7;"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              AutomationProperties.AccessibilityView="Raw"/>
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="VoiceSettingsPage_PrivacyNote" x:Name="PrivacyNoteText"
                               Text="Piper, Windows, and speech recognition run on this device. Cloud TTS providers send response text to their services for synthesis; microphone audio is not sent to them."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Header>
            </toolkit:SettingsCard>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
