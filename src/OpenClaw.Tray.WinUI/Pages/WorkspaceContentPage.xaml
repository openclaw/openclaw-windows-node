<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.WorkspaceContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="WorkspaceCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="MinWidth" Value="240"/>
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageBody" Padding="32" Spacing="24" MaxWidth="1400" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="Heading" AutomationProperties.AutomationId="WorkspacePageHeading"
                               Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="RefreshButton" x:Uid="WorkspaceShell_Refresh" Grid.Column="1" Content="Refresh"
                        VerticalAlignment="Top" Click="OnRefresh"/>
            </Grid>
            <InfoBar x:Name="ConnectionInfo" x:Uid="WorkspaceShell_ConnectionInfo"
                     IsOpen="False" IsClosable="False" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Uid="WorkspaceShell_OpenConnection" Content="Open Connection" Click="OnOpenConnection"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed"
                          Width="32" Height="32" HorizontalAlignment="Left"/>
            <StackPanel x:Name="Sections" Spacing="24"/>
        </StackPanel>
    </ScrollViewer>
</Page>
