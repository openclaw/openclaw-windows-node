<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.ClawHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid Background="{ThemeResource NavigationViewContentBackground}">
        <Grid x:Name="WebViewHost">
            <WebView2 x:Name="ClawHubWebView"
                      AutomationProperties.AutomationId="ClawHubWebView"/>
        </Grid>

        <ProgressRing x:Name="LoadingRing"
                      Width="40"
                      Height="40"
                      IsActive="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <Border x:Name="ErrorPanel"
                Visibility="Collapsed"
                MaxWidth="620"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock Text="ClawHub is unavailable"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="Try again"
                        HorizontalAlignment="Left"
                        Click="OnRetry"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
