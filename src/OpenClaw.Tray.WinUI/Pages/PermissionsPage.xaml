<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenClawTray.Pages.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OpenClawTray.Presentation"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Thickness x:Key="PermSectionHeaderMargin">4,18,4,4</Thickness>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel presentation:PageContentLayout.IsEnabled="True" Spacing="4">

            <!-- ───────── Page header ───────── -->
            <TextBlock x:Uid="PermissionsPage_Permissions" Text="Permissions"
                       AutomationProperties.AutomationId="PermissionsPageMarker"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                <FontIcon Glyph="&#xE977;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="HostnameText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Uid="PermissionsPage_IntroText"
                       Text="Capabilities this PC offers to agents through the gateway, plus what each agent is allowed to do once connected."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- ═════════ Node Mode + Node Status ═════════ -->
            <toolkit:SettingsCard x:Name="NodeModeCard">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE839;" AutomationProperties.AccessibilityView="Raw"/>
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="PermissionsPage_NodeMode" Text="Node mode"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="PermissionsPage_WhenOnThisPC" Text="When on, this PC registers as a node and offers the capabilities below to agents over the gateway."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <ToggleSwitch x:Name="NodeModeToggle"
                              MinWidth="0" OnContent="" OffContent=""
                              Toggled="OnNodeModeToggled"
                              AutomationProperties.AutomationId="CapabilitiesNodeModeToggle"
                              AutomationProperties.Name="Node mode"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard AutomationProperties.AutomationId="NodeStatusCard">
                <toolkit:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="NodeStatusDot" Width="10" Height="10"
                                 Fill="Gray" VerticalAlignment="Center"
                                 AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Uid="NodeStatusText" x:Name="NodeStatusText" Text="Node mode disabled"/>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Name="NodeDetailsText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
            </toolkit:SettingsCard>

            <!-- ═════════ Capability features ═════════ -->
            <TextBlock x:Uid="PermissionsPage_Capabilities" x:Name="FeaturesSectionHeader" Text="Capabilities" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>
            <TextBlock x:Uid="PermissionsPage_ToggleIndividualFeaturesThat" x:Name="FeaturesSectionDescription"
                       Text="Toggle individual features that agents may request from this PC."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="4,0,4,4"/>

            <!-- Capability rows are built in code-behind as SettingsCards (label, description, toggle). -->
            <ItemsRepeater x:Name="CapabilityRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!-- ═════════ Voice settings link (only when STT or TTS capability is on) ═════════ -->
            <toolkit:SettingsCard x:Name="VoiceSettingsCard"
                                  Visibility="Collapsed"
                                  AutomationProperties.AutomationId="PermissionsVoiceSettingsCard">
                <toolkit:SettingsCard.Header>
                    <HyperlinkButton x:Name="VoiceSettingsLink"
                                     x:Uid="PermissionsPage_VoiceSettingsLink"
                                     Content="Voice &amp; Audio settings"
                                     Click="OnVoiceSettingsClick"
                                     Padding="0"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <StackPanel x:Name="VoiceSettingsHelpPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                        <FontIcon x:Name="VoiceSettingsWarningIcon"
                                  Glyph="&#xE7BA;"
                                  FontSize="14"
                                  Margin="0,1,0,0"
                                  VerticalAlignment="Top"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="VoiceSettingsHelpText"
                                   Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </toolkit:SettingsCard.Description>
            </toolkit:SettingsCard>

            <!-- ═════════ App access consent ═════════ -->
            <TextBlock x:Uid="PermissionsPage_AppAccess" Text="App access"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>
            <TextBlock x:Uid="PermissionsPage_AppAccessDescription"
                       Text="Allow sensitive capture without prompting every time. OpenClaw still notifies you before each access and shows a countdown before recordings."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="4,0,4,4"/>

            <toolkit:SettingsCard AutomationProperties.AutomationId="AppAccessScreenCaptureCard">
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsRow_ScreenRec_Header" Text="Allow screen capture"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsRow_ScreenRec_Description"
                               Text="Lets agents capture the screen via screen.* commands."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <ToggleSwitch x:Name="ScreenRecordingToggle" MinWidth="0" OnContent="" OffContent=""
                              IsOn="{Binding ScreenRecordingConsentGiven, Mode=TwoWay}"
                              AutomationProperties.AutomationId="SettingsPageScreenRecording"
                              AutomationProperties.Name="Allow screen capture"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard AutomationProperties.AutomationId="AppAccessCameraCaptureCard">
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsRow_CamRec_Header" Text="Allow camera capture"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsRow_CamRec_Description"
                               Text="Lets agents capture the camera via camera.* commands."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <ToggleSwitch x:Name="CameraRecordingToggle" MinWidth="0" OnContent="" OffContent=""
                              IsOn="{Binding CameraRecordingConsentGiven, Mode=TwoWay}"
                              AutomationProperties.AutomationId="SettingsPageCameraRecording"
                              AutomationProperties.Name="Allow camera capture"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard AutomationProperties.AutomationId="AppAccessLocationCard">
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsRow_Location_Header" Text="Allow location access"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsRow_Location_Description"
                               Text="Lets agents read device location via location.* commands."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <ToggleSwitch x:Name="LocationConsentToggle" MinWidth="0" OnContent="" OffContent=""
                              IsOn="{Binding LocationConsentGiven, Mode=TwoWay}"
                              AutomationProperties.AutomationId="SettingsPageLocationConsent"
                              AutomationProperties.Name="Allow location access"/>
            </toolkit:SettingsCard>

            <!-- ═════════ Integrations ═════════ -->
            <TextBlock x:Uid="PermissionsPage_Integrations" Text="Integrations" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    presentation:SettingsCardGroup.IsEnabled="True">
            <StackPanel>
            <toolkit:SettingsCard x:Name="McpCard">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" AutomationProperties.AccessibilityView="Raw"/>
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="PermissionsPage_McpHeader" Text="Local MCP Server"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="PermissionsPage_McpDescription"
                               Text="Serves capabilities to local MCP clients (CLI tools, integrations) on this PC over HTTP."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <ToggleSwitch x:Name="McpToggle" MinWidth="0" OnContent="" OffContent=""
                              Toggled="OnMcpToggled"
                              AutomationProperties.Name="Local MCP Server"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Name="McpDetailsPanel" Visibility="Collapsed">
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="PermissionsPage_McpEndpointLabel" Text="Endpoint:"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Name="McpEndpointText" IsTextSelectionEnabled="True"
                               FontFamily="Consolas" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </toolkit:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="CopyMcpTokenButton" x:Name="CopyMcpTokenButton" Content="Copy token" Click="OnCopyMcpToken"/>
                    <Button x:Uid="CopyMcpUrlButton" x:Name="CopyMcpUrlButton" Content="Copy URL" Click="OnCopyMcpUrl"/>
                </StackPanel>
            </toolkit:SettingsCard>
            </StackPanel>
            </Border>
            <TextBlock x:Name="McpStatusText" Margin="4,4,4,0" Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- ═════════ Exec Policy ═════════ -->
            <TextBlock x:Uid="PermissionsPage_TextBlock_14" Text="Exec policy" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>
            <TextBlock x:Uid="PermissionsPage_TextBlock_17"
                       Text="Controls which executables the agent can launch on this node. The executable-path allowlist starts empty."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Margin="4,0,4,4"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    presentation:SettingsCardGroup.IsEnabled="True">
            <StackPanel>
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="PermissionsPage_DefaultAction" x:Name="DefaultActionLabel" Text="Default action"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="PermissionsPage_WhatHappensWhenA" Text="What happens when a command doesn't match the executable-path allowlist below."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <ComboBox x:Name="DefaultActionCombo"
                          MinWidth="140"
                          SelectionChanged="OnDefaultActionChanged"
                          AutomationProperties.LabeledBy="{Binding ElementName=DefaultActionLabel}">
                    <ComboBoxItem x:Uid="PermissionsPage_ComboBoxItem_23" Content="Deny" Tag="deny"/>
                    <ComboBoxItem x:Uid="PermissionsPage_ComboBoxItem_24" Content="Allow" Tag="allow"/>
                    <ComboBoxItem x:Uid="PermissionsPage_ComboBoxItem_25" Content="Ask" Tag="prompt"/>
                </ComboBox>
            </toolkit:SettingsCard>

            <!-- Executable-path allowlist: heading row, entries, then the add row -->
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="PermissionsPage_TextBlock_28" Text="Executable-path allowlist"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="PermissionsPage_PatternsAreMatchedLeft" Text="Allow Always creates an argument-bound entry for an eligible native .exe command. Entries added here are path-only and can allow matching executables with any arguments. Deny and Ask remain controlled by Default action. Changes save automatically."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="PermissionsPage_Saved" x:Name="ExecPolicySavedHint"
                               Text="Saved"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                               Visibility="Collapsed"/>
                    <Border Background="{ThemeResource UsageCountPillBrush}"
                            CornerRadius="10" Padding="8,2" MinWidth="24"
                            VerticalAlignment="Center">
                        <TextBlock x:Uid="PermissionsPage_0Rules" x:Name="RulesCountBadge" Text="0 entries"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </toolkit:SettingsCard>

            <!-- A group row: the entries share the exec policy frame instead of drawing their own. -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    presentation:SettingsCardGroup.IsRow="True">
                <StackPanel>
                    <!-- Empty state — visible when there are no allowlist entries -->
                    <TextBlock x:Uid="PermissionsPage_NoRulesYetAdd" x:Name="RulesEmptyState"
                              Text="No executable-path allowlist entries. Approve an eligible native .exe command with Allow Always, or add a path-only pattern such as **/hostname.exe."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="16,20,16,20"
                               Visibility="Collapsed"/>

                    <!-- Allowlist entries -->
                    <ListView x:Name="PolicyRulesList" SelectionMode="None"
                              MaxHeight="320"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,8,12,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                               FontFamily="Consolas" FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1"
                                            CornerRadius="10" Padding="10,2"
                                            MinWidth="56"
                                            VerticalAlignment="Center"
                                            Background="{Binding ActionBrush}">
                                        <TextBlock Text="{Binding Action}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            Click="OnRemoveRule" Tag="{Binding Rule}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="6" MinWidth="0"
                                            AutomationProperties.Name="{Binding RemoveRuleAutomationName}"
                                            AutomationProperties.AutomationId="{Binding RemoveRuleAutomationId}"
                                            ToolTipService.ToolTip="Remove allowlist entry">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Add allowlist entry row -->
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <StackPanel Spacing="4">
                        <TextBox x:Uid="NewRulePattern" x:Name="NewRulePattern"
                                 PlaceholderText="Executable-path pattern (e.g. **/hostname.exe)"
                                 FontFamily="Consolas"
                                 AutomationProperties.AutomationId="NewExecAllowlistPatternTextBox"/>
                        <TextBlock x:Uid="PermissionsPage_ExecAllowlistPatternValidation"
                                   x:Name="ExecAllowlistPatternValidation"
                                   Text="Enter an executable-path pattern such as **/hostname.exe. Basename or command-text patterns such as hostname are invalid."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.AutomationId="ExecAllowlistPatternValidation"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <Button x:Uid="PermissionsPage_Button_57" Content="Add entry"
                        Click="OnAddRule"
                        AutomationProperties.AutomationId="AddExecAllowlistPatternButton"/>
            </toolkit:SettingsCard>
            </StackPanel>
            </Border>

            <!-- ═════════ Node Allowlist (gateway-side, read-only) ═════════ -->
            <TextBlock x:Uid="PermissionsPage_TextBlock_69" Text="Node allowlist" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>
            <TextBlock x:Uid="PermissionsPage_TextBlock_72"
                       Text="Commands the gateway will accept from connected nodes. Read-only: edit via the Config page."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Margin="4,0,4,4"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AllowlistEmpty" x:Name="AllowlistEmpty"
                               Text="No allowlist data available. Connect to a gateway first."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <ItemsRepeater x:Name="AllowlistRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ═════════ Windows-level privacy ═════════ -->
            <TextBlock x:Uid="PermissionsPage_WindowsPrivacy" Text="Windows privacy" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>

            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <TextBlock x:Uid="PermissionsPage_CameraMicrophoneAmpScreen" Text="Camera, microphone &amp; screen access"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Uid="PermissionsPage_SystemLevelPrivacyPermissions" Text="System-level privacy permissions are managed by Windows. Open Windows Privacy Settings to grant or revoke OpenClaw access."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <Button x:Uid="PermissionsPage_Button_123" Content="Open Windows privacy settings" Click="OnOpenPrivacySettings"/>
            </toolkit:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
