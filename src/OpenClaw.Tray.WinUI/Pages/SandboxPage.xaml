<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenClawTray.Pages.SandboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OpenClawTray.Presentation"
    xmlns:helpers="using:OpenClawTray.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <!-- Reserved width for a field hosted in a SettingsCard; the card wraps it below its header when narrow. -->
        <x:Double x:Key="SettingsFieldMinWidth">240</x:Double>
        <Thickness x:Key="SectionHeaderMargin">4,18,4,4</Thickness>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel presentation:PageContentLayout.IsEnabled="True" Spacing="4">

            <Grid x:Name="SandboxStatusCard" ColumnSpacing="16" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SandboxStatusIcon"
                           Grid.Column="1"
                           Text="🛡"
                           FontSize="28"
                           AutomationProperties.AccessibilityView="Raw"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top">
                    <TextBlock x:Uid="SandboxPage_Title" x:Name="SandboxStatusTitle"
                               Text="Node Sandbox"
                               AutomationProperties.AutomationId="SandboxPageMarker"
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Uid="SandboxPage_ProgramsTheAgentRuns" x:Name="SandboxStatusSubtext"
                               Text="Programs the agent runs on this PC are contained."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

            </Grid>

            <InfoBar x:Name="UploadCleanupWarning" x:Uid="SandboxPage_UploadCleanupWarning"
                     Severity="Warning" IsOpen="False" IsClosable="False" />

            <toolkit:SettingsExpander x:Uid="SandboxPage_WhatGetsContained" x:Name="ScopeExpander"
                                      Header="What gets contained"
                                      AutomationProperties.AutomationId="ScopeExpander"
                                      IsExpanded="False">
                <toolkit:SettingsExpander.Description>
                    <TextBlock x:Uid="SandboxPage_SeeWhichCommandsThis" Text="See which commands this page covers and which need different controls."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </toolkit:SettingsExpander.Description>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE73E;"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.Header>
                            <TextBlock AutomationProperties.AutomationId="SandboxContainedOperations" TextWrapping="Wrap">
                                <Run x:Uid="SandboxPage_CommandsTheAgentRuns" Text="Commands the agent runs through the Windows node (" />
                                <Run x:Uid="SandboxPage_SystemRun" Text="system.run" FontFamily="Consolas" />
                                <Run x:Uid="SandboxPage_AreContainedByThe" Text=") and file actions use the Sandbox settings below." />
                            </TextBlock>
                        </toolkit:SettingsCard.Header>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE711;"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.Header>
                            <TextBlock x:Uid="SandboxPage_GatewayCommandsNote"
                                       Text="Commands the agent runs directly on the gateway aren't. If the gateway is on this PC they may still be able to reach your Windows files, clipboard, and network: check your gateway's configuration."
                                       TextWrapping="Wrap" />
                        </toolkit:SettingsCard.Header>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- Prominent error + fix action when MXC sandboxing is unavailable -->
            <InfoBar x:Uid="SandboxPage_SandboxUnavailable" x:Name="UnavailableActionBar"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Error"
                     Title="Sandbox unavailable">
                <InfoBar.Content>
                    <StackPanel Spacing="8" Margin="0,4,0,12">
                        <TextBlock x:Name="UnavailableActionMessage" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="SandboxPage_UnavailablePrimaryButton" x:Name="UnavailablePrimaryButton"
                                    Click="OnUnavailableActionClick" Style="{ThemeResource AccentButtonStyle}" />
                            <HyperlinkButton x:Uid="SandboxPage_LearnMoreAboutMXC" Content="Learn more about MXC sandboxing"
                                             NavigateUri="https://github.com/microsoft/mxc" />
                        </StackPanel>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <StackPanel x:Name="PresetCard" Spacing="4">
                    <TextBlock x:Uid="SandboxPage_SecurityLevel" Text="Security level"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="{StaticResource SectionHeaderMargin}" />
                    <TextBlock x:Uid="SandboxPage_PresetHelp" Text="Presets replace file grants and internet access. Clipboard, limits and command approvals stay independent."
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,0,4,4" />
                    <Grid ColumnSpacing="12" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Uid="SandboxPage_PresetLockedButton" x:Name="PresetLockedButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                Padding="20,18"
                                MinHeight="130"
                                CornerRadius="8"
                                Click="OnPresetLockedClick">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="PresetStrictIcon"
                                              Glyph="{x:Bind helpers:FluentIconCatalog.SandboxStrict, Mode=OneTime}"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="16" IsTextScaleFactorEnabled="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:Uid="SandboxPage_PresetStrict" Grid.Column="1" Text="Strict"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Uid="SandboxPage_PresetStrictText" Text="Keep the agent on a short leash."
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Uid="SandboxPage_PresetBalancedButton" x:Name="PresetBalancedButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                Padding="20,18"
                                MinHeight="130"
                                CornerRadius="8"
                                Click="OnPresetBalancedClick">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="PresetBalancedIcon"
                                              Glyph="{x:Bind helpers:FluentIconCatalog.Permissions, Mode=OneTime}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="16" IsTextScaleFactorEnabled="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:Uid="SandboxPage_PresetBalanced" Grid.Column="1" Text="Balanced"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Uid="SandboxPage_PresetBalancedText" Text="Help with everyday tasks, with fewer risks."
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Uid="SandboxPage_PresetPermissiveButton" x:Name="PresetPermissiveButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                Padding="20,18"
                                MinHeight="130"
                                CornerRadius="8"
                                Click="OnPresetPermissiveClick">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="PresetOpenIcon"
                                              Glyph="{x:Bind helpers:FluentIconCatalog.StatusWarn, Mode=OneTime}"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="16" IsTextScaleFactorEnabled="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:Uid="SandboxPage_PresetOpen" Grid.Column="1" Text="Open"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Uid="SandboxPage_PresetOpenText" Text="Give the agent more freedom to get things done."
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Uid="SandboxPage_CustomPreset" x:Name="CustomPresetLabel"
                               Text="Custom permissions" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="4,12,4,0" />

                    <!-- Retained legacy grants can require explicit review. -->
                    <InfoBar x:Uid="SandboxPage_CustomFolderGrantsStill" x:Name="PresetCustomFoldersWarning"
                             IsOpen="False"
                             IsClosable="True"
                             Severity="Warning"
                             Title="Custom folder grants still active"
                             Margin="0,4,0,0" />
            </StackPanel>

            <!-- Only confirmed unsupported Windows disables saved sandbox controls. -->
            <ContentControl x:Name="SandboxPermissionsControls" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="SandboxControlsContainer" Spacing="4">
                <StackPanel Spacing="4" AutomationProperties.AutomationId="SandboxFoldersExpander">
                    <TextBlock x:Uid="SandboxPage_FolderList" x:Name="FoldersExpanderLabel" Text="Folders"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="{StaticResource SectionHeaderMargin}"/>
                    <toolkit:SettingsCard AutomationProperties.AutomationId="SandboxAddFolderCard">
                        <toolkit:SettingsCard.Header>
                            <TextBlock x:Uid="SandboxPage_AddFolderTitle" Text="Add a new folder" />
                        </toolkit:SettingsCard.Header>
                        <toolkit:SettingsCard.Description>
                            <TextBlock x:Uid="SandboxPage_FolderListHelp"
                                       Text="Choose what the agent can do in each folder; explicitly listed subfolders keep their own access."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </toolkit:SettingsCard.Description>
                        <Button x:Uid="SandboxPage_AddFolder" Content="Add folder"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnAddCustomFolder"
                                AutomationProperties.AutomationId="SandboxAddFolderButton" />
                    </toolkit:SettingsCard>
                    <TextBlock x:Name="FolderStatus" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,0,4,4" />
                    <ListView x:Name="CustomFoldersList"
                              SelectionMode="None"
                              HorizontalContentAlignment="Stretch"
                              Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter HorizontalContentAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <toolkit:SettingsCard>
                                    <toolkit:SettingsCard.Header>
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   TextWrapping="Wrap"
                                                   ToolTipService.ToolTip="{Binding DisplayPath}" />
                                    </toolkit:SettingsCard.Header>
                                    <toolkit:SettingsCard.Description>
                                        <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}"
                                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </toolkit:SettingsCard.Description>
                                    <ComboBox x:Uid="SandboxPage_FolderAccess"
                                              MinWidth="150"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding CanEdit}"
                                              Loaded="OnFolderAccessLoaded"
                                              DataContextChanged="OnFolderAccessDataContextChanged"
                                              AutomationProperties.Name="{Binding AccessLabel}"
                                              SelectionChanged="OnCustomFolderAccessChanged">
                                        <ComboBoxItem x:Uid="SandboxPage_NoAccess" Content="No access" />
                                        <ComboBoxItem x:Uid="SandboxPage_ReadOnly4" Content="Read only" />
                                        <ComboBoxItem x:Uid="SandboxPage_ReadAmpWrite4" Content="Read &amp; write" />
                                    </ComboBox>
                                </toolkit:SettingsCard>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Uid="SandboxPage_NoCustomFoldersAdded" x:Name="CustomFoldersEmpty"
                               Text="No personal folders shared. Add a folder to get started."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,0,4,0" />
                    <TextBlock x:Uid="SandboxPage_ToolDirectoriesOnYour" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,4,4,0"
                               Text="Protected folders stay blocked. Windows runtime folders stay available; being on PATH grants no access." />
                </StackPanel>

                <!-- Clipboard -->
                <StackPanel Spacing="4" AutomationProperties.AutomationId="SandboxClipboardExpander">
                    <TextBlock x:Uid="SandboxPage_Clipboard" x:Name="ClipboardExpanderLabel" Text="Clipboard"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="{StaticResource SectionHeaderMargin}"/>
                    <toolkit:SettingsCard>
                        <toolkit:SettingsCard.Header>
                            <TextBlock x:Uid="SandboxPage_ClipboardAccess" x:Name="ClipboardAccessLabel" Text="Clipboard access" />
                        </toolkit:SettingsCard.Header>
                        <toolkit:SettingsCard.Description>
                            <TextBlock x:Uid="SandboxPage_ClipboardOftenContainsPasswords"
                                       Text="Clipboard often holds passwords and private text. Read access exposes it to the agent."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </toolkit:SettingsCard.Description>
                        <ComboBox x:Name="ClipboardCombo"
                                  AutomationProperties.AutomationId="SandboxClipboardAccess"
                                  MinWidth="{StaticResource SettingsFieldMinWidth}" HorizontalAlignment="Left"
                                  AutomationProperties.LabeledBy="{Binding ElementName=ClipboardAccessLabel}"
                                  SelectionChanged="OnClipboardChanged">
                            <ComboBoxItem x:Uid="SandboxPage_NoneDefault" Content="None (default)" Tag="None" />
                            <ComboBoxItem x:Uid="SandboxPage_ReadAgentCanSee" Content="Read: agent can see what you copied" Tag="Read" />
                            <ComboBoxItem x:Uid="SandboxPage_WriteAgentCanReplace" Content="Write: agent can replace your clipboard (cannot read it)" Tag="Write" />
                            <ComboBoxItem x:Uid="SandboxPage_ReadAmpWrite5" Content="Read &amp; write" Tag="Both" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- Network -->
                <StackPanel Spacing="4" AutomationProperties.AutomationId="SandboxNetworkExpander">
                    <TextBlock x:Uid="SandboxPage_Network" x:Name="NetworkExpanderLabel" Text="Network"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="{StaticResource SectionHeaderMargin}"/>
                    <toolkit:SettingsCard x:Name="NetInternetCard" x:Uid="SandboxPage_AllowInternet"
                                          Header="Allow internet">
                        <toolkit:SettingsCard.Description>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="SandboxPage_IfFileOrClipboard" Text="If file or clipboard read access is enabled, the agent may send that data over the internet."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Uid="SandboxPage_LocalNetworkDevicesAnd" Text="Local network devices and shares are not included yet."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </toolkit:SettingsCard.Description>
                        <ToggleSwitch x:Name="NetInternetToggle"
                                      MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnNetInternetToggled"
                                      AutomationProperties.Name="{Binding Header, ElementName=NetInternetCard}" />
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- Limits -->
                <StackPanel Spacing="4" AutomationProperties.AutomationId="SandboxLimitsExpander">
                    <TextBlock x:Uid="SandboxPage_Limits" x:Name="LimitsExpanderLabel" Text="Limits"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="{StaticResource SectionHeaderMargin}"/>
                    <toolkit:SettingsCard>
                        <toolkit:SettingsCard.Header>
                            <TextBlock x:Uid="SandboxPage_CommandTimeout30Sec" x:Name="TimeoutLabel" Text="Command timeout: 30 sec"/>
                        </toolkit:SettingsCard.Header>
                        <Slider x:Name="TimeoutSlider" Minimum="5" Maximum="300" StepFrequency="5"
                                Value="30" SmallChange="5" LargeChange="15"
                                MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.LabeledBy="{Binding ElementName=TimeoutLabel}"
                                ValueChanged="OnTimeoutChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard>
                        <toolkit:SettingsCard.Header>
                            <TextBlock x:Uid="SandboxPage_MaximumCapturedOutputTruncates" x:Name="MaxOutputLabel" Text="Maximum captured output (truncates beyond this; does not limit disk, memory, or CPU):" TextWrapping="Wrap"/>
                        </toolkit:SettingsCard.Header>
                        <ComboBox x:Name="MaxOutputCombo"
                                  MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="300" HorizontalAlignment="Left"
                                  AutomationProperties.LabeledBy="{Binding ElementName=MaxOutputLabel}"
                                  SelectionChanged="OnMaxOutputChanged">
                            <ComboBoxItem x:Uid="SandboxPage_1MiB" Content="1 MiB" Tag="1048576" />
                            <ComboBoxItem x:Uid="SandboxPage_4MiBDefault" Content="4 MiB (default)" Tag="4194304" />
                            <ComboBoxItem x:Uid="SandboxPage_16MiB" Content="16 MiB" Tag="16777216" />
                            <ComboBoxItem x:Uid="SandboxPage_64MiB" Content="64 MiB" Tag="67108864" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                </StackPanel>

            </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</Page>
