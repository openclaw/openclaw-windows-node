            <Ellipse x:Name="Plate" Width="52" Height="52" Margin="-4,-4,0,0" HorizontalAlignment="Left"
                     VerticalAlignment="Top" StrokeThickness="2" IsHitTestVisible="False" />
            <Ellipse x:Name="FocusRing" Width="52" Height="52" Margin="-4,-4,0,0" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Stroke="{ThemeResource SystemsOrbFocusBrush}" StrokeThickness="2"
