<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Systems page palette (DESIGN.md "Systems page"). Load follows the user's accent; memory
        and disk use fixed violet and teal hues so the three metrics stay distinguishable.
        Every brush is paired with a glyph and a text label, so color is never the only signal.
        High contrast maps every hue to system colors and drops the decorative washes.
    -->
    <DataTemplate x:Key="SystemsAddDialogTitleTemplate">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource SystemsLoadTintBrush}">
                <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource SystemsLoadBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="20" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SystemsForgetDialogTitleTemplate">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource SystemsCriticalTintBrush}">
                <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="20" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>
    <Style x:Key="SystemsSpokeStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="SystemsOfflineSpokeStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="SystemsPendingSpokeStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="SystemsHaloStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <Style x:Key="SystemsSelectionRingStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="4" />
    </Style>
    <Style x:Key="SystemsOfflineHubStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <Style x:Key="SystemsNodeCircleStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Stroke" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style x:Key="SystemsOwnCircleStyle" TargetType="Ellipse" BasedOn="{StaticResource SystemsNodeCircleStyle}">
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style x:Key="SystemsOfflineCircleStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style x:Key="SystemsGhostCircleStyle" TargetType="Ellipse" BasedOn="{StaticResource SystemsOfflineCircleStyle}">
        <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style x:Key="SystemsPendingCircleStyle" TargetType="Ellipse" BasedOn="{StaticResource SystemsOwnCircleStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemsPendingTintBrush}" />
    </Style>
    <!--
        Map orb buttons. The whole circle-and-label area stays clickable, but hover, pressed and keyboard
        focus light a circular plate concentric with the glyph circle (circle diameter + the 4 px selection
        band) instead of the default rectangle. Each orb kind has its own circle size, so each has its own
        template; the plate and ring sizes below are circle diameter + 8. High contrast swaps the wash for a ring.
    -->
    <ControlTemplate x:Key="SystemsOrbNodeTemplate" TargetType="Button">
        <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Plate.Fill" Value="{ThemeResource SystemsOrbHoverBrush}" />
                            <Setter Target="Plate.Stroke" Value="{ThemeResource SystemsOrbHoverStrokeBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Plate.Fill" Value="{ThemeResource SystemsOrbPressedBrush}" />
                            <Setter Target="Plate.Stroke" Value="{ThemeResource SystemsOrbHoverStrokeBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Ellipse x:Name="Plate" Width="64" Height="64" Margin="0,-4,0,0" HorizontalAlignment="Center"
                     VerticalAlignment="Top" StrokeThickness="2" IsHitTestVisible="False" />
            <Ellipse x:Name="FocusRing" Width="64" Height="64" Margin="0,-4,0,0" HorizontalAlignment="Center"
                     VerticalAlignment="Top" Stroke="{ThemeResource SystemsOrbFocusBrush}" StrokeThickness="2"
                     Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>
