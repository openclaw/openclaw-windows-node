            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>
    <Style x:Key="SystemsOrbButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>
    <Style x:Key="SystemsOrbNodeStyle" TargetType="Button" BasedOn="{StaticResource SystemsOrbButtonStyle}">
        <Setter Property="Template" Value="{StaticResource SystemsOrbNodeTemplate}" />
    </Style>
    <Style x:Key="SystemsOrbHubStyle" TargetType="Button" BasedOn="{StaticResource SystemsOrbButtonStyle}">
        <Setter Property="Template" Value="{StaticResource SystemsOrbHubTemplate}" />
    </Style>
    <Style x:Key="SystemsOrbCountStyle" TargetType="Button" BasedOn="{StaticResource SystemsOrbButtonStyle}">
        <Setter Property="Template" Value="{StaticResource SystemsOrbCountTemplate}" />
    </Style>
    <Style x:Key="SystemsOrbSideStyle" TargetType="Button" BasedOn="{StaticResource SystemsOrbButtonStyle}">
        <Setter Property="Template" Value="{StaticResource SystemsOrbSideTemplate}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SystemsPendingTintBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsLoadBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="SystemsOrbHoverBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.16" />
            <SolidColorBrush x:Key="SystemsOrbPressedBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.28" />
            <SolidColorBrush x:Key="SystemsOrbHoverStrokeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemsOrbFocusBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="SystemsMemoryBrush" Color="#B9A4FF" />
            <SolidColorBrush x:Key="SystemsDiskBrush" Color="#5FD4D9" />
            <SolidColorBrush x:Key="SystemsNeutralBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="SystemsLoadTintBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.16" />
            <SolidColorBrush x:Key="SystemsMemoryTintBrush" Color="#B9A4FF" Opacity="0.16" />
            <SolidColorBrush x:Key="SystemsDiskTintBrush" Color="#5FD4D9" Opacity="0.16" />
            <SolidColorBrush x:Key="SystemsNeutralTintBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SystemsSuccessTintBrush" Color="{ThemeResource SystemFillColorSuccess}" Opacity="0.16" />
            <SolidColorBrush x:Key="SystemsCautionTintBrush" Color="{ThemeResource SystemFillColorCaution}" Opacity="0.16" />
            <SolidColorBrush x:Key="SystemsCriticalTintBrush" Color="{ThemeResource SystemFillColorCritical}" Opacity="0.16" />
            <SolidColorBrush x:Key="SystemsMeterTrackBrush" Color="{ThemeResource ControlStrongFillColorDisabled}" Opacity="0.35" />
            <LinearGradientBrush x:Key="SystemsHeroBrush" StartPoint="0,0" EndPoint="0,1" Opacity="0.10">
                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}" />
                <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SystemsPendingTintBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsLoadBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="SystemsOrbHoverBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsOrbPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.20" />
            <SolidColorBrush x:Key="SystemsOrbHoverStrokeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemsOrbFocusBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="SystemsMemoryBrush" Color="#6B4FBB" />
            <SolidColorBrush x:Key="SystemsDiskBrush" Color="#00747A" />
            <SolidColorBrush x:Key="SystemsNeutralBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="SystemsLoadTintBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsMemoryTintBrush" Color="#6B4FBB" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsDiskTintBrush" Color="#00747A" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsNeutralTintBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SystemsSuccessTintBrush" Color="{ThemeResource SystemFillColorSuccess}" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsCautionTintBrush" Color="{ThemeResource SystemFillColorCaution}" Opacity="0.12" />
            <SolidColorBrush x:Key="SystemsCriticalTintBrush" Color="{ThemeResource SystemFillColorCritical}" Opacity="0.10" />
            <SolidColorBrush x:Key="SystemsMeterTrackBrush" Color="{ThemeResource ControlStrongFillColorDisabled}" Opacity="0.25" />
            <LinearGradientBrush x:Key="SystemsHeroBrush" StartPoint="0,0" EndPoint="0,1" Opacity="0.08">
                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight1}" />
                <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SystemsPendingTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsLoadBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemsOrbHoverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemsOrbPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemsOrbHoverStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemsOrbFocusBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemsMemoryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemsDiskBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemsNeutralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemsLoadTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsMemoryTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsDiskTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsNeutralTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsSuccessTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsCautionTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsCriticalTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemsMeterTrackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemsHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
