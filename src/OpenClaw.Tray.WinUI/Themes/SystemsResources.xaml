                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Ellipse x:Name="Plate" Width="80" Height="80" Margin="0,-4,0,0" HorizontalAlignment="Center"
                     VerticalAlignment="Top" StrokeThickness="2" IsHitTestVisible="False" />
            <Ellipse x:Name="FocusRing" Width="80" Height="80" Margin="0,-4,0,0" HorizontalAlignment="Center"
