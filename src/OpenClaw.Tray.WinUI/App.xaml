<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OpenClawTray.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenClawTray">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/ChatResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Setup-only indicator brushes. They must live at App scope (not just in
                 SetupWindow's element resources) because the setup pages resolve them via
                 {ThemeResource} at page-load, before they attach to the setup window's
                 resource scope. They alias NATIVE system resources — the active indicator
                 follows the user's Windows accent, the inactive dot is a native neutral —
                 so onboarding showcases the user's chosen system colors. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SetupIndicatorAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SetupInactiveDotBrush" Color="{ThemeResource ControlStrongFillColorDefault}" />

                    <!-- FunctionalUI resolves a brush for a target ElementTheme by walking the
                         app-level ThemeDictionaries; the framework's XamlControlsResources
                         brushes are not surfaced through that enumerable walk, so a control
                         rendering dark kept the light snapshot (the composer read as light on
                         a dark page). Re-declaring the exact framework keys here materializes
                         them per theme with identical values (each aliases its built-in color
                         token), so the walk flips them correctly. No hardcoded colors. -->
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource ControlFillColorDefault}" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillSuccessBrush" Color="{ThemeResource SystemFillColorSuccess}" Opacity="0.14" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillCautionBrush" Color="{ThemeResource SystemFillColorCaution}" Opacity="0.14" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillCriticalBrush" Color="{ThemeResource SystemFillColorCritical}" Opacity="0.14" />
                    <!-- Usage chart cache-read series: the accent shade opposite the accent fill, so stacks stay distinguishable. -->
                    <SolidColorBrush x:Key="UsageChartCacheReadBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <!-- Usage page categorical palette (DESIGN.md usagePalette1-6): fills and 16% tints. -->
                    <SolidColorBrush x:Key="UsagePalette1Brush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="UsageActivityTextBrush" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <x:Double x:Key="UsageActivityMinimumOpacity">0.18</x:Double>
                    <SolidColorBrush x:Key="UsagePalette1TintBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette2Brush" Color="#4FC3C7" />
                    <SolidColorBrush x:Key="UsagePalette2TintBrush" Color="#4FC3C7" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette3Brush" Color="#B4A0FF" />
                    <SolidColorBrush x:Key="UsagePalette3TintBrush" Color="#B4A0FF" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette4Brush" Color="#F7894A" />
                    <SolidColorBrush x:Key="UsagePalette4TintBrush" Color="#F7894A" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette5Brush" Color="#EE7AE3" />
                    <SolidColorBrush x:Key="UsagePalette5TintBrush" Color="#EE7AE3" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette6Brush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="UsagePalette6TintBrush" Color="#6CCB5F" Opacity="0.16" />
                    <x:Boolean x:Key="HubNavigationUseHighContrastIcons">False</x:Boolean>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SetupIndicatorAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="SetupInactiveDotBrush" Color="{ThemeResource ControlStrongFillColorDefault}" />

                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource ControlFillColorDefault}" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillSuccessBrush" Color="{ThemeResource SystemFillColorSuccess}" Opacity="0.14" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillCautionBrush" Color="{ThemeResource SystemFillColorCaution}" Opacity="0.14" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillCriticalBrush" Color="{ThemeResource SystemFillColorCritical}" Opacity="0.14" />
                    <SolidColorBrush x:Key="UsageChartCacheReadBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <!-- Usage page categorical palette (DESIGN.md usagePalette1-6): fills and 16% tints. -->
                    <SolidColorBrush x:Key="UsagePalette1Brush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="UsageActivityTextBrush" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                    <x:Double x:Key="UsageActivityMinimumOpacity">0.18</x:Double>
                    <SolidColorBrush x:Key="UsagePalette1TintBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette2Brush" Color="#038387" />
                    <SolidColorBrush x:Key="UsagePalette2TintBrush" Color="#038387" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette3Brush" Color="#8764B8" />
                    <SolidColorBrush x:Key="UsagePalette3TintBrush" Color="#8764B8" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette4Brush" Color="#CA5010" />
                    <SolidColorBrush x:Key="UsagePalette4TintBrush" Color="#CA5010" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette5Brush" Color="#C239B3" />
                    <SolidColorBrush x:Key="UsagePalette5TintBrush" Color="#C239B3" Opacity="0.16" />
                    <SolidColorBrush x:Key="UsagePalette6Brush" Color="#107C10" />
                    <SolidColorBrush x:Key="UsagePalette6TintBrush" Color="#107C10" Opacity="0.16" />
                    <x:Boolean x:Key="HubNavigationUseHighContrastIcons">False</x:Boolean>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SetupIndicatorAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SetupInactiveDotBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillSuccessBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillCautionBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ConnectionCapabilityPillCriticalBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="UsageChartCacheReadBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <!-- Usage page categorical palette (DESIGN.md usagePalette1-6): fills and 16% tints. -->
                    <SolidColorBrush x:Key="UsagePalette1Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="UsageActivityTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <x:Double x:Key="UsageActivityMinimumOpacity">1</x:Double>
                    <SolidColorBrush x:Key="UsagePalette1TintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="UsagePalette2Brush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="UsagePalette2TintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="UsagePalette3Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UsagePalette3TintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="UsagePalette4Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="UsagePalette4TintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="UsagePalette5Brush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="UsagePalette5TintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="UsagePalette6Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UsagePalette6TintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <x:Boolean x:Key="HubNavigationUseHighContrastIcons">True</x:Boolean>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Hub NavigationView selection indicator follows the user's Windows accent. -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                             Color="{ThemeResource SystemAccentColor}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
