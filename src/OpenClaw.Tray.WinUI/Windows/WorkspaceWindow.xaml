<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="OpenClawTray.Windows.WorkspaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClawTray.Controls"
    xmlns:winex="using:WinUIEx"
    MinWidth="800" MinHeight="560">
    <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
    <Grid x:Name="Root" PreviewKeyDown="OnKeyDown" KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <DataTemplate x:Key="AgentIdentityTemplate">
                <controls:AgentIdentityBadge/>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="WorkspaceTitleBar" Title="OpenClaw" AutomationProperties.AutomationId="WorkspaceTitleBar">
            <TitleBar.Resources>
                <!-- TitleBar switches to its 48 DIP expanded height whenever RightHeader is set, even
                     while that content is collapsed. Keep the compact 32 DIP chrome in every state. -->
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
            </TitleBar.Resources>
            <TitleBar.RightHeader>
                <!-- Shown only while the Chat pane is hidden, so Dashboard and the bell stay one click away. -->
                <controls:WorkspacePaneFooter x:Name="TitleBarFooter" AutomationIdPrefix="WorkspaceTitleBar"
                                              Visibility="Collapsed" Margin="0,0,4,0" VerticalAlignment="Center"/>
            </TitleBar.RightHeader>
        </TitleBar>
        <Grid x:Name="NavigationSection" Grid.Row="1">
        <NavigationView x:Name="NavView"
                        AutomationProperties.AutomationId="WorkspaceNavigation"
                        PaneDisplayMode="Left" OpenPaneLength="256" CompactPaneLength="0"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" IsPaneOpen="True"
                        PaneClosed="OnPaneClosed"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.Resources>
                <x:String x:Key="SplitViewPaneAnimationOpenDuration">00:00:00.16</x:String>
                <x:String x:Key="SplitViewPaneAnimationOpenPreDuration">00:00:00.15999</x:String>
                <x:String x:Key="SplitViewPaneAnimationCloseDuration">00:00:00.16</x:String>
                <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="NavigationViewExpandedPaneBackground"/>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewPaneContentGridMargin">0</Thickness>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">22</x:Double>
                <Thickness x:Key="NavigationViewItemSeparatorMargin">0,2,0,2</Thickness>
                <SvgImageSource x:Key="Chat_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Chat.svg"/>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel Margin="4,8,4,8" Spacing="8">
                    <Grid x:Name="NavigationToolbar" Height="40">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="BackButton" x:Uid="NavBackButton" Click="OnBack"
                                    Height="40"
                                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspaceBack"
                                    IsEnabled="False">
                                <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                            </Button>
                            <Button x:Name="ForwardButton" x:Uid="WorkspaceShell_Forward" Click="OnForward"
                                    Height="40"
                                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspaceForward"
                                    IsEnabled="False">
                                <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                            </Button>
                            <Button x:Name="WorkspaceSearchButton" Height="40"
                                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspaceSearch">
                                <FontIcon Glyph="&#xE721;" FontSize="16"/>
                                <Button.Flyout>
                                    <Flyout x:Name="WorkspaceSearchFlyout" Placement="BottomEdgeAlignedLeft"
                                            Opening="OnWorkspaceSearchOpening" Opened="OnWorkspaceSearchOpened"
                                            Closed="OnWorkspaceSearchClosed">
                                        <controls:SearchHost x:Name="WorkspaceSearchHost"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ComboBox x:Name="AssistantSelector" x:Uid="WorkspaceShell_Assistant"
                              Padding="4,8,28,8"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" SelectionChanged="OnAssistantChanged"
                              Background="Transparent" BorderThickness="0" CornerRadius="{ThemeResource ControlCornerRadius}"
                              AutomationProperties.AutomationId="WorkspaceAssistantSelector">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent"/>
                            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                        </ComboBox.Resources>
                        <ComboBoxItem x:Name="NewAgentOption" Padding="2,8,12,8" Margin="-5,0,0,0"
                                      AutomationProperties.AutomationId="WorkspaceNewAgent">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                <TextBlock x:Name="NewAgentLabel"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Tag="home" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="WorkspaceNavHome">
                    <NavigationViewItem.Resources>
                        <!-- Cancel the native presenter's 14-DIP trailing gutter for this inline action.
                             This keeps its right edge aligned with Sessions + without replacing the template. -->
                        <Thickness x:Key="NavigationViewItemContentPresenterMargin">0,-1,-14,-1</Thickness>
                    </NavigationViewItem.Resources>
                    <!-- The native iconless presenter already reserves an 8-DIP leading column. -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <ImageIcon x:Name="HomeIcon" Source="{StaticResource Chat_Icon}" Width="22" Height="22"
                                       AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                        <TextBlock x:Name="HomeLabel" Grid.Column="1" VerticalAlignment="Center"/>
                        <Button x:Name="PagesCustomizeButton" x:Uid="WorkspaceShell_PagesCustomize" Grid.Column="2"
                                Width="40" Height="{ThemeResource NavigationViewItemOnLeftMinHeight}"
                                Padding="0"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspacePagesCustomize">
                            <Viewbox Width="12" Height="12">
                                <SymbolIcon Symbol="Edit" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            AutomationProperties.AccessibilityView="Raw"/>
                            </Viewbox>
                            <Button.Flyout>
                                <MenuFlyout x:Name="PagesFlyout" Placement="BottomEdgeAlignedRight" Opening="OnPagesFlyoutOpening" Closed="OnPagesFlyoutClosed"/>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItemSeparator x:Name="SessionsSeparator" AutomationProperties.AutomationId="WorkspaceSessionsSeparator"/>
                <NavigationViewItemHeader x:Name="SessionsHeader" IsEnabled="True">
                    <NavigationViewItemHeader.Resources>
                        <Thickness x:Key="NavigationViewItemInnerHeaderMargin">16,0,4,0</Thickness>
                    </NavigationViewItemHeader.Resources>
                    <NavigationViewItemHeader.Template>
                        <ControlTemplate TargetType="NavigationViewItemHeader">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="PaneStates">
                                        <VisualState x:Name="HeaderTextVisible"/>
                                        <VisualState x:Name="HeaderTextCollapsed">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderContent.Visibility" Value="Collapsed"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="HeaderContent" Content="{TemplateBinding Content}"
                                                  Height="40" HorizontalContentAlignment="Stretch"
                                                  Margin="{ThemeResource NavigationViewItemInnerHeaderMargin}"/>
                            </Grid>
                        </ControlTemplate>
                    </NavigationViewItemHeader.Template>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="WorkspaceShell_SessionsLabel" Text="Sessions" VerticalAlignment="Center"
                                   Style="{StaticResource NavigationViewItemHeaderTextStyle}"/>
                        <Button x:Name="NewSessionButton" x:Uid="WorkspaceShell_NewConversation" Grid.Column="1" Click="OnNewConversation"
                                Width="40" Height="{ThemeResource NavigationViewItemOnLeftMinHeight}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspaceSessionsAdd">
                            <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        </Button>
                    </Grid>
                </NavigationViewItemHeader>
                <NavigationViewItemHeader x:Name="SessionsEmpty" FontWeight="Normal"/>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <controls:WorkspacePaneFooter x:Name="ChatFooter" AutomationIdPrefix="Workspace"/>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="ReopenPaneSlot" Height="56" Visibility="Collapsed"/>
                <InfoBar x:Name="OperationInfo" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error"
                         AutomationProperties.AutomationId="WorkspaceOperationFeedback"/>
                <Grid x:Name="ContentHost" Grid.Row="2" AutomationProperties.AutomationId="WorkspaceContent"/>
            </Grid>
        </NavigationView>
        </Grid>
        <Grid x:Name="SettingsSection" Grid.Row="1" Visibility="Collapsed"
              AutomationProperties.AutomationId="WorkspaceSettingsHost">
            <Border x:Name="EmbeddedPageBackground" Canvas.ZIndex="-1" Visibility="Collapsed"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False"/>
            <InfoBar x:Name="EmbeddedOperationInfo" Canvas.ZIndex="1" IsOpen="False" IsClosable="True"
                     Severity="Error" VerticalAlignment="Top" Closed="OnEmbeddedOperationClosed"
                     AutomationProperties.AutomationId="WorkspaceEmbeddedOperationFeedback"/>
        </Grid>
        <!-- Keep only the pane buttons above full-frame embedded pages, not the Chat surface. -->
        <Grid x:Name="PaneToggleChrome" Grid.Row="1" TabIndex="0"
              Visibility="{Binding Visibility, ElementName=NavigationSection}"
              HorizontalAlignment="Left" VerticalAlignment="Top" Width="48" Height="56">
            <Button x:Name="CollapsePaneButton" x:Uid="WorkspaceShell_TogglePane" Click="OnTogglePane"
                    AutomationProperties.AutomationId="WorkspaceTogglePane"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,8,0,0"
                    Width="40" Height="40" Padding="0" Style="{StaticResource SubtleButtonStyle}">
                <FontIcon Glyph="&#xE90C;" FontSize="16"/>
            </Button>
            <Button x:Name="ReopenPaneButton" x:Uid="WorkspaceShell_TogglePane" Click="OnTogglePane"
                    AutomationProperties.AutomationId="WorkspaceReopenPane"
                    Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,8,0,0"
                    Width="40" Height="40" Padding="0" Style="{StaticResource SubtleButtonStyle}">
                <FontIcon Glyph="&#xE90C;" FontSize="16"/>
            </Button>
        </Grid>
        <StackPanel x:Name="SettingsHistoryBar" Grid.Row="1" TabIndex="1" Orientation="Horizontal" Spacing="4"
                    Margin="48,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
            <Button x:Name="SettingsBackButton" x:Uid="NavBackButton" Click="OnBack"
                    Width="40" Height="40" Padding="0"
                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="SettingsBack"
                    IsEnabled="False">
                <FontIcon Glyph="&#xE76B;" FontSize="16"/>
            </Button>
            <Button x:Name="SettingsForwardButton" x:Uid="WorkspaceShell_Forward" Click="OnForward"
                    Width="40" Height="40" Padding="0"
                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="SettingsForward"
                    IsEnabled="False">
                <FontIcon Glyph="&#xE76C;" FontSize="16"/>
            </Button>
        </StackPanel>
    </Grid>
</winex:WindowEx>
