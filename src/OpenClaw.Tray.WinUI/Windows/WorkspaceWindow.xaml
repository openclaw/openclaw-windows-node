<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="OpenClawTray.Windows.WorkspaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    MinWidth="800" MinHeight="560">
    <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
    <Grid x:Name="Root" PreviewKeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="WorkspaceTitleBar" Title="OpenClaw" AutomationProperties.AutomationId="WorkspaceTitleBar"/>
        <Grid x:Name="NavigationSection" Grid.Row="1">
        <NavigationView x:Name="NavView"
                        AutomationProperties.AutomationId="WorkspaceNavigation"
                        PaneDisplayMode="Left" OpenPaneLength="256"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" IsPaneOpen="True"
                        SelectionChanged="OnNavigationChanged" ItemInvoked="OnNavigationInvoked">
            <NavigationView.Resources>
                <Style x:Key="WorkspaceCompactAction" TargetType="NavigationViewItem">
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="SelectsOnInvoked" Value="False"/>
                    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="NavigationViewItem">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">22</x:Double>
                <Thickness x:Key="NavigationViewItemSeparatorMargin">0,2,0,2</Thickness>
                <SvgImageSource x:Key="Chat_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Chat.svg"/>
                <SvgImageSource x:Key="Agents_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Agents.svg"/>
                <SvgImageSource x:Key="Dashboards_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Activity.svg"/>
                <SvgImageSource x:Key="Systems_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Instances.svg"/>
                <SvgImageSource x:Key="Automations_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Cron.svg"/>
                <SvgImageSource x:Key="Plugins_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Skills.svg"/>
                <SvgImageSource x:Key="More_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Advanced.svg"/>
                <SvgImageSource x:Key="Notifications_Icon" UriSource="ms-appx:///Assets/SidebarIcons/Notifications.svg"/>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel Margin="4,8,12,8" Spacing="8">
                    <Grid x:Name="NavigationToolbar">
                        <Button x:Uid="WorkspaceShell_TogglePane" Click="OnTogglePane"
                                AutomationProperties.AutomationId="WorkspaceTogglePane"
                                Width="40" Height="40"
                                HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE90C;" FontSize="16"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="BackButton" x:Uid="NavBackButton" Click="OnBack"
                                    Height="40"
                                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspaceBack"
                                    IsEnabled="False">
                                <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                            </Button>
                            <Button x:Name="ForwardButton" x:Uid="WorkspaceShell_Forward" Click="OnForward"
                                    Height="40"
                                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspaceForward"
                                    IsEnabled="False">
                                <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ComboBox x:Name="AssistantSelector" x:Uid="WorkspaceShell_Assistant"
                              Margin="8,0,0,0"
                              HorizontalAlignment="Stretch" SelectionChanged="OnAssistantChanged"
                              Background="Transparent" BorderThickness="0"
                              AutomationProperties.AutomationId="WorkspaceAssistantSelector">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent"/>
                            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                        </ComboBox.Resources>
                        <ComboBoxItem x:Name="NewConversationOption" x:Uid="WorkspaceShell_NewConversation"
                                      AutomationProperties.AutomationId="WorkspaceNewConversation">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                <TextBlock x:Name="NewConversationLabel"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CompactPaneItem" Visibility="Collapsed"
                                    Style="{StaticResource WorkspaceCompactAction}">
                    <Button x:Uid="WorkspaceShell_TogglePane" Click="OnTogglePane"
                            AutomationProperties.AutomationId="WorkspaceReopenPane"
                            Width="40" Height="40" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE90C;" FontSize="16"/>
                    </Button>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="PagesHeader"/>
                <NavigationViewItem x:Name="HomeItem" Tag="home" AutomationProperties.AutomationId="WorkspaceNavHome">
                    <NavigationViewItem.Icon><ImageIcon Source="{StaticResource Chat_Icon}" AutomationProperties.AccessibilityView="Raw"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AgentsItem" Tag="agents" AutomationProperties.AutomationId="WorkspaceNavAgents">
                    <NavigationViewItem.Icon><ImageIcon Source="{StaticResource Agents_Icon}" AutomationProperties.AccessibilityView="Raw"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DashboardsItem" Tag="dashboards" AutomationProperties.AutomationId="WorkspaceNavDashboards">
                    <NavigationViewItem.Icon><ImageIcon Source="{StaticResource Dashboards_Icon}" AutomationProperties.AccessibilityView="Raw"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SystemsItem" Tag="systems" AutomationProperties.AutomationId="WorkspaceNavSystems">
                    <NavigationViewItem.Icon><ImageIcon Source="{StaticResource Systems_Icon}" AutomationProperties.AccessibilityView="Raw"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AutomationsItem" Tag="automations" AutomationProperties.AutomationId="WorkspaceNavAutomations">
                    <NavigationViewItem.Icon><ImageIcon Source="{StaticResource Automations_Icon}" AutomationProperties.AccessibilityView="Raw"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PluginsItem" Tag="plugins" AutomationProperties.AutomationId="WorkspaceNavPlugins">
                    <NavigationViewItem.Icon><ImageIcon Source="{StaticResource Plugins_Icon}" AutomationProperties.AccessibilityView="Raw"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MoreItem" Tag="more" AutomationProperties.AutomationId="WorkspaceMore">
                    <NavigationViewItem.Icon><ImageIcon Source="{StaticResource More_Icon}" AutomationProperties.AccessibilityView="Raw"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="SessionsHeader" IsEnabled="True">
                    <NavigationViewItemHeader.Template>
                        <ControlTemplate TargetType="NavigationViewItemHeader">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="PaneStates">
                                        <VisualState x:Name="HeaderTextVisible"/>
                                        <VisualState x:Name="HeaderTextCollapsed">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderContent.Visibility" Value="Collapsed"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="HeaderContent" Content="{TemplateBinding Content}"
                                                  Height="40" Margin="{ThemeResource NavigationViewItemInnerHeaderMargin}"/>
                            </Grid>
                        </ControlTemplate>
                    </NavigationViewItemHeader.Template>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="WorkspaceShell_SessionsLabel" Text="Sessions" VerticalAlignment="Center"
                                   Style="{StaticResource NavigationViewItemHeaderTextStyle}"/>
                        <Button x:Name="NewSessionButton" x:Uid="WorkspaceShell_NewConversation" Grid.Column="1" Click="OnNewConversation"
                                Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="WorkspaceSessionsAdd">
                            <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        </Button>
                    </Grid>
                </NavigationViewItemHeader>
                <NavigationViewItemHeader x:Name="SessionsEmpty" FontWeight="Normal"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="CompactNotificationsItem" Visibility="Collapsed"
                                    Style="{StaticResource WorkspaceCompactAction}">
                    <Button x:Uid="WorkspaceShell_NotificationsButton" Click="OnNotifications"
                            AutomationProperties.AutomationId="WorkspaceCompactNotifications"
                            Width="40" Height="40" Style="{StaticResource SubtleButtonStyle}">
                        <ImageIcon Source="{StaticResource Notifications_Icon}" Width="20" Height="20"
                                   AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <Grid x:Name="ExpandedFooter" ColumnSpacing="4" Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="OwnerButton" Style="{StaticResource SubtleButtonStyle}" Padding="8" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" AutomationProperties.AutomationId="WorkspaceOwner">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PersonPicture Width="24" Height="24" VerticalAlignment="Center"
                                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                            <StackPanel>
                                <TextBlock x:Uid="WorkspaceShell_Owner" Text="Owner"/>
                                <TextBlock x:Uid="WorkspaceShell_PersonalWorkspace" Text="Personal workspace"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NotificationsButton" x:Uid="WorkspaceShell_NotificationsButton" Grid.Column="1" Click="OnNotifications"
                            Style="{StaticResource SubtleButtonStyle}" Padding="8" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="WorkspaceNotifications">
                        <ImageIcon Source="{StaticResource Notifications_Icon}" Width="20" Height="20"
                                   AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                </Grid>
            </NavigationView.PaneFooter>
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8" Margin="0,0,8,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar x:Name="OperationInfo" IsOpen="False" IsClosable="True" Severity="Error"/>
                <Grid x:Name="ContentHost" Grid.Row="1" AutomationProperties.AutomationId="WorkspaceContent"/>
            </Grid>
        </NavigationView>
        </Grid>
    </Grid>
</winex:WindowEx>
