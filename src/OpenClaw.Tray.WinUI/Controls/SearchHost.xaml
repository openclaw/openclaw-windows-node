<UserControl
    x:Class="OpenClawTray.Controls.SearchHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="Layout" Spacing="8" Width="500" PreviewKeyDown="OnKeyDown">
        <TextBox x:Name="SearchBox" x:Uid="SearchInput" TextChanged="OnTextChanged"
                 AutomationProperties.AcceleratorKey="Ctrl+E"/>
        <ListView x:Name="ResultsList" SelectionMode="Single" IsItemClickEnabled="True"
                  MaxHeight="420" ItemClick="OnItemClick"
                  ContainerContentChanging="OnContainerContentChanging"
                  AutomationProperties.AutomationId="SearchResultsList">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" Margin="0,8,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="40" ColumnSpacing="8" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Icon}" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ResultTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Badge}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   AutomationProperties.AccessibilityView="Raw"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel Spacing="8" Margin="4,8,4,0">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="SearchStatus" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Name="MoreButton" x:Uid="SearchMore" Click="OnMore" AutomationProperties.AutomationId="SearchMore"/>
                        <HyperlinkButton x:Name="RetryButton" x:Uid="SearchRetry" Click="OnRetry" AutomationProperties.AutomationId="SearchRetry"/>
                    </StackPanel>
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </StackPanel>
</UserControl>
