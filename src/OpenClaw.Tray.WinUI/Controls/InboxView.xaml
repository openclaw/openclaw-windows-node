<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="OpenClawTray.Controls.InboxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Width="400" MaxHeight="480" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8" Margin="2,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="TitleGlyph" Glyph="&#xEA8F;" FontSize="16" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock x:Name="TitleText" x:Uid="Inbox_Title" Grid.Column="1"
                       Text="Inbox" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <HyperlinkButton x:Name="DismissShownButton" x:Uid="Inbox_DismissShown" Grid.Column="2"
                             AutomationProperties.AutomationId="WorkspaceNotificationsClear"
                             Content="Dismiss shown" Padding="4,0" VerticalAlignment="Center"
                             Click="OnDismissShownClick"/>
            <Button x:Name="SettingsButton" x:Uid="Inbox_SettingsButton" Grid.Column="3"
                    AutomationProperties.AutomationId="WorkspaceNotificationsSettings"
                    Width="32" Height="32" Padding="0"
                    Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                    Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
            </Button>
        </Grid>

        <!-- Flyout only: the negative top margin cancels the row spacing so the tabs sit directly under the title.
             UsePageLayout restores the standard spacing on the full page. -->
        <SelectorBar x:Name="TabsBar" x:Uid="Inbox_Tabs" Grid.Row="1" Margin="-4,-12,0,-4" Padding="0"
                     AutomationProperties.AutomationId="WorkspaceNotificationsTabs"
                     SelectionChanged="OnTabSelectionChanged">
            <SelectorBarItem x:Name="AllTab" Tag="All" IsSelected="True"
                             AutomationProperties.AutomationId="WorkspaceNotificationsTabAll"/>
            <SelectorBarItem x:Name="ApprovalsTab" Tag="Approvals"
                             AutomationProperties.AutomationId="WorkspaceNotificationsTabApprovals"/>
            <SelectorBarItem x:Name="MentionsTab" Tag="Mentions"
                             AutomationProperties.AutomationId="WorkspaceNotificationsTabMentions"/>
            <SelectorBarItem x:Name="AutomationsTab" Tag="Automations"
                             AutomationProperties.AutomationId="WorkspaceNotificationsTabAutomations"/>
            <SelectorBarItem x:Name="SystemTab" Tag="System"
                             AutomationProperties.AutomationId="WorkspaceNotificationsTabSystem"/>
        </SelectorBar>

        <ListView x:Name="ItemsList"
                  Grid.Row="2"
                  AutomationProperties.AutomationId="WorkspaceNotificationsList"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Padding="0"
                  Margin="-4,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding RowAutomationName}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Top" Margin="0,2,0,0"
                                          AutomationProperties.AccessibilityView="Raw">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{Binding ErrorIconVisibility}"/>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Visibility="{Binding WarningIconVisibility}"/>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Visibility="{Binding NeutralIconVisibility}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding State}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AgeText}"
                                               ToolTipService.ToolTip="{Binding CreatedText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ExpiryText}" Visibility="{Binding ExpiryVisibility}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="{Binding ScopeText}" Visibility="{Binding ScopeVisibility}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="{Binding WarningText}" Visibility="{Binding WarningVisibility}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="{Binding Details}" Visibility="{Binding DetailsVisibility}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <Border Visibility="{Binding CommandVisibility}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <!-- The complete command stays reviewable: no trimming or line cap, it scrolls instead. -->
                                    <ScrollViewer MaxHeight="200"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="8,6">
                                        <TextBlock Text="{Binding CommandText}" FontFamily="Consolas"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    </ScrollViewer>
                                </Border>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Metadata}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Visibility="{Binding OccurrenceVisibility}"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OccurrenceText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding ActionLabel}"
                                            Tag="{Binding}"
                                            Visibility="{Binding ActionVisibility}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnActionClick"/>
                                    <Button x:Uid="Inbox_AskOpenClaw"
                                            Content="Ask OpenClaw"
                                            Tag="{Binding}"
                                            Visibility="{Binding AskVisibility}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnAskClick"/>
                                    <Button Content="{Binding SecondaryActionLabel}"
                                            Tag="{Binding}"
                                            Visibility="{Binding SecondaryActionVisibility}"
                                            Click="OnSecondaryActionClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Button Grid.Column="1"
                                Tag="{Binding Id}"
                                Visibility="{Binding DismissVisibility}"
                                AutomationProperties.Name="{Binding DismissAutomationName}"
                                ToolTipService.ToolTip="{Binding DismissAutomationName}"
                                Width="32" Height="32" Padding="0" Margin="0,12,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnDismissClick">
                            <FontIcon Glyph="&#xE711;" FontSize="11"
                                      AutomationProperties.AccessibilityView="Raw"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border x:Name="EmptyState"
                Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                VerticalAlignment="Top">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="Inbox_EmptyTitle" AutomationProperties.AutomationId="WorkspaceNotificationsEmpty"
                           Text="Nothing waiting"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Uid="Inbox_EmptyBody"
                           Text="New requests and alerts land here."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Border>

        <Grid x:Name="FooterRow" Grid.Row="3" Margin="2,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HyperlinkButton x:Uid="Inbox_OpenPage" AutomationProperties.AutomationId="WorkspaceNotificationsOpenPage"
                             Content="Open Inbox"
                             Padding="4,0" VerticalAlignment="Center"
                             Click="OnOpenPageClick"/>
            <TextBlock x:Name="CountText" Grid.Column="1" Text=""
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
