<Project>
  <PropertyGroup>
    <BrowserNativeHostProject>$(MSBuildThisFileDirectory)..\OpenClaw.BrowserNativeHost\OpenClaw.BrowserNativeHost.csproj</BrowserNativeHostProject>
    <BrowserNativeHostRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</BrowserNativeHostRid>
    <BrowserNativeHostRid Condition="'$(BrowserNativeHostRid)' == '' And '$(Platform)' == 'ARM64'">win-arm64</BrowserNativeHostRid>
    <BrowserNativeHostRid Condition="'$(BrowserNativeHostRid)' == ''">win-x64</BrowserNativeHostRid>
    <BrowserNativeHostPayload>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)obj\browser-native\$(Configuration)\$(BrowserNativeHostRid)\'))</BrowserNativeHostPayload>
  </PropertyGroup>
  <!-- Chrome launches a real self-contained .exe, never a .cmd wrapper or an installed Node runtime. -->
  <Target Name="BuildBrowserNativeHostPayload" BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(BrowserNativeHostProject)" Targets="Restore;Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(BrowserNativeHostRid);SelfContained=true;PublishDir=$(BrowserNativeHostPayload);PackageMsix=false"
             RemoveProperties="TargetFramework;TargetFrameworks;OutputPath;OutDir;PublishSingleFile;PublishAot;PublishTrimmed" />
    <ItemGroup>
      <_BrowserNativeHostFile Include="$(BrowserNativeHostPayload)**\*" />
      <ContentWithTargetPath Include="@(_BrowserNativeHostFile)">
        <TargetPath>tools\browser-bootstrap\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
    <Error Condition="!Exists('$(BrowserNativeHostPayload)OpenClaw.BrowserNativeHost.exe')"
           Text="The native browser bootstrap executable was not published." />
  </Target>
  <!-- The SDK's ComputeResolvedFilesToPublishList drops same-named runtime assets
       against the parent runtime even when RelativePath points into a subdirectory.
       Add this independent self-contained payload only after that resolution. -->
  <Target Name="AddBrowserNativeHostToPublishItems" AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="BuildBrowserNativeHostPayload" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BrowserNativeHostFile)">
        <RelativePath>tools\browser-bootstrap\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="VerifyBrowserNativeHostPublished" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_RequiredBrowserNativeFile Include="OpenClaw.BrowserNativeHost.exe;OpenClaw.BrowserNativeHost.dll;OpenClaw.BrowserNativeHost.runtimeconfig.json;OpenClaw.BrowserNativeHost.deps.json;hostpolicy.dll;hostfxr.dll;System.Private.CoreLib.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(PublishDir)tools\browser-bootstrap\%(_RequiredBrowserNativeFile.Identity)')"
           Text="The self-contained browser bootstrap payload is missing %(_RequiredBrowserNativeFile.Identity)." />
  </Target>
</Project>
