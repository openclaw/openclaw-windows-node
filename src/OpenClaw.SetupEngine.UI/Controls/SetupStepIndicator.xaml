<UserControl
    x:Class="OpenClaw.SetupEngine.UI.Controls.SetupStepIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="CurrentTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <DataTemplate x:Key="StepTemplate">
            <Grid ColumnDefinitions="32,4,*" MinHeight="32">
                <Grid x:Name="MarkerColumn">
                    <Border x:Name="TopConnector" Width="1" Height="4" VerticalAlignment="Top"
                            Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                    <Border x:Name="BottomConnector" Width="1" Margin="0,16,0,0"
                            Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                    <Border x:Name="FilledConnector" Width="1" Margin="0,16,0,0" Visibility="Collapsed"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0" AutomationProperties.AccessibilityView="Raw">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="FilledTopConnector" Width="1" Height="4" VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"
                            AutomationProperties.AccessibilityView="Raw" />
                    <Grid x:Name="GlowHost" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0"
                          AutomationProperties.AccessibilityView="Raw" />
                    <Ellipse x:Name="UpcomingDot" Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0"
                             StrokeThickness="1" Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                             AutomationProperties.AccessibilityView="Raw" />
                    <Ellipse x:Name="CurrentDot" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0"
                             Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"
                             RenderTransformOrigin="0.5,0.5" AutomationProperties.AccessibilityView="Raw">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Grid x:Name="CompletedDot" Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0"
                          Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
                        <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                 AutomationProperties.AccessibilityView="Raw" />
                        <FontIcon Glyph="&#xE73E;" FontSize="7" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  IsTextScaleFactorEnabled="False" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Grid>
                <StackPanel x:Name="StepText" Grid.Column="2" Spacing="1" Padding="0,0,0,14">
                    <TextBlock x:Name="StepTitle" FontFamily="Segoe UI Variable" FontSize="13" LineHeight="18"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="StepDescription" FontFamily="Segoe UI Variable" FontSize="12" LineHeight="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel x:Name="StepRows" />
</UserControl>
