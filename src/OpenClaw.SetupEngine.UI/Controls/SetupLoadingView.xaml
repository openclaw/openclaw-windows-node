<UserControl x:Class="OpenClaw.SetupEngine.UI.Controls.SetupLoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
             xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Standalone: centered mascot card on a solid surface. Embedded in the setup window's page
         column: the companion already shows the mascot, so content follows the page hero layout. -->
    <Grid x:Name="Surface" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="40,24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HostStates">
                <VisualState x:Name="Standalone" />
                <VisualState x:Name="Embedded">
                    <VisualState.Setters>
                        <Setter Target="Surface.Background" Value="Transparent" />
                        <Setter Target="Surface.Padding" Value="{StaticResource SetupPagePadding}" />
                        <Setter Target="Mascot.Visibility" Value="Collapsed" />
                        <Setter Target="ContentStack.VerticalAlignment" Value="Top" />
                        <Setter Target="ContentStack.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ContentStack.MaxWidth" Value="600" />
                        <Setter Target="ContentStack.Margin" Value="{StaticResource SetupGutterMargin}" />
                        <Setter Target="Title.Style" Value="{StaticResource SetupHeroTitleTextStyle}" />
                        <Setter Target="Title.TextAlignment" Value="Left" />
                        <Setter Target="Measurement.TextAlignment" Value="Left" />
                        <Setter Target="ActivityProgress.MaxWidth" Value="600" />
                        <Setter Target="CancelButton.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <StackPanel x:Name="ContentStack" Spacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="560">
                    <controls:OnboardingMascot x:Name="Mascot" Mood="Thinking" HorizontalAlignment="Center" />
                    <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar x:Name="ActivityProgress" IsIndeterminate="True" MaxWidth="320" HorizontalAlignment="Stretch"
                                 AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="Measurement" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="CancelButton" Visibility="Collapsed" HorizontalAlignment="Center" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
