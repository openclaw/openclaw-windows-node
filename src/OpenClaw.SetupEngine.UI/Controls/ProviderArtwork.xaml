<UserControl
    x:Class="OpenClaw.SetupEngine.UI.Controls.ProviderArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
    <Border Padding="8" RequestedTheme="Dark"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid Width="24" Height="24">
            <FontIcon x:Name="FallbackIcon" IsTextScaleFactorEnabled="False"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
            <Image x:Name="ArtworkImage" Stretch="Uniform" Visibility="Collapsed"
                   AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </Border>
</UserControl>
