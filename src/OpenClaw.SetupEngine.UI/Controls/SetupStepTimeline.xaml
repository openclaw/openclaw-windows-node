<UserControl
    x:Class="OpenClaw.SetupEngine.UI.Controls.SetupStepTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Canvas x:Name="Connectors" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Rectangle x:Name="Track0" Width="1" Canvas.Left="15.5" Fill="{ThemeResource SetupStepConnectorBrush}" />
            <Rectangle x:Name="Track1" Width="1" Canvas.Left="15.5" Fill="{ThemeResource SetupStepConnectorBrush}" />
            <Rectangle x:Name="Track2" Width="1" Canvas.Left="15.5" Fill="{ThemeResource SetupStepConnectorBrush}" />
            <Rectangle x:Name="Pour0" Width="1" Canvas.Left="15.5" Opacity="0" Fill="{ThemeResource SetupAccentBrush}">
                <Rectangle.RenderTransform><ScaleTransform x:Name="Pour0Scale" ScaleY="0" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Pour1" Width="1" Canvas.Left="15.5" Opacity="0" Fill="{ThemeResource SetupAccentBrush}">
                <Rectangle.RenderTransform><ScaleTransform x:Name="Pour1Scale" ScaleY="0" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Pour2" Width="1" Canvas.Left="15.5" Opacity="0" Fill="{ThemeResource SetupAccentBrush}">
                <Rectangle.RenderTransform><ScaleTransform x:Name="Pour2Scale" ScaleY="0" /></Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
        <StackPanel x:Name="Rows" Spacing="14">
            <local:SetupStepRow x:Name="Step0" />
            <local:SetupStepRow x:Name="Step1" />
            <local:SetupStepRow x:Name="Step2" />
            <local:SetupStepRow x:Name="Step3" />
        </StackPanel>
    </Grid>
</UserControl>
