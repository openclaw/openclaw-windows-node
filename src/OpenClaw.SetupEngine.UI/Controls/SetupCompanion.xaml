<UserControl
    x:Class="OpenClaw.SetupEngine.UI.Controls.SetupCompanion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Rows follow the 1120x720 design: 146 above the hero, 66 above the timeline, 64 below. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="146*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="66*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeroBlock" Grid.Row="1" Width="336" Height="259"
              HorizontalAlignment="Center" Margin="0,0,24,0">
            <Canvas IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <Ellipse x:Name="AmbientGlow" Width="680" Height="680" Canvas.Left="-166" Canvas.Top="-158"
                         Fill="{ThemeResource SetupGlowBrush}" />
            </Canvas>
            <Ellipse x:Name="MascotShadow" Width="158" Height="44" Margin="0,210,0,0"
                     HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                     Fill="{ThemeResource SetupMascotShadowBrush}" />
            <Grid x:Name="MascotHost" Width="230" Height="230" Margin="0,29,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MascotBounce" />
                </Grid.RenderTransform>
                <local:OnboardingMascot x:Name="MascotControl" Width="230" Height="230" Mood="Idle" />
                <Grid x:Name="RestartBadge" Width="54" Height="54" Margin="0,0,30,18" Visibility="Collapsed"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <FontIcon Glyph="&#xE72C;" FontSize="26" IsTextScaleFactorEnabled="False"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource SetupStepDoneGlyphBrush}" />
                </Grid>
                <Grid x:Name="SuccessBadge" Width="40" Height="40" Margin="0,0,36,26" Visibility="Collapsed"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" StrokeThickness="3"
                             Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="16" IsTextScaleFactorEnabled="False"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource SetupStepDoneGlyphBrush}" />
                </Grid>
            </Grid>
            <Grid x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,0,-6"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5"
                        Background="{ThemeResource SetupBubbleBackgroundBrush}"
                        BorderBrush="{ThemeResource SetupBubbleBorderBrush}" BorderThickness="1">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45" />
                    </Border.RenderTransform>
                </Border>
                <Border CornerRadius="16" Padding="18,12" BorderThickness="1"
                        Background="{ThemeResource SetupBubbleBackgroundBrush}"
                        BorderBrush="{ThemeResource SetupBubbleBorderBrush}">
                    <TextBlock x:Name="BubbleText" MaxWidth="300" TextWrapping="Wrap" TextAlignment="Center"
                               FontFamily="Segoe UI Variable Display" FontSize="18" LineHeight="24" FontWeight="SemiBold"
                               Foreground="{ThemeResource SetupBubbleForegroundBrush}" />
                </Border>
            </Grid>
        </Grid>

        <local:SetupStepTimeline x:Name="Timeline" Grid.Row="3" MaxWidth="320"
                                 HorizontalAlignment="Left" Margin="134,0,0,0" />
    </Grid>
</UserControl>
