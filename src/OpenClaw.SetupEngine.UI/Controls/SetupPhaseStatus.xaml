<UserControl x:Class="OpenClaw.SetupEngine.UI.Controls.SetupPhaseStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:OpenClawTray.Helpers">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   MaxWidth="160" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ProgressRing x:Name="RunningIcon" Width="20" Height="20" MinWidth="20" MinHeight="20"
                      IsActive="False" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
        <FontIcon x:Name="CompleteIcon" Glyph="{x:Bind icons:FluentIconCatalog.StatusOk}"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}" IsTextScaleFactorEnabled="False"
                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"
                  AutomationProperties.AccessibilityView="Raw" />
        <FontIcon x:Name="FailedIcon" Glyph="{x:Bind icons:FluentIconCatalog.StatusErr}"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}" IsTextScaleFactorEnabled="False"
                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                  AutomationProperties.AccessibilityView="Raw" />
        <FontIcon x:Name="CancelledIcon" Glyph="{x:Bind icons:FluentIconCatalog.Exit}"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}" IsTextScaleFactorEnabled="False"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                  AutomationProperties.AccessibilityView="Raw" />
    </StackPanel>
</UserControl>
