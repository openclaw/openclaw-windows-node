<UserControl
    x:Class="OpenClaw.SetupEngine.UI.Controls.SetupStepRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid ColumnDefinitions="36,*" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StepStates">
                <VisualState x:Name="Upcoming" />
                <VisualState x:Name="Current">
                    <VisualState.Setters>
                        <Setter Target="Glow.Visibility" Value="Visible" />
                        <Setter Target="CurrentDot.Visibility" Value="Visible" />
                        <Setter Target="FutureRing.Visibility" Value="Collapsed" />
                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Done">
                    <VisualState.Setters>
                        <Setter Target="DoneNode.Visibility" Value="Visible" />
                        <Setter Target="FutureRing.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!-- 24-DIP node host centered 16 DIPs in, on the 18-DIP label line. -->
        <Grid x:Name="NodeHost" Width="24" Height="24" Margin="4,-3,0,0"
              HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
              AutomationProperties.AccessibilityView="Raw">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="NodeScale" />
            </Grid.RenderTransform>
            <Ellipse x:Name="Glow" Width="24" Height="24" Opacity="0.55" Visibility="Collapsed"
                     Fill="{ThemeResource SetupStepGlowBrush}" />
            <Ellipse x:Name="CurrentDot" Width="12" Height="12" Visibility="Collapsed"
                     Fill="{ThemeResource SetupAccentBrush}" />
            <Ellipse x:Name="FutureRing" Width="10" Height="10" StrokeThickness="1"
                     Stroke="{ThemeResource SetupStepFutureBrush}" />
            <Grid x:Name="DoneNode" Width="10" Height="10" Visibility="Collapsed">
                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <FontIcon Glyph="&#xE73E;" FontSize="7" IsTextScaleFactorEnabled="False"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Foreground="{ThemeResource SetupStepDoneGlyphBrush}" />
            </Grid>
        </Grid>
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="Label" FontSize="13" LineHeight="18" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <Grid x:Name="DetailHost" MaxHeight="0" Opacity="0">
                <TextBlock x:Name="Detail" FontSize="12" LineHeight="16" Margin="0,1,0,0" TextWrapping="Wrap"
                           VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
