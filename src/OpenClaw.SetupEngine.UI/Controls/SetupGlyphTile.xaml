<UserControl
    x:Class="OpenClaw.SetupEngine.UI.Controls.SetupGlyphTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    IsTabStop="False" Width="40" Height="40" VerticalAlignment="Center"
    AutomationProperties.AccessibilityView="Raw">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="Tile" CornerRadius="8" Background="{ThemeResource SetupTileBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ActiveStates">
                <VisualState x:Name="Inactive" />
                <VisualState x:Name="Active">
                    <VisualState.Setters>
                        <Setter Target="Tile.Background" Value="{ThemeResource SetupTileSelectedBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SetupTileSelectedGlyphBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <FontIcon x:Name="Icon" FontSize="20" IsTextScaleFactorEnabled="False"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Border>
</UserControl>
