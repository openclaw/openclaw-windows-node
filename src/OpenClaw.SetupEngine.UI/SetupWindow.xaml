<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenClaw.SetupEngine.UI.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    Title="OpenClaw Setup">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar drag region with icon + text -->
        <Grid x:Name="TitleBarDrag" Grid.Row="0" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:OnboardingMascot Mood="Idle" Width="24" Height="24" IsAnimationEnabled="False" />
                <TextBlock x:Uid="Onboarding_V2_WindowTitle" Text="OpenClaw Setup" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Frame x:Name="RootFrame" Grid.Row="1" Navigated="RootFrame_Navigated" NavigationFailed="RootFrame_NavigationFailed" />
        <controls:SetupLoadingView x:Name="LoadingOverlay" Grid.Row="1" Visibility="Collapsed" />
    </Grid>

</Window>
