<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenClaw.SetupEngine.UI.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    Title="OpenClaw setup">

    <!-- Two-pane shell: the companion (bubble, mascot, step timeline) on the left and the
         navigated page on the right. Pages own only their hero text, body and navigation. -->
    <Grid x:Name="ShellRoot">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <themes:SetupResources />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CompanionColumn" Width="472" />
            <!-- Pages keep the 600-DIP design column plus a 48-DIP gutter; wider windows grow the companion. -->
            <ColumnDefinition Width="*" MaxWidth="648" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="3" IsHitTestVisible="False"
                   Fill="{ThemeResource SetupBackdropTintBrush}" />

        <controls:SetupCompanion x:Name="Companion" Grid.Row="1" Grid.Column="0" />

        <!-- Title bar drag region with icon + text -->
        <Grid x:Name="TitleBarDrag" Grid.Row="0" Grid.ColumnSpan="3" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:OnboardingMascot Mood="Idle" Width="24" Height="24" IsAnimationEnabled="False"
                                           IsInteractive="False" />
                <TextBlock x:Uid="Onboarding_V2_WindowTitle" Text="OpenClaw setup" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Frame x:Name="RootFrame" Grid.Row="1" Grid.Column="1"
               Navigating="RootFrame_Navigating" Navigated="RootFrame_Navigated" NavigationFailed="RootFrame_NavigationFailed" />
        <controls:SetupLoadingView x:Name="LoadingOverlay" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" />
    </Grid>

</Window>
