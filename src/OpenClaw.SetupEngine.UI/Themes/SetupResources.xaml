<?xml version="1.0" encoding="utf-8"?>
<!--
    Setup design tokens and text/button styles for the two-pane setup window.
    Merge into a page or control's Resources (not Application.Resources) so the
    lightweight HyperlinkButton, ListViewItem and SettingsCard overrides stay scoped
    to setup. Colors alias native Fluent resources; the only literal colors are the
    brand glow/tint and the speech-bubble ink documented in DESIGN.md.

    Usage:
        <Page.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <themes:SetupResources />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Page.Resources>
-->
<ResourceDictionary
    x:Class="OpenClaw.SetupEngine.UI.Themes.SetupResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SetupAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="SetupTileSelectedBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.16" />
            <SolidColorBrush x:Key="SetupTileSelectedGlyphBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <LinearGradientBrush x:Key="SetupBackdropTintBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#1F4A1418" />
                <GradientStop Offset="0.55" Color="#0A4A1418" />
                <GradientStop Offset="1" Color="#004A1418" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SetupGlowBrush">
                <GradientStop Offset="0" Color="#61A83B38" />
                <GradientStop Offset="0.32" Color="#3BA83B38" />
                <GradientStop Offset="0.5" Color="#1FA83B38" />
                <GradientStop Offset="0.7" Color="#0AA83B38" />
                <GradientStop Offset="1" Color="#00A83B38" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="SetupMascotShadowBrush">
                <GradientStop Offset="0" Color="#66000000" />
                <GradientStop Offset="0.55" Color="#3D000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SetupBubbleBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SetupBubbleForegroundBrush" Color="#1B1F26" />
            <SolidColorBrush x:Key="SetupBubbleBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SetupHairlineBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SetupTileBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SetupStepConnectorBrush" Color="{ThemeResource ControlStrongStrokeColorDisabled}" />
            <SolidColorBrush x:Key="SetupStepFutureBrush" Color="{ThemeResource TextFillColorDisabled}" />
            <RadialGradientBrush x:Key="SetupStepGlowBrush">
                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}" />
                <GradientStop Offset="1" Color="#0060CDFF" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SetupStepDoneGlyphBrush" Color="#20242B" />
            <SolidColorBrush x:Key="SetupConsoleBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorSecondary}" />

            <!-- Setup links are quiet text actions, not accent hyperlinks. -->
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
            <!-- Choice rows show the native accent pill, not a filled selection. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
            <!-- Cards render as hairline-separated rows on the setup surface. -->
            <SolidColorBrush x:Key="SettingsCardBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPointerOver" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPressed" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushDisabled" Color="{ThemeResource DividerStrokeColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SetupAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="SetupTileSelectedBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.12" />
            <SolidColorBrush x:Key="SetupTileSelectedGlyphBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <LinearGradientBrush x:Key="SetupBackdropTintBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#1AE0607A" />
                <GradientStop Offset="0.55" Color="#08E0607A" />
                <GradientStop Offset="1" Color="#00E0607A" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="SetupGlowBrush">
                <GradientStop Offset="0" Color="#38EF4B58" />
                <GradientStop Offset="0.32" Color="#21EF4B58" />
                <GradientStop Offset="0.5" Color="#12EF4B58" />
                <GradientStop Offset="0.7" Color="#06EF4B58" />
                <GradientStop Offset="1" Color="#00EF4B58" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="SetupMascotShadowBrush">
                <GradientStop Offset="0" Color="#33000000" />
                <GradientStop Offset="0.55" Color="#1A000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SetupBubbleBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SetupBubbleForegroundBrush" Color="#1B1F26" />
            <SolidColorBrush x:Key="SetupBubbleBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="SetupHairlineBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SetupTileBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SetupStepConnectorBrush" Color="{ThemeResource ControlStrongStrokeColorDisabled}" />
            <SolidColorBrush x:Key="SetupStepFutureBrush" Color="{ThemeResource TextFillColorDisabled}" />
            <RadialGradientBrush x:Key="SetupStepGlowBrush">
                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorDark1}" />
                <GradientStop Offset="1" Color="#00005FB8" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="SetupStepDoneGlyphBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SetupConsoleBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorSecondary}" />

            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="SettingsCardBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPointerOver" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPressed" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushDisabled" Color="{ThemeResource DividerStrokeColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SetupAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SetupTileSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- The selected glyph sits on the highlight fill, so it uses the paired highlight text color. -->
            <SolidColorBrush x:Key="SetupTileSelectedGlyphBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <!-- The selected glyph sits on the highlight fill, so it uses the paired highlight text color. -->
            <SolidColorBrush x:Key="SetupBackdropTintBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SetupGlowBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SetupMascotShadowBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SetupBubbleBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SetupBubbleForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SetupBubbleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SetupHairlineBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SetupTileBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SetupStepConnectorBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SetupStepFutureBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SetupStepGlowBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SetupStepDoneGlyphBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SetupConsoleBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="SettingsCardBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="SettingsCardPadding">0,10,0,10</Thickness>
    <x:Double x:Key="SettingsCardMinHeight">56</x:Double>
    <x:Double x:Key="SettingsCardDescriptionFontSize">13</x:Double>
    <x:Double x:Key="SettingsCardHeaderIconMaxSize">18</x:Double>
    <Thickness x:Key="SettingsCardHeaderIconMargin">0,0,12,0</Thickness>

    <!-- Hero: 40/52 Display Semibold title, 18/24 subtitle. -->
    <Style x:Key="SetupHeroTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SetupHeroSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- Rows: 15/22 Semibold title, 13/18 secondary description, 13/18 Semibold status. -->
    <Style x:Key="SetupRowTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SetupRowDescriptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SetupRowTertiaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SetupRowDescriptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="SetupRowStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="SetupInlineRecommendedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SetupAccentBrush}" />
    </Style>
    <Style x:Key="SetupSectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SetupFootnoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SetupMonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- Hero, scrolling body and right-aligned navigation share one right gutter. -->
    <Thickness x:Key="SetupPagePadding">0,40,0,40</Thickness>
    <Thickness x:Key="SetupGutterMargin">0,0,48,0</Thickness>
    <Thickness x:Key="SetupBodyMargin">0,24,0,16</Thickness>
    <x:Double x:Key="SetupContentMaxWidth">600</x:Double>
    <x:Double x:Key="SetupFooterButtonMinWidth">180</x:Double>

    <Style x:Key="SetupHeroPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="10" />
        <Setter Property="Margin" Value="{StaticResource SetupGutterMargin}" />
        <Setter Property="MaxWidth" Value="{StaticResource SetupContentMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="SetupNavPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="{StaticResource SetupGutterMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <!-- Paired footer actions share one minimum width so Back and Next match. -->
    <Style x:Key="SetupPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource SetupFooterButtonMinWidth}" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style x:Key="SetupSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource SetupFooterButtonMinWidth}" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <!-- Text actions sit flush with the content edge; only the trailing side keeps padding. -->
    <Style x:Key="SetupLinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0,5,11,6" />
    </Style>
    <Style x:Key="SetupGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SetupHairlineStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Fill" Value="{ThemeResource SetupHairlineBrush}" />
    </Style>
    <Style x:Key="SetupChoiceItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- Rows own their vertical padding so the trailing hairline can reach the row edge. -->
        <Setter Property="Padding" Value="16,0,0,0" />
        <Setter Property="MinHeight" Value="64" />
    </Style>
</ResourceDictionary>
