<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.CompletePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SummaryRowStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="Padding" Value="0,12" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource SetupHairlineBrush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Success, failure and restart share one layout; the companion carries the mascot state. -->
    <Grid RowDefinitions="*,Auto" Padding="{StaticResource SetupPagePadding}">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="24" Margin="{StaticResource SetupGutterMargin}">

                <StackPanel Spacing="10">
                    <TextBlock x:Name="TitleText" Text="All set!" Style="{StaticResource SetupHeroTitleTextStyle}" />
                    <TextBlock x:Name="SubtitleText" Text="OpenClaw is ready to go" Style="{StaticResource SetupHeroSubtitleTextStyle}" />
                </StackPanel>

                <StackPanel x:Name="SummaryPanel" Visibility="Collapsed"
                            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SetupHairlineBrush}">
                    <Grid Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE756;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="GatewaySummaryTitle" Text="Local gateway running" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Name="GatewaySummaryText" Text="OpenClawGateway · 127.0.0.1:18789" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="LocalAiSummaryCard" Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto"
                          AutomationProperties.AutomationId="LocalAiCompletionSummary" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE950;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="LocalAiSummaryTitle" Text="Local AI installed" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Name="LocalAiSummaryDescription" AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="DevicePairedSummaryCard" Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE772;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Device paired" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock Text="This PC is connected and ready to use" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xEA18;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Capability profile applied" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Name="CapabilitySummaryText" Text="Editable any time in Companion Settings"
                                       Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="NativeFeaturesNote" x:Uid="Onboarding_Native_FeaturesNote" Margin="0,12,0,0"
                               Visibility="Collapsed" Style="{StaticResource SetupFootnoteTextStyle}"
                               Text="These Windows capabilities become usable after Node Mode connects and pairs with the Gateway. Windows permissions and command approvals still apply." />
                </StackPanel>

                <Border x:Name="ErrorCard" Padding="0,12" Visibility="Collapsed" BorderThickness="0,1"
                        BorderBrush="{ThemeResource SetupHairlineBrush}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <FontIcon Glyph="&#xEA39;" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top" IsTextScaleFactorEnabled="False"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="ServerDiagnosticsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Visibility="Collapsed" Style="{StaticResource SetupMonoTextStyle}" />
                        <HyperlinkButton x:Name="HelpLink" Visibility="Collapsed" Padding="0" FontSize="13" />
                        <HyperlinkButton x:Name="ViewLogLink" Content="View full log →" Click="ViewLog_Click" Padding="0" FontSize="13" />
                        <HyperlinkButton x:Name="ViewServerLogLink" Visibility="Collapsed" Click="ViewServerLog_Click" Padding="0" FontSize="13" />
                    </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="NodeModeBanner" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Margin="0,1,0,0" VerticalAlignment="Top" IsTextScaleFactorEnabled="False"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SetupFootnoteTextStyle}"
                               Text="Node mode enabled. The gateway can use this PC for screen capture, camera, and system commands." />
                </Grid>

                <Grid x:Name="StartupRow" Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="*,Auto"
                      BorderThickness="0,1">
                    <TextBlock x:Name="StartupLabel" Text="Launch OpenClaw at startup" VerticalAlignment="Center"
                               Style="{StaticResource SetupRowTitleTextStyle}" />
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent=""
                                  AutomationProperties.Name="Launch OpenClaw at startup"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <controls:SetupFooterPanel Grid.Row="1" Style="{StaticResource SetupNavPanelStyle}" Margin="0,16,48,0">
            <Button x:Name="FallbackButton"
                    Content="Retry with configured fallback"
                    Visibility="Collapsed" Style="{StaticResource SetupSecondaryButtonStyle}"
                    Click="FallbackButton_Click" />
            <Button x:Name="RestartLaterButton"
                    Content="No, I'm not ready yet"
                    Visibility="Collapsed" Style="{StaticResource SetupSecondaryButtonStyle}"
                    Click="RestartLaterButton_Click" />
            <Button x:Name="LaunchButton"
                    Content="Open chat"
                    Style="{StaticResource SetupPrimaryButtonStyle}"
                    Click="LaunchButton_Click" />
            <Button x:Name="RestartNowButton"
                    Content="Yes, restart now"
                    Visibility="Collapsed"
                    Style="{StaticResource SetupPrimaryButtonStyle}"
                    Click="RestartNowButton_Click" />
        </controls:SetupFooterPanel>

    </Grid>
</Page>
