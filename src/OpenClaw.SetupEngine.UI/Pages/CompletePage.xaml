<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.CompletePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="CompletionRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,16" />
        </Style>
        <DataTemplate x:Key="WrappedCompletionAction">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="200" Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
        <DataTemplate x:Key="WrappedDiagnosticLink">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <controls:SetupPageShell x:Name="CompleteShell">
        <controls:SetupPageShell.Hero>
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                <Grid MaxWidth="280" HorizontalAlignment="Center" RowDefinitions="Auto,10">
                    <Border Padding="16,12" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="SpeechText" x:Uid="Onboarding_Complete_SuccessSpeech" Text="All set."
                                   FontFamily="Segoe UI Variable" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <Path Grid.Row="1" Data="M0,0 L10,10 L20,0" HorizontalAlignment="Center"
                          Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <Grid x:Name="SuccessIcon" Width="{x:Bind controls:OnboardingMascot.HeroSize}" Height="{x:Bind controls:OnboardingMascot.HeroSize}"
                      HorizontalAlignment="Center" Margin="0,0,0,4">
                    <controls:OnboardingMascot x:Name="MascotHero" Mood="Celebrating" Accessory="GradCap" />
                    <Border Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="3">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" IsTextScaleFactorEnabled="False"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </Grid>
                <Grid x:Name="FailureIcon" Width="{x:Bind controls:OnboardingMascot.HeroSize}" Height="{x:Bind controls:OnboardingMascot.HeroSize}"
                      HorizontalAlignment="Center" Margin="0,0,0,16"
                      Visibility="Collapsed">
                    <controls:OnboardingMascot x:Name="FailureMascot" Mood="Sad" />
                    <Border Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="3">
                        <FontIcon Glyph="&#xEA39;" FontSize="16" IsTextScaleFactorEnabled="False"
                                 Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </Grid>
                <Grid x:Name="RestartIcon" Width="{x:Bind controls:OnboardingMascot.HeroSize}" Height="{x:Bind controls:OnboardingMascot.HeroSize}"
                      HorizontalAlignment="Center" Margin="0,0,0,16"
                      Visibility="Collapsed">
                    <controls:OnboardingMascot x:Name="RestartMascot" Mood="Thinking" />
                    <Border Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorCautionBrush}"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="3">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" IsTextScaleFactorEnabled="False"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </Grid>
            </StackPanel>
        </controls:SetupPageShell.Hero>
        <controls:SetupPageShell.Header>
            <StackPanel Spacing="12">
                <TextBlock x:Name="TitleText" Text="All set!"
                           FontFamily="Segoe UI Variable" FontSize="40" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"
                           TextWrapping="Wrap" TextAlignment="Left" />

                <TextBlock x:Name="SubtitleText" Text="OpenClaw is ready to go"
                           FontFamily="Segoe UI Variable" FontSize="18"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Left" />
            </StackPanel>
        </controls:SetupPageShell.Header>
        <controls:SetupPageShell.Body>
            <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                <TextBlock x:Uid="Onboarding_Complete_RestartGuidance"
                           Text="Save your work first. Restarting Windows restarts this computer, not just OpenClaw. You can choose not to restart now and reopen OpenClaw after you restart."
                           Visibility="{Binding Visibility, ElementName=RestartIcon}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="SummaryPanel" Spacing="0" Visibility="Collapsed">
                    <Border Style="{StaticResource CompletionRow}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="GatewaySummaryTitle" Text="Local gateway running" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="GatewaySummaryText" Text="OpenClawGateway · 127.0.0.1:18789" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="LocalAiSummaryCard"
                            AutomationProperties.AutomationId="LocalAiCompletionSummary"
                            Style="{StaticResource CompletionRow}"
                            Visibility="Collapsed">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LocalAiSummaryTitle" Text="Local AI installed"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="LocalAiSummaryDescription"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="DevicePairedSummaryCard" Style="{StaticResource CompletionRow}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xE772;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Device paired" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="This PC is connected and ready to use" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CompletionRow}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xEA18;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Capability profile applied" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CapabilitySummaryText" Text="Editable any time in Companion Settings"
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="NativeFeaturesNote" x:Uid="Onboarding_Native_FeaturesNote"
                               Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="These Windows capabilities become usable after Node Mode connects and pairs with the Gateway. Windows permissions and command approvals still apply." />
                </StackPanel>

                <Border x:Name="ErrorCard" CornerRadius="4" Padding="16,12,16,12"
                        Margin="0,16,0,0" Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontSize="13" FontFamily="Cascadia Code,Consolas,monospace"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ServerDiagnosticsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Visibility="Collapsed"
                                   FontSize="12" FontFamily="Cascadia Code,Consolas,monospace"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Name="HelpLink"
                                         Visibility="Collapsed"
                                         Padding="0"
                                         ContentTemplate="{StaticResource WrappedDiagnosticLink}"
                                         FontSize="13" />
                        <HyperlinkButton x:Name="ViewLogLink" Content="View full log →"
                                         Click="ViewLog_Click" Padding="0"
                                         ContentTemplate="{StaticResource WrappedDiagnosticLink}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                         FontSize="13" />
                        <HyperlinkButton x:Name="ViewServerLogLink"
                                         Visibility="Collapsed"
                                         Click="ViewServerLog_Click" Padding="0"
                                         ContentTemplate="{StaticResource WrappedDiagnosticLink}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                         FontSize="13" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="NodeModeBanner"
                         IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="Node mode enabled"
                         Message="The gateway can use this PC for screen capture, camera, and system commands." />

                <Border x:Name="StartupRow"
                        Style="{StaticResource CompletionRow}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Launch OpenClaw at startup"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1"
                                      OnContent="On" OffContent="Off"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      MinWidth="0" />
                    </Grid>
                </Border>

            </StackPanel>
        </controls:SetupPageShell.Body>
        <controls:SetupPageShell.Footer>
        <Grid x:Name="CompleteFooter" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button x:Name="FallbackButton" Grid.Column="0"
                    Content="Retry with configured fallback"
                    Visibility="Collapsed"
                    MinWidth="100" MinHeight="40" ContentTemplate="{StaticResource WrappedCompletionAction}"
                    Click="FallbackButton_Click" />
            <Button x:Name="RestartLaterButton" Grid.Column="0"
                    Content="No, I'm not ready yet"
                    Visibility="Collapsed"
                    MinWidth="100" MinHeight="40" ContentTemplate="{StaticResource WrappedCompletionAction}"
                    Click="RestartLaterButton_Click" />
            <Button x:Name="LaunchButton" Grid.Column="2"
                    Content="Open chat"
                    HorizontalAlignment="Right" MinWidth="100" MinHeight="40" ContentTemplate="{StaticResource WrappedCompletionAction}"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="LaunchButton_Click" />
            <Button x:Name="RestartNowButton" Grid.Column="2"
                    Content="Yes, restart now"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    MinWidth="100" MinHeight="40" ContentTemplate="{StaticResource WrappedCompletionAction}"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="RestartNowButton_Click" />
        </Grid>
        </controls:SetupPageShell.Footer>
    </controls:SetupPageShell>
</Page>
