<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.SetupNativeConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <DataTemplate x:Key="WrappedFooterAction">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <controls:SetupPageShell x:Name="ConnectionShell">
        <controls:SetupPageShell.Hero>
            <StackPanel Spacing="16">
                <Grid MaxWidth="280" HorizontalAlignment="Center" RowDefinitions="Auto,10">
                    <Border Padding="16,12" CornerRadius="12" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <TextBlock x:Name="SpeechText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <Path Grid.Row="1" Data="M0,0 L10,10 L20,0" HorizontalAlignment="Center"
                          Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <controls:OnboardingMascot x:Name="MascotHero" Mood="Curious" HorizontalAlignment="Center" />
                <controls:SetupStepIndicator x:Name="FlowProgress" Margin="24,8,0,0" />
            </StackPanel>
        </controls:SetupPageShell.Hero>
        <controls:SetupPageShell.Header>
            <StackPanel Spacing="12">
                <TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable" FontSize="40" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" FontFamily="Segoe UI Variable" FontSize="18"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </controls:SetupPageShell.Header>
        <controls:SetupPageShell.Body>
            <StackPanel Spacing="8">
                <ContentControl x:Name="Editor" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <toolkit:SettingsCard x:Name="AddressCard" HorizontalContentAlignment="Stretch"
                                         Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0,12">
                        <TextBox x:Name="AddressInput" TextChanged="Input_Changed" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="CodeCard" HorizontalContentAlignment="Stretch"
                                         Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12">
                        <PasswordBox x:Name="CodeInput" PasswordChanged="Secret_Changed" MaxLength="2048" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="TokenCard" HorizontalContentAlignment="Stretch"
                                         Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12">
                        <PasswordBox x:Name="TokenInput" PasswordChanged="Secret_Changed" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsExpander x:Name="SshExpander" Background="Transparent"
                                              BorderThickness="0,1,0,0" CornerRadius="0">
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="SshEnabledCard" Background="Transparent"
                                                 BorderThickness="0" CornerRadius="0" Padding="0,12">
                                <ToggleSwitch x:Name="SshEnabled" Toggled="Ssh_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="SshHostCard" HorizontalContentAlignment="Stretch"
                                                 Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12">
                                <TextBox x:Name="SshHostInput" TextChanged="Input_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="SshUserCard" HorizontalContentAlignment="Stretch"
                                                 Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12">
                                <TextBox x:Name="SshUserInput" TextChanged="Input_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="SshPortCard" Background="Transparent"
                                                 BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12">
                                <NumberBox x:Name="SshPortInput" Value="22" Minimum="1" Maximum="65535"
                                           ValueChanged="Port_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="RemotePortCard" Background="Transparent"
                                                 BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12">
                                <NumberBox x:Name="RemotePortInput" Value="18789" Minimum="1" Maximum="65535"
                                           ValueChanged="Port_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="LocalPortCard" Background="Transparent"
                                                 BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12">
                                <NumberBox x:Name="LocalPortInput" Value="18789" Minimum="1" Maximum="65535"
                                           ValueChanged="Port_Changed" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                  </StackPanel>
                </ContentControl>
            </StackPanel>
        </controls:SetupPageShell.Body>
        <controls:SetupPageShell.Footer>
            <Grid x:Name="NavigationFooter" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <InfoBar x:Name="ResultBar" Grid.ColumnSpan="4" HorizontalAlignment="Stretch"
                         IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="BackButton" Grid.Row="1" Click="Back_Click" MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch"
                        ContentTemplate="{StaticResource WrappedFooterAction}" />
                <Button x:Name="CancelButton" Grid.Row="1" Grid.Column="1" Click="Cancel_Click" Visibility="Collapsed"
                        MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch" ContentTemplate="{StaticResource WrappedFooterAction}" />
                <Button x:Name="CheckButton" Grid.Row="1" Grid.Column="2" Click="Check_Click"
                        MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch" ContentTemplate="{StaticResource WrappedFooterAction}" />
                <Button x:Name="NextButton" Grid.Row="1" Grid.Column="3" Click="Next_Click" MinWidth="0" MinHeight="40"
                        HorizontalAlignment="Stretch" ContentTemplate="{StaticResource WrappedFooterAction}"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </controls:SetupPageShell.Footer>
    </controls:SetupPageShell>
</Page>
