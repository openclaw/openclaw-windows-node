<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.SetupNativeConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="WrappedFooterAction">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="24">
        <StackPanel Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Name="TitleText" Style="{StaticResource SetupHeroTitleTextStyle}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource SetupHeroSubtitleTextStyle}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="{StaticResource SetupGutterMargin}">
                <ContentControl x:Name="Editor" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <toolkit:SettingsCard x:Name="AddressCard" HorizontalContentAlignment="Stretch">
                        <TextBox x:Name="AddressInput" TextChanged="Input_Changed" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="CodeCard" HorizontalContentAlignment="Stretch">
                        <PasswordBox x:Name="CodeInput" PasswordChanged="Secret_Changed" MaxLength="2048" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="TokenCard" HorizontalContentAlignment="Stretch">
                        <PasswordBox x:Name="TokenInput" PasswordChanged="Secret_Changed" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsExpander x:Name="SshExpander">
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="SshEnabledCard">
                                <ToggleSwitch x:Name="SshEnabled" Toggled="Ssh_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="SshHostCard" HorizontalContentAlignment="Stretch">
                                <TextBox x:Name="SshHostInput" TextChanged="Input_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="SshUserCard" HorizontalContentAlignment="Stretch">
                                <TextBox x:Name="SshUserInput" TextChanged="Input_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="SshPortCard">
                                <NumberBox x:Name="SshPortInput" Value="22" Minimum="1" Maximum="65535"
                                           ValueChanged="Port_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="RemotePortCard">
                                <NumberBox x:Name="RemotePortInput" Value="18789" Minimum="1" Maximum="65535"
                                           ValueChanged="Port_Changed" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard x:Name="LocalPortCard">
                                <NumberBox x:Name="LocalPortInput" Value="18789" Minimum="1" Maximum="65535"
                                           ValueChanged="Port_Changed" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                  </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
        <InfoBar x:Name="ResultBar" Grid.Row="2" Margin="{StaticResource SetupGutterMargin}" HorizontalAlignment="Stretch"
                 IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite" />
        <Grid x:Name="NavigationFooter" Grid.Row="3" RowDefinitions="Auto"
              ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="{StaticResource SetupGutterMargin}">
            <Button x:Name="BackButton" Click="Back_Click" MinHeight="40" MinWidth="0" HorizontalAlignment="Stretch"
                    ContentTemplate="{StaticResource WrappedFooterAction}" />
            <Button x:Name="CancelButton" Grid.Column="1" MinHeight="40" Click="Cancel_Click" Visibility="Collapsed"
                    MinWidth="0" HorizontalAlignment="Stretch" ContentTemplate="{StaticResource WrappedFooterAction}" />
            <Button x:Name="CheckButton" Grid.Column="2" MinHeight="40" Click="Check_Click"
                    MinWidth="0" HorizontalAlignment="Stretch" ContentTemplate="{StaticResource WrappedFooterAction}" />
            <Button x:Name="NextButton" Grid.Column="3" MinHeight="40" Click="Next_Click" MinWidth="0"
                    HorizontalAlignment="Stretch" ContentTemplate="{StaticResource WrappedFooterAction}"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
