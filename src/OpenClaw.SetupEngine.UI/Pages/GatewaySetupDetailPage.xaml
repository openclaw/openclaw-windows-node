<Page x:Class="OpenClaw.SetupEngine.UI.Pages.GatewaySetupDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="WrappedChoiceTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">
        <StackPanel Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Name="DetailTitle" Style="{StaticResource SetupHeroTitleTextStyle}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="{StaticResource SetupBodyMargin}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12" Margin="{StaticResource SetupGutterMargin}">
                <controls:LocalAiSetupControl x:Name="LocalAiOptions" Visibility="Collapsed" />
                <InfoBar x:Name="LocalAiReviewError" IsOpen="False" IsClosable="False" Severity="Error" />
                <controls:TailscaleSetupControl x:Name="TailscaleOptions" Visibility="Collapsed" />
                <StackPanel x:Name="NetworkingOptions" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Uid="Onboarding_V2_NetworkExplanation" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Text="Local AI needs mirrored WSL networking. Installation will update the global .wslconfig and stop all running WSL distributions once. No distributions are deleted. Save your WSL work first." />
                    <CheckBox x:Name="LocalAiNetworkingConsentCheckBox" x:Uid="Onboarding_V2_NetworkConsent"
                              ContentTemplate="{StaticResource WrappedChoiceTemplate}"
                              AutomationProperties.AutomationId="LocalAiNetworkingConsentCheckBox"
                              Content="I allow this global networking change and one-time WSL shutdown."
                              Checked="NetworkConsent_Changed" Unchecked="NetworkConsent_Changed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <controls:SetupFooterPanel Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}">
            <Button x:Uid="Onboarding_V2_Back" Content="Back" Style="{StaticResource SetupSecondaryButtonStyle}" Click="Back_Click" />
            <Button x:Name="PrimaryButton" x:Uid="Onboarding_V2_ReturnToReview" Content="Return to review"
                    Click="Primary_Click" Style="{StaticResource SetupPrimaryButtonStyle}" />
        </controls:SetupFooterPanel>
    </Grid>
</Page>
