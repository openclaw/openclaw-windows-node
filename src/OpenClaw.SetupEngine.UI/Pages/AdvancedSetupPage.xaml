<Page x:Class="OpenClaw.SetupEngine.UI.Pages.AdvancedSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">
        <StackPanel Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Uid="Onboarding_V2_AlternativesTitle" Text="Choose another setup route" Style="{StaticResource SetupHeroTitleTextStyle}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="{StaticResource SetupBodyMargin}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8" Margin="{StaticResource SetupGutterMargin}">
                <StackPanel x:Name="RouteRows" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SetupHairlineBrush}">
                <tk:SettingsCard x:Name="ExistingRouteCard" x:Uid="Onboarding_V2_ExistingRoute" Header="Existing Gateway"
                                 Description="Use a saved or existing connection. No WSL installation."
                                 IsClickEnabled="True" Click="Existing_Click" />
                <tk:SettingsCard x:Name="RemoteRouteCard" x:Uid="Onboarding_V2_RemoteRoute" Header="Remote Gateway"
                                 Description="Use the native address, setup code or SSH connection editor."
                                 IsClickEnabled="True" Click="Remote_Click" />
                <tk:SettingsCard x:Name="McpRouteCard" x:Uid="Onboarding_V2_McpRoute" Header="Local MCP only"
                                 Description="Enable local MCP without a Gateway. Review PC capabilities next."
                                 IsClickEnabled="True" Click="Mcp_Click" />
                <tk:SettingsCard x:Name="DeferredRouteCard" x:Uid="Onboarding_V2_DeferredRoute" Header="Set up a Gateway later"
                                 Description="Review your choices without installing WSL or changing saved Gateways."
                                 IsClickEnabled="True" Click="Deferred_Click" />
                </StackPanel>
                <InfoBar x:Name="HostUnavailable" x:Uid="Onboarding_V2_HostUnavailable"
                         IsOpen="False" IsClosable="False" Severity="Informational"
                         Title="Connection editor is unavailable in this setup host"
                         Message="Open setup from the Companion app to use its native connection editor." />
                <HyperlinkButton x:Name="ClassicSettingsLink" x:Uid="Onboarding_V2_ClassicSettings" Style="{StaticResource SetupLinkButtonStyle}"
                                 Content="Open classic Connection settings" Click="ClassicSettings_Click" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}">
            <Button x:Uid="Onboarding_V2_Back" Content="Back" Style="{StaticResource SetupSecondaryButtonStyle}" Click="Back_Click" />
        </StackPanel>
    </Grid>
</Page>
