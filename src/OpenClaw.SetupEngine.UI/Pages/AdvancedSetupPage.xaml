<Page x:Class="OpenClaw.SetupEngine.UI.Pages.AdvancedSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Grid Padding="40,4,40,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
            <controls:OnboardingMascot x:Name="MascotHero" Mood="Curious" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Onboarding_V2_AlternativesTitle" Text="Choose another setup route" Style="{StaticResource TitleTextBlockStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" MaxWidth="600" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <tk:SettingsCard x:Uid="Onboarding_V2_ExistingRoute" Header="Existing Gateway"
                                 Description="Use a saved or existing connection. No WSL installation."
                                 IsClickEnabled="True" Click="Existing_Click" />
                <tk:SettingsCard x:Uid="Onboarding_V2_RemoteRoute" Header="Remote Gateway"
                                 Description="Use the native address, setup code or SSH connection editor."
                                 IsClickEnabled="True" Click="Remote_Click" />
                <tk:SettingsCard x:Uid="Onboarding_V2_McpRoute" Header="Local MCP only"
                                 Description="Enable local MCP without a Gateway. Review PC capabilities next."
                                 IsClickEnabled="True" Click="Mcp_Click" />
                <tk:SettingsCard x:Uid="Onboarding_V2_DeferredRoute" Header="Set up a Gateway later"
                                 Description="Review your choices without installing WSL or changing saved Gateways."
                                 IsClickEnabled="True" Click="Deferred_Click" />
                <InfoBar x:Name="HostUnavailable" x:Uid="Onboarding_V2_HostUnavailable"
                         IsOpen="False" IsClosable="False" Severity="Informational"
                         Title="Connection editor is unavailable in this setup host"
                         Message="Open setup from the Companion app to use its native connection editor." />
                <HyperlinkButton x:Name="ClassicSettingsLink" x:Uid="Onboarding_V2_ClassicSettings"
                                 Content="Open classic Connection settings" Click="ClassicSettings_Click" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <controls:SetupProgressIndicator x:Name="FlowProgress" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Uid="Onboarding_V2_Back" Content="Back" MinWidth="100" HorizontalAlignment="Left" Click="Back_Click" />
        </Grid>
    </Grid>
</Page>
