<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.SecurityNoticePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Uid="Onboarding_V2_WelcomeTitle" Text="Meet your new sidekick."
                       Style="{StaticResource SetupHeroTitleTextStyle}" />
            <TextBlock x:Name="WelcomeDescription" x:Uid="Onboarding_Flow_WelcomeDescription"
                       Style="{StaticResource SetupHeroSubtitleTextStyle}"
                       Text="OpenClaw connects an AI assistant to the tools on your PC. You choose what it can do, and you can change that any time." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,36,0,16" HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource SetupGutterMargin}" RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="0">
                    <tk:SettingsCard x:Name="PcFeature" x:Uid="Onboarding_V2_WelcomePc"
                                     Header="Let agents help on this PC" Description="Choose which PC capabilities to enable. Windows permissions and execution approvals remain separate." />
                    <tk:SettingsCard x:Name="GatewayFeature" x:Uid="Onboarding_V2_WelcomeGateway"
                                     Header="Keep your Gateway under your control" Description="Run a private Gateway on this PC or connect to an existing one." />
                    <tk:SettingsCard x:Name="ChatFeature" x:Uid="Onboarding_V2_WelcomeChat" BorderThickness="0"
                                     Header="Chat with your AI" Description="Use native Chat with an AI provider you choose." />
                </StackPanel>
                <Grid x:Name="SafetyNote" Grid.Row="2" Margin="0,24,0,0" Padding="0,16,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                      BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SetupHairlineBrush}">
                    <FontIcon Glyph="&#xE83D;" FontSize="16" Margin="0,2,0,0" VerticalAlignment="Top"
                              IsTextScaleFactorEnabled="False" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="SafetyTitle" Text="Before you get started" Style="{StaticResource SetupRowTitleTextStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="SafetyText" x:Uid="Onboarding_Welcome_Safety" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="AI agents are powerful, and giving them access to your PC carries risks. They can make mistakes, change or delete files, or expose private information. You can control and limit OpenClaw’s access to your PC." />
                        <HyperlinkButton x:Uid="Onboarding_Copy_SafetyLink" Content="Learn more about risks and safety"
                                         Style="{StaticResource SetupLinkButtonStyle}"
                                         NavigateUri="https://trust.openclaw.ai">
                            <HyperlinkButton.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                                </DataTemplate>
                            </HyperlinkButton.ContentTemplate>
                        </HyperlinkButton>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <controls:SetupFooterPanel Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}">
            <Button x:Name="ContinueButton" x:Uid="Onboarding_V2_Continue" Content="Continue"
                    Style="{StaticResource SetupPrimaryButtonStyle}"
                    Click="Continue_Click" />
        </controls:SetupFooterPanel>
    </Grid>
</Page>
