<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:icons="using:OpenClawTray.Helpers"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">
        <VisualStateManager.VisualStateGroups>
            <!-- Recommendation only moves the inline label; the accent tile follows selection. -->
            <VisualStateGroup>
                <VisualState x:Name="WslRecommendedState" />
                <VisualState x:Name="NativeRecommendedState" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Uid="Onboarding_Copy_GatewayTitle" Text="Where should OpenClaw live?"
                       Style="{StaticResource SetupHeroTitleTextStyle}" />
            <TextBlock x:Uid="Onboarding_Copy_GatewayIntro" Style="{StaticResource SetupHeroSubtitleTextStyle}"
                       Text="The Gateway connects your AI assistant to your apps and tools. Choose where it runs. You can change this later." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,28,0,16"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsTabStop="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Margin="{StaticResource SetupGutterMargin}">
            <ListView x:Name="GatewayChoiceSelector" x:Uid="Onboarding_Copy_GatewaySelector"
                      AutomationProperties.Name="Gateway setup method"
                      AutomationProperties.HelpText="Choose one gateway setup method."
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      SelectionMode="Single"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      SelectionChanged="GatewayChoice_SelectionChanged">
                <ListViewItem x:Name="InstallChoice" x:Uid="Onboarding_Copy_GatewayLocalChoice"
                              AutomationProperties.AutomationId="WelcomeInstallLocalGatewayChoice"
                              AutomationProperties.Name="Install a local Gateway (WSL), recommended"
                              AutomationProperties.LiveSetting="Polite"
                              HorizontalContentAlignment="Stretch" Style="{StaticResource SetupChoiceItemStyle}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <controls:SetupGlyphTile x:Name="WslIconBackground" Glyph="&#xE756;" />
                        <StackPanel Grid.Column="1" Spacing="2" Margin="0,12,16,12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="InstallTitle" x:Uid="Onboarding_Copy_GatewayLocalTitle"
                                           Text="Install a local Gateway (WSL)" TextWrapping="Wrap"
                                           Style="{StaticResource SetupRowTitleTextStyle}"
                                           VerticalAlignment="Center" />
                                <ProgressRing x:Name="InstallCheckProgress"
                                              AutomationProperties.AutomationId="WelcomeInstallCheckProgress"
                                              AutomationProperties.Name="Checking WSL readiness and existing setup"
                                              Width="16" Height="16"
                                              IsActive="False" Visibility="Collapsed" />
                                <controls:RecommendedBadge x:Name="WslRecommendedBadge" />
                            </StackPanel>
                            <TextBlock x:Uid="Onboarding_Copy_GatewayLocalDescription"
                                       Style="{StaticResource SetupRowDescriptionTextStyle}"
                                       Text="Install a private OpenClaw Gateway in WSL." />
                        </StackPanel>
                        <Rectangle x:Name="InstallSeparator" Grid.Column="1"
                                   VerticalAlignment="Bottom" Style="{StaticResource SetupHairlineStyle}" />
                    </Grid>
                </ListViewItem>

                <ListViewItem x:Name="ConnectChoice" x:Uid="Onboarding_Copy_GatewayExistingChoice"
                              AutomationProperties.AutomationId="WelcomeConnectExistingGatewayChoice"
                              AutomationProperties.Name="Connect to an existing Gateway"
                              HorizontalContentAlignment="Stretch" Style="{StaticResource SetupChoiceItemStyle}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <controls:SetupGlyphTile Glyph="&#xE71B;" />
                        <StackPanel Grid.Column="1" Spacing="2" Margin="0,12,16,12" VerticalAlignment="Center">
                            <TextBlock x:Uid="Onboarding_Copy_GatewayExistingTitle" Text="Connect to an existing Gateway"
                                       Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Uid="Onboarding_Copy_GatewayExistingDescription"
                                       Style="{StaticResource SetupRowDescriptionTextStyle}"
                                       Text="Connect without installing a Gateway or Local AI on this PC." />
                        </StackPanel>
                        <Rectangle x:Name="ConnectSeparator" Grid.Column="1"
                                   VerticalAlignment="Bottom" Style="{StaticResource SetupHairlineStyle}" />
                    </Grid>
                </ListViewItem>
                <ListViewItem x:Name="NativeChoice"
                              AutomationProperties.AutomationId="WelcomeNativeGatewayChoice"
                              AutomationProperties.Name="Install a local native gateway, recommended"
                              IsEnabled="False" HorizontalContentAlignment="Stretch" Style="{StaticResource SetupChoiceItemStyle}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <controls:SetupGlyphTile x:Name="NativeIconBackground" Glyph="&#xE770;" />
                        <StackPanel Grid.Column="1" Spacing="2" Margin="0,12,16,12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="Onboarding_Native_Title" Text="Install a local native gateway"
                                           Style="{StaticResource SetupRowTitleTextStyle}" />
                                <controls:RecommendedBadge x:Name="NativeRecommendedBadge" />
                            </StackPanel>
                            <TextBlock x:Uid="Onboarding_Native_Description"
                                       Text="Install and set up an OpenClaw gateway on this device"
                                       Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <Rectangle x:Name="NativeSeparator" Grid.Column="1"
                                   VerticalAlignment="Bottom" Style="{StaticResource SetupHairlineStyle}" />
                    </Grid>
                </ListViewItem>
            </ListView>
            <Grid x:Name="NativeSupportCard" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                  AutomationProperties.AutomationId="WelcomeNativeSupportCard">
                <FontIcon Glyph="&#xE946;" FontSize="14" Margin="0,1,0,0" VerticalAlignment="Top"
                          IsTextScaleFactorEnabled="False" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <StackPanel x:Name="NativeSupportStatusPanel" Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="NativeCheckProgress" Width="14" Height="14"
                                      IsActive="True" AutomationProperties.Name="Checking native gateway support" />
                        <TextBlock x:Name="NativeSupportStatus" TextWrapping="Wrap" MaxWidth="500"
                                   AutomationProperties.AutomationId="WelcomeNativeSupportStatus"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource SetupFootnoteTextStyle}" />
                    </StackPanel>
                    <Button x:Name="WindowsUpdateButton" x:Uid="Onboarding_Native_WindowsUpdate"
                            Content="Open Windows Update" Visibility="Collapsed"
                            AutomationProperties.AutomationId="WelcomeWindowsUpdate"
                            Click="WindowsUpdate_Click" />
                </StackPanel>
            </Grid>
            <tk:SettingsCard x:Name="LocalAiAvailabilityPanel" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                             AutomationProperties.AutomationId="WelcomeLocalAiAvailable"
                             AutomationProperties.LiveSetting="Polite">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{x:Bind icons:FluentIconCatalog.StatusOk}" FontSize="16"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="Onboarding_Welcome_LocalAiAvailableBadge"
                               Text="Your PC supports Local AI" TextWrapping="Wrap"
                               Style="{StaticResource SetupRowTitleTextStyle}" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="LocalAiAvailabilityText"
                               Style="{StaticResource SetupRowDescriptionTextStyle}" />
                </tk:SettingsCard.Description>
            </tk:SettingsCard>
            <InfoBar x:Name="ReadinessError" IsOpen="False" IsClosable="False" Severity="Error">
                <InfoBar.ActionButton>
                    <Button x:Uid="Onboarding_V2_Retry" Content="Try again" Click="Next_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <HyperlinkButton x:Uid="Onboarding_V2_AlternativeRoutes" Content="Remote, local MCP or set up later"
                             Style="{StaticResource SetupLinkButtonStyle}" Click="Alternatives_Click" />
          </StackPanel>
        </ScrollViewer>

        <controls:SetupFooterPanel Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}">
            <Button x:Name="BackButton" x:Uid="Onboarding_V2_Back" AutomationProperties.AutomationId="WelcomeBackButton"
                    Content="Back" Style="{StaticResource SetupSecondaryButtonStyle}"
                    Click="Back_Click" />
            <Button x:Name="NextButton" x:Uid="Onboarding_V2_Next" AutomationProperties.AutomationId="WelcomeNextButton"
                    Content="Next" Style="{StaticResource SetupPrimaryButtonStyle}"
                    Click="Next_Click" />
        </controls:SetupFooterPanel>
    </Grid>
</Page>
