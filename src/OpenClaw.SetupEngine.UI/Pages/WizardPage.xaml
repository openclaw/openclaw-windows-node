<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.WizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <DataTemplate x:Key="WrappedFooterAction">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <controls:SetupPageShell x:Name="WizardShell">
        <controls:SetupPageShell.Hero>
            <StackPanel Spacing="16">
                <Grid MaxWidth="280" HorizontalAlignment="Center" RowDefinitions="Auto,10">
                    <Border Padding="16,12" CornerRadius="12" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <TextBlock x:Name="SpeechText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <Path Grid.Row="1" Data="M0,0 L10,10 L20,0" HorizontalAlignment="Center"
                          Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <controls:OnboardingMascot x:Name="MascotHero" Mood="Thinking" HorizontalAlignment="Center" />
                <controls:SetupStepIndicator x:Name="FlowProgress" Margin="24,8,0,0" />
            </StackPanel>
        </controls:SetupPageShell.Hero>
        <controls:SetupPageShell.Header>
            <StackPanel Spacing="12">
                <TextBlock x:Name="HeadingText" Text="OpenClaw onboard"
                           FontFamily="Segoe UI Variable" FontSize="40" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Text="Connecting to gateway..."
                           FontFamily="Segoe UI Variable" FontSize="18"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </controls:SetupPageShell.Header>

        <controls:SetupPageShell.Body>
        <ScrollViewer x:Name="MainScroller" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" IsTabStop="False">
            <StackPanel Spacing="12">
            <StackPanel x:Name="TranscriptPanel" Spacing="6" />
            <Border x:Name="StepCard"
                    CornerRadius="0"
                    Padding="0,16"
                    MinHeight="180"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="Transparent">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                    <RichTextBlock x:Name="MessageBlock" Visibility="Collapsed"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   FontSize="14" Opacity="0.82" />
                    <StackPanel x:Name="MessageCodeRows" Spacing="8" />
                    <Border x:Name="ConsoleBanner"
                            Visibility="Collapsed"
                            CornerRadius="0"
                            Padding="0,12"
                            Background="Transparent"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Live gateway output"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <RichTextBlock x:Name="ConsoleBannerBlock"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                           FontSize="13" Opacity="0.92"
                                           FontFamily="Consolas" />
                            <StackPanel x:Name="ConsoleBannerLines" Spacing="6" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ConsoleRecovery" Visibility="Collapsed" Spacing="8">
                        <TextBlock x:Name="ConsoleIssueText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <Button x:Name="ConsoleRecoveryTerminalButton" Content="Open terminal" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="WizardConsoleRecoveryTerminal"
                                Click="OpenGatewayTerminal_Click" />
                    </StackPanel>
                    <ListView x:Name="SelectOptions" Visibility="Collapsed" SelectionMode="Single"
                              AutomationProperties.LabeledBy="{Binding ElementName=TitleText}" />
                    <StackPanel x:Name="MultiOptions" Visibility="Collapsed" Spacing="8" />
                    <TextBox x:Name="TextInput" Visibility="Collapsed" PlaceholderText="Enter value"
                             AutomationProperties.LabeledBy="{Binding ElementName=TitleText}" />
                    <PasswordBox x:Name="SecretInput" Visibility="Collapsed" PlaceholderText="Enter value"
                                 AutomationProperties.LabeledBy="{Binding ElementName=TitleText}" />
                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               AutomationProperties.LiveSetting="Assertive"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                    <Grid x:Name="GatewayRecovery" Visibility="Collapsed" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button x:Name="OpenGatewayTerminalButton"
                                Content="Open terminal"
                                MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch"
                                ContentTemplate="{StaticResource WrappedFooterAction}"
                                Click="OpenGatewayTerminal_Click" />
                        <Button x:Name="RestartGatewayButton"
                                Grid.Column="1"
                                Content="Restart gateway"
                                MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch"
                                ContentTemplate="{StaticResource WrappedFooterAction}"
                                Click="RestartGateway_Click" />
                    </Grid>
                    <ProgressRing x:Name="BusyRing" Width="32" Height="32" IsActive="True" HorizontalAlignment="Center" Foreground="{ThemeResource SetupIndicatorAccentBrush}" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
        </controls:SetupPageShell.Body>

        <controls:SetupPageShell.Footer>
        <Grid x:Name="NavigationFooter" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <DropDownButton x:Name="MoreOptionsButton"
                            Content="More options"
                            MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch"
                            ContentTemplate="{StaticResource WrappedFooterAction}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Visibility="Collapsed"
                            AutomationProperties.Name="More onboarding options">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem Text="Restart onboard" Click="StartOver_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" IsTextScaleFactorEnabled="False" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SkipWizardMenuItem" Text="Skip &amp; exit" Click="SkipWizard_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72A;" IsTextScaleFactorEnabled="False" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button x:Name="SecondaryButton" Grid.Column="1" Content="Skip"
                    MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch"
                    ContentTemplate="{StaticResource WrappedFooterAction}"
                    Click="Secondary_Click" IsEnabled="False" />
            <Button x:Name="PrimaryButton" Grid.Column="2" Content="Continue"
                    MinWidth="0" MinHeight="40" HorizontalAlignment="Stretch"
                    ContentTemplate="{StaticResource WrappedFooterAction}"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Primary_Click" IsEnabled="False" />
        </Grid>
        </controls:SetupPageShell.Footer>
    </controls:SetupPageShell>
</Page>
