<Page x:Class="OpenClaw.SetupEngine.UI.Pages.GatewaySetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">
        <StackPanel Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Uid="Onboarding_V2_ReviewTitle" Text="Ready to install" Style="{StaticResource SetupHeroTitleTextStyle}" />
            <TextBlock x:Uid="Onboarding_V2_ReviewIntro" Text="Here’s what will happen on this PC."
                       Style="{StaticResource SetupHeroSubtitleTextStyle}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="{StaticResource SetupBodyMargin}" HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="{StaticResource SetupGutterMargin}">
                <Grid x:Name="ReviewRequired" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top" IsTextScaleFactorEnabled="False"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="ReviewRequiredTitle" Style="{StaticResource SetupRowTitleTextStyle}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ReviewRequiredText" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="PlanRows" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SetupHairlineBrush}">
                    <tk:SettingsCard x:Name="DistroCard">
                        <TextBlock x:Name="DistroDetail" Style="{StaticResource SetupMonoTextStyle}" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="CliCard" x:Uid="Onboarding_V2_CliCard" Header="OpenClaw CLI">
                        <TextBlock x:Name="CliDetail" Style="{StaticResource SetupMonoTextStyle}" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="GatewayCard" x:Uid="Onboarding_V2_GatewayCard" Header="Local Gateway service">
                        <TextBlock x:Name="GatewayDetail" Style="{StaticResource SetupMonoTextStyle}" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="LocalAiCard" x:Uid="Onboarding_V2_LocalAiReview" Header="Local AI"
                                     IsClickEnabled="True" Click="LocalAi_Click" />
                    <controls:TailscaleSetupControl x:Name="TailscaleOptions" />
                    <tk:SettingsCard x:Name="StartupPreferenceRow" x:Uid="Onboarding_V2_StartupCard" Header="Launch OpenClaw at sign-in">
                        <ToggleSwitch x:Name="StartupPreferenceToggle" x:Uid="Onboarding_Flow_AutoStartToggle"
                                      AutomationProperties.Name="Launch OpenClaw at sign-in"
                                      OnContent="" OffContent="" MinWidth="0" Toggled="Startup_Toggled" />
                    </tk:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="ReplacementOptions" Spacing="12" Visibility="Collapsed">
                    <Grid x:Name="ReplacementWarning" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top" IsTextScaleFactorEnabled="False"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="ReplacementWarningTitle" Style="{StaticResource SetupRowTitleTextStyle}" AutomationProperties.LiveSetting="Polite"
                                       Text="This replacement can permanently delete WSL data" />
                            <TextBlock x:Name="ReplacementWarningText" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ReplacementConsent" Checked="ReplacementConsent_Changed" Unchecked="ReplacementConsent_Changed">
                        <CheckBox.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                            </DataTemplate>
                        </CheckBox.ContentTemplate>
                    </CheckBox>
                </StackPanel>
                <HyperlinkButton x:Name="ExactCommandsLink" Style="{StaticResource SetupLinkButtonStyle}" Click="ExactCommands_Click" />
                <Border x:Name="ExactCommandsPanel" Visibility="Collapsed" CornerRadius="6" Padding="12,10"
                        Background="{ThemeResource SetupConsoleBackgroundBrush}">
                    <TextBlock x:Name="ExactCommandsText" TextWrapping="Wrap" Style="{StaticResource SetupMonoTextStyle}"
                               AutomationProperties.Name="Exact commands and files" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <controls:SetupFooterPanel Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}">
            <Button x:Uid="Onboarding_V2_Back" Content="Back" Style="{StaticResource SetupSecondaryButtonStyle}" Click="Back_Click" />
            <Button x:Name="PrimaryButton" Content="Install" Style="{StaticResource SetupPrimaryButtonStyle}" Click="Install_Click" />
        </controls:SetupFooterPanel>
    </Grid>
</Page>
