<Page x:Class="OpenClaw.SetupEngine.UI.Pages.GatewaySetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Grid Padding="40,4,40,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
            <controls:OnboardingMascot x:Name="MascotHero" Mood="Curious" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Onboarding_V2_ReviewTitle" Text="WSL Gateway setup" Style="{StaticResource TitleTextBlockStyle}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Uid="Onboarding_V2_ReviewIntro" Text="Review what will change before installation starts."
                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" MaxWidth="600" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <InfoBar x:Name="ReviewRequired" IsOpen="True" IsClosable="False" Severity="Warning"
                         AutomationProperties.LiveSetting="Polite" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="0">
                        <tk:SettingsCard x:Name="DistroCard" Background="Transparent" BorderThickness="0" CornerRadius="0" />
                        <tk:SettingsCard x:Name="CliCard" x:Uid="Onboarding_V2_CliCard" Header="OpenClaw CLI"
                                         Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" />
                        <tk:SettingsCard x:Name="GatewayCard" x:Uid="Onboarding_V2_GatewayCard" Header="Local Gateway service"
                                         Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ReplacementOptions" Spacing="12" Visibility="Collapsed">
                    <InfoBar x:Name="ReplacementWarning" x:Uid="Onboarding_V2_ReplacementWarning" IsOpen="True" IsClosable="False" Severity="Warning"
                             Title="This replacement can permanently delete WSL data"
                             AutomationProperties.LiveSetting="Polite" />
                    <CheckBox x:Name="ReplacementConsent" Checked="ReplacementConsent_Changed" Unchecked="ReplacementConsent_Changed">
                        <CheckBox.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="480" Style="{StaticResource BodyTextBlockStyle}" />
                            </DataTemplate>
                        </CheckBox.ContentTemplate>
                    </CheckBox>
                </StackPanel>
                <tk:SettingsCard x:Name="LocalAiCard" x:Uid="Onboarding_V2_LocalAiReview" Header="Local AI"
                                 IsClickEnabled="True" Click="LocalAi_Click" />
                <controls:TailscaleSetupControl x:Name="TailscaleOptions" />
                <tk:SettingsCard x:Name="StartupPreferenceRow" x:Uid="Onboarding_V2_StartupCard" Header="Launch OpenClaw at sign-in">
                    <ToggleSwitch x:Name="StartupPreferenceToggle" x:Uid="Onboarding_Flow_AutoStartToggle"
                                  AutomationProperties.Name="Launch OpenClaw at sign-in"
                                  OnContent="" OffContent="" MinWidth="0" Toggled="Startup_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsExpander x:Uid="Onboarding_V2_ExactCommands" Header="Exact commands and files">
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard>
                            <tk:SettingsCard.Header>
                                <TextBlock x:Name="ExactCommandsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           FontFamily="Cascadia Mono, Consolas" Style="{StaticResource CaptionTextBlockStyle}" />
                            </tk:SettingsCard.Header>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <controls:SetupProgressIndicator x:Name="FlowProgress" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Uid="Onboarding_V2_Back" Content="Back" MinWidth="100" HorizontalAlignment="Left" Click="Back_Click" />
            <Button Grid.Column="1" x:Name="PrimaryButton" Content="Install"
                    MinWidth="100" Click="Install_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
