<Page x:Class="OpenClaw.SetupEngine.UI.Pages.CapabilitiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Grid Padding="40,4,40,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
            <controls:OnboardingMascot x:Name="MascotHero" Mood="Curious" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Onboarding_V2_CapabilitiesTitle" Text="PC capabilities" Style="{StaticResource TitleTextBlockStyle}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Uid="Onboarding_V3_ProfileHelp" Text="Choose a preset. Open Fine-tune to inspect or change individual capabilities."
                       TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" MaxWidth="600"
                      HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock x:Name="NativeInstallConsent" x:Uid="Onboarding_Native_Review"
                           Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                           Text="By selecting Set up gateway, you authorize WinGet to install the missing Gateway package from Microsoft Store and accept the package and Store source agreements. Companion then verifies the package, prepares a dedicated profile, and opens Gateway setup. Provider sign-in stays interactive. This path does not install WSL, Local AI, or Tailscale." />
                <InfoBar x:Name="TransportRequired" x:Uid="Onboarding_V3_TransportRequired" IsOpen="True"
                         IsClosable="False" Severity="Informational" Title="Capabilities are unavailable"
                         Message="Turn on Node mode or Local MCP Server to use these capabilities. Your choices are kept." />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel x:Name="CapabilityControls" Spacing="0">
                    <ListView x:Name="ProfileSelector" x:Uid="Onboarding_V2_ProfileSelector"
                              AutomationProperties.Name="Capability profile"
                              SelectionMode="Single" SingleSelectionFollowsFocus="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="Profile_Changed">
                        <ListViewItem x:Name="ReadOnlyChoice" x:Uid="Onboarding_V2_ProfileReadOnly"
                                      AutomationProperties.Name="Strict: Canvas and screen capture. Command execution is off."
                                      HorizontalContentAlignment="Stretch" Padding="16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Onboarding_V2_ProfileReadOnlyTitle" Text="Strict"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="Onboarding_V2_ProfileReadOnlyDescription" Text="Canvas and screen capture. Command execution is off."
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem x:Name="StandardChoice" x:Uid="Onboarding_V2_ProfileStandard"
                                      AutomationProperties.Name="Balanced (Recommended): commands, Canvas, screen capture and voice."
                                      HorizontalContentAlignment="Stretch" Padding="16,12">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                    <TextBlock x:Uid="Onboarding_V2_ProfileStandardTitle" Text="Balanced"
                                               TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                    <controls:RecommendedBadge Grid.Column="1" />
                                </Grid>
                                <TextBlock x:Uid="Onboarding_V2_ProfileStandardDescription" Text="Commands, Canvas, screen capture and voice."
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem x:Name="FullChoice" x:Uid="Onboarding_V2_ProfileFull"
                                      AutomationProperties.Name="Open: all eight capabilities, including Camera, Location and Browser control."
                                      HorizontalContentAlignment="Stretch" Padding="16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Onboarding_V2_ProfileFullTitle" Text="Open"
                                           TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="Onboarding_V2_ProfileFullDescription" Text="All eight capabilities, including Camera, Location and Browser control."
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                    <tk:SettingsExpander x:Name="FineTuneExpander" IsExpanded="False"
                                         Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0"
                                         Expanded="FineTune_Changed" Collapsed="FineTune_Changed">
                        <tk:SettingsExpander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Onboarding_V3_FineTune" Text="Fine-tune"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CustomProfileText" x:Uid="Onboarding_V2_Custom" Text="Custom capabilities"
                                           Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </tk:SettingsExpander.Header>
                        <tk:SettingsExpander.Description>
                            <TextBlock x:Name="SelectedSummary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </tk:SettingsExpander.Description>
                        <tk:SettingsExpander.ItemsFooter>
                            <StackPanel Spacing="8" Padding="16,12">
                                <TextBlock x:Uid="Onboarding_V2_DeviceFixed" TextWrapping="Wrap"
                                           Text="Basic device information and status remain available while a node service is running. They are not a profile toggle."
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Uid="Onboarding_V2_NativeSettings" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="Execution approvals, sandbox grants, remembered capture consent, MCP tokens and voice configuration stay in Companion Settings." />
                            </StackPanel>
                        </tk:SettingsExpander.ItemsFooter>
                    </tk:SettingsExpander>
                </StackPanel>
                </Border>
                <TextBlock x:Uid="Onboarding_V4_ConnectionOptions" Text="Connection options" Margin="0,12,0,0"
                           Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Spacing="4">
                <tk:SettingsCard x:Uid="Onboarding_V2_NodeMode" Header="Node mode" Description="Offer this PC's capabilities through a connected Gateway.">
                    <ToggleSwitch x:Name="NodeModeToggle" x:Uid="Onboarding_V2_NodeModeToggle" AutomationProperties.Name="Node mode"
                                  OnContent="" OffContent="" MinWidth="0" Toggled="Transport_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Uid="Onboarding_V2_Mcp" Header="Local MCP Server" Description="Use local MCP clients without requiring a Gateway.">
                    <ToggleSwitch x:Name="McpToggle" x:Uid="Onboarding_V2_McpToggle" AutomationProperties.Name="Local MCP Server"
                                  OnContent="" OffContent="" MinWidth="0" Toggled="Transport_Toggled" />
                </tk:SettingsCard>
                </StackPanel>
                <tk:SettingsCard x:Uid="Onboarding_V2_Ollama" Header="Ollama sharing"
                                 Description="Share an existing Windows Ollama service. This does not install Local AI or change your capability profile.">
                    <ToggleSwitch x:Name="OllamaToggle" x:Uid="Onboarding_V2_OllamaToggle"
                                  AutomationProperties.Name="Ollama sharing" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="Ollama_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="StartupPreferenceRow" x:Uid="Onboarding_V2_StartupCard"
                                 Header="Launch OpenClaw at sign-in" Visibility="Collapsed">
                    <ToggleSwitch x:Name="StartupPreferenceToggle" x:Uid="Onboarding_Flow_AutoStartToggle"
                                  AutomationProperties.Name="Launch OpenClaw at sign-in"
                                  OnContent="" OffContent="" MinWidth="0" Toggled="Startup_Toggled" />
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <controls:SetupProgressIndicator x:Name="FlowProgress" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Uid="Onboarding_V2_Back" Content="Back" MinWidth="100" Click="Back_Click" HorizontalAlignment="Left" />
            <Button x:Name="ContinueButton" Grid.Column="1" x:Uid="Onboarding_V2_Next" Content="Next" MinWidth="100" Click="Next_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
