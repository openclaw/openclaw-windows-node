<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.NativeGatewaySetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <DataTemplate x:Key="WrappedFooterAction">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="40,4,40,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
            <controls:OnboardingMascot x:Name="ProgressMascot" Mood="Working"
                                      HorizontalAlignment="Center" />
            <TextBlock x:Uid="Onboarding_Native_Title" Text="Install a local native gateway"
                       Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Uid="Onboarding_Native_ProgressSubtitle"
                       Text="Companion will prepare your Gateway, then help you connect your AI."
                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" IsTabStop="False"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <StackPanel x:Name="StepsPanel" Spacing="8" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextBlockStyle}"
                           AutomationProperties.AutomationId="NativeGatewaySetupStatus"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="NavigationFooter" Grid.Row="2" RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="12">
            <controls:SetupProgressIndicator x:Name="FlowProgress" Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center" />
            <Button x:Name="BackButton" Grid.Row="1" x:Uid="Onboarding_Native_Back" Content="Back"
                    Click="Back_Click" MinWidth="100" HorizontalAlignment="Left"
                    ContentTemplate="{StaticResource WrappedFooterAction}" />
            <Button x:Name="CancelButton" Grid.Row="1" Grid.Column="1" x:Uid="Onboarding_Native_Cancel" Content="Cancel setup"
                    MinWidth="100" HorizontalAlignment="Right" ContentTemplate="{StaticResource WrappedFooterAction}"
                    Visibility="Collapsed" Click="Cancel_Click" />
            <Button x:Name="RetryButton" Grid.Row="1" Grid.Column="1" x:Uid="Onboarding_Native_Retry" Content="Retry setup"
                    MinWidth="100" HorizontalAlignment="Right" ContentTemplate="{StaticResource WrappedFooterAction}"
                    Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="Retry_Click" />
        </Grid>
    </Grid>
</Page>
