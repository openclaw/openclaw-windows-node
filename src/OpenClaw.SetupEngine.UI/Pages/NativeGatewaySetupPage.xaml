<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.NativeGatewaySetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <Style x:Key="NativePhaseRowStyle" TargetType="tk:SettingsCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,14" />
        </Style>
        <DataTemplate x:Key="WrappedFooterAction">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <controls:SetupPageShell x:Name="NativeShell">
        <controls:SetupPageShell.Hero>
            <StackPanel Spacing="16">
                <Grid MaxWidth="280" HorizontalAlignment="Center" RowDefinitions="Auto,10">
                    <Border Padding="16,12" CornerRadius="12" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <TextBlock x:Uid="Onboarding_Native_ProgressSpeech" Text="Let's set up your Gateway."
                                   FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <Path Grid.Row="1" Data="M0,0 L10,10 L20,0" HorizontalAlignment="Center"
                          Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <controls:OnboardingMascot x:Name="ProgressMascot" Mood="Working" HorizontalAlignment="Center" />
                <controls:SetupStepIndicator x:Name="FlowProgress" Margin="24,8,0,0" />
            </StackPanel>
        </controls:SetupPageShell.Hero>
        <controls:SetupPageShell.Header>
        <StackPanel Spacing="12">
            <TextBlock x:Name="TitleText" x:Uid="Onboarding_Native_Title" Text="Install a local native gateway"
                       FontFamily="Segoe UI Variable" FontSize="40" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
            <TextBlock x:Uid="Onboarding_Native_ProgressSubtitle"
                       Text="Companion will prepare your Gateway, then help you connect your AI."
                       FontFamily="Segoe UI Variable" FontSize="18" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        </controls:SetupPageShell.Header>
        <controls:SetupPageShell.Body>
            <StackPanel Spacing="16">
                <StackPanel x:Name="StepsPanel" Spacing="0" />
                <TextBlock x:Name="AcquisitionNotice" x:Uid="Onboarding_Native_ProgressDeadline"
                           Text="Package installation and verification share a five-minute limit. Windows may finish deployment after cancellation. Retry checks registration again."
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextBlockStyle}"
                           AutomationProperties.AutomationId="NativeGatewaySetupStatus"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="RecoveryPanel" Spacing="8" Visibility="Collapsed"
                            AutomationProperties.AutomationId="NativeGatewaySetupRecovery">
                    <TextBlock x:Name="RecoveryGuidance" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="CollectDiagnosticsButton" x:Uid="Onboarding_Native_CollectDiagnostics"
                            Content="Collect Gateway diagnostics" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="NativeGatewaySetupCollectDiagnostics"
                            Click="CollectDiagnostics_Click" />
                    <Button x:Name="OpenTerminalButton" x:Uid="Onboarding_Native_Terminal" Content="Open terminal"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="NativeGatewaySetupOpenTerminal"
                            Click="OpenTerminal_Click" />
                    <TextBlock x:Name="RecoveryResult" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Style="{StaticResource BodyTextBlockStyle}"
                               AutomationProperties.AutomationId="NativeGatewaySetupRecoveryResult"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <InfoBar x:Name="FailureBar" IsOpen="False" IsClosable="False" Severity="Error"
                         AutomationProperties.AutomationId="NativeGatewaySetupFailure">
                    <TextBlock x:Name="FailureDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,12"
                               Visibility="Collapsed" />
                </InfoBar>
                <Expander x:Name="ActivityExpander" x:Uid="Onboarding_Native_Activity" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="48"
                          AutomationProperties.AutomationId="NativeGatewaySetupActivity"
                          Header="Detailed activity">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <Grid RowDefinitions="*,Auto" Padding="12,8">
                        <Border Grid.Row="0" CornerRadius="4" MinHeight="120" MaxHeight="200" Padding="12,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ScrollViewer x:Name="LogScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="NoWrap"
                                           IsTextSelectionEnabled="True"
                                           AutomationProperties.AutomationId="NativeGatewaySetupLog" />
                            </ScrollViewer>
                        </Border>
                        <HyperlinkButton x:Name="OpenLogButton" Grid.Row="1"
                                x:Uid="Onboarding_Native_OpenLog"
                                Content="Open log file"
                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                AutomationProperties.AutomationId="NativeGatewaySetupOpenLog"
                                Click="OpenLog_Click" Padding="8,4" />
                    </Grid>
                </Expander>
            </StackPanel>
        </controls:SetupPageShell.Body>
        <controls:SetupPageShell.Footer>
        <Grid x:Name="NavigationFooter" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="BackButton" x:Uid="Onboarding_Native_Back" Content="Back"
                    Click="Back_Click" MinWidth="100" MinHeight="40" HorizontalAlignment="Left"
                    ContentTemplate="{StaticResource WrappedFooterAction}" />
            <Button x:Name="CancelButton" Grid.Column="1" x:Uid="Onboarding_Native_Cancel" Content="Cancel setup"
                    MinWidth="100" MinHeight="40" HorizontalAlignment="Right" ContentTemplate="{StaticResource WrappedFooterAction}"
                    Visibility="Collapsed" Click="Cancel_Click" />
            <Button x:Name="RetryButton" Grid.Column="1" x:Uid="Onboarding_Native_Retry" Content="Retry setup"
                    MinWidth="100" MinHeight="40" HorizontalAlignment="Right" ContentTemplate="{StaticResource WrappedFooterAction}"
                    Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="Retry_Click" />
        </Grid>
        </controls:SetupPageShell.Footer>
    </controls:SetupPageShell>
</Page>
