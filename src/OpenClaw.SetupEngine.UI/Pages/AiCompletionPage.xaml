<Page x:Class="OpenClaw.SetupEngine.UI.Pages.AiCompletionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls">
    <StackPanel Padding="40,24" Spacing="16" VerticalAlignment="Center">
        <controls:OnboardingMascot Mood="Thinking" HorizontalAlignment="Center" />
        <TextBlock x:Uid="Onboarding_Finishing_Heading" Text="Finishing setup"
                   Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="Detail" x:Uid="Onboarding_Finishing_Detail"
                   Text="Applying your choices, restarting OpenClaw, and checking your AI. This may take a few minutes."
                   Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
        <ProgressBar x:Name="Progress" IsIndeterminate="True" MaxWidth="320" HorizontalAlignment="Stretch" />
        <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
        <Button x:Name="RetryButton" x:Uid="Onboarding_Ready_Return" Content="Check readiness again"
                Visibility="Collapsed" Click="Retry_Click" HorizontalAlignment="Center" />
        <Button x:Name="BackButton" x:Uid="Onboarding_V2_Back" Content="Back"
                Visibility="Collapsed" Click="Back_Click" HorizontalAlignment="Center" />
    </StackPanel>
</Page>
