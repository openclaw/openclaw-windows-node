<Page x:Class="OpenClaw.SetupEngine.UI.Pages.AiCompletionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">
        <StackPanel Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Uid="Onboarding_Finishing_Heading" Text="Finishing setup" Style="{StaticResource SetupHeroTitleTextStyle}" />
            <TextBlock x:Name="Detail" x:Uid="Onboarding_Finishing_Detail"
                       Text="Applying your choices, restarting OpenClaw, and checking your AI. This may take a few minutes."
                       Style="{StaticResource SetupHeroSubtitleTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,48,16" Spacing="16">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" HorizontalAlignment="Stretch" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
        </StackPanel>
        <StackPanel Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}">
            <Button x:Name="BackButton" x:Uid="Onboarding_V2_Back" Content="Back"
                    Visibility="Collapsed" Click="Back_Click" Style="{StaticResource SetupSecondaryButtonStyle}" />
            <Button x:Name="RetryButton" x:Uid="Onboarding_Ready_Return" Content="Check readiness again"
                    Visibility="Collapsed" Click="Retry_Click" Style="{StaticResource SetupPrimaryButtonStyle}" />
            <Button x:Name="CloseButton" Content="Close"
                    Visibility="Collapsed" Click="Close_Click" Style="{StaticResource SetupSecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
