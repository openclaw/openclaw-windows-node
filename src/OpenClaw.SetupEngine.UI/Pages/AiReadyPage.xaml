<Page x:Class="OpenClaw.SetupEngine.UI.Pages.AiReadyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="WrappedAction">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="160" Style="{StaticResource BodyTextBlockStyle}" />
            </DataTemplate>
            <!-- Matches CompletePage's summary rows so both final screens read the same. -->
            <Style x:Key="SummaryRowStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="Padding" Value="0,12" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource SetupHairlineBrush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">
        <StackPanel Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Name="Heading" Text="Finishing setup" Style="{StaticResource SetupHeroTitleTextStyle}" />
            <TextBlock x:Name="Prompt" Style="{StaticResource SetupHeroSubtitleTextStyle}" Visibility="Collapsed" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="{StaticResource SetupBodyMargin}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" Margin="{StaticResource SetupGutterMargin}">
                <StackPanel x:Name="SummaryPanel" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SetupHairlineBrush}">
                    <Grid Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE756;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="GatewayTitle" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Name="GatewaySummary" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Grid Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE772;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="PairedTitle" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Name="PairedSummary" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Grid Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xEA18;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="CapabilitiesTitle" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Name="CapabilitiesSummary" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Grid x:Name="ModelRow" Style="{StaticResource SummaryRowStyle}" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE99A;" Style="{StaticResource SetupGlyphStyle}" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="ModelTitle" Style="{StaticResource SetupRowTitleTextStyle}" />
                            <TextBlock x:Name="ModelSummary" Style="{StaticResource SetupRowDescriptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </StackPanel>
                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error">
                    <InfoBar.ActionButton>
                        <Button x:Name="RecoveryButton" x:Uid="Onboarding_Ready_Return" Content="Back to AI setup"
                                Click="Return_Click" ContentTemplate="{StaticResource WrappedAction}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource SetupFootnoteTextStyle}"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="ChatActionPanel" Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}" Visibility="Collapsed">
            <Button x:Name="ChatAction" Style="{StaticResource SetupPrimaryButtonStyle}" Click="OpenChat_Click" />
        </StackPanel>
    </Grid>
</Page>
