<Page x:Class="OpenClaw.SetupEngine.UI.Pages.AiReadyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <Style x:Key="ReadyChoice" TargetType="tk:SettingsCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,16" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="WrappedAction">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="160" Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <controls:SetupPageShell x:Name="ReadyShell">
        <controls:SetupPageShell.Hero>
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                <Grid MaxWidth="280" HorizontalAlignment="Center" RowDefinitions="Auto,10">
                    <Border Padding="16,12" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Uid="Onboarding_Ready_Speech" Text="Ready when you are."
                                   FontFamily="Segoe UI Variable" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <Path Grid.Row="1" Data="M0,0 L10,10 L20,0" HorizontalAlignment="Center"
                          Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <controls:OnboardingMascot x:Name="MascotHero" Mood="Thinking" HorizontalAlignment="Center" />
                <controls:SetupStepIndicator x:Name="FlowProgress" Margin="24,8,0,0" HorizontalAlignment="Stretch" />
            </StackPanel>
        </controls:SetupPageShell.Hero>
        <controls:SetupPageShell.Header>
            <StackPanel Spacing="12">
                <TextBlock x:Name="Heading" Text="Finishing setup"
                           FontFamily="Segoe UI Variable" FontSize="40" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1" TextAlignment="Left" TextWrapping="Wrap" />
                <TextBlock x:Name="ModelSummary" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Left" TextWrapping="Wrap" />
            </StackPanel>
        </controls:SetupPageShell.Header>
        <controls:SetupPageShell.Body>
            <StackPanel Spacing="8">
                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
                <StackPanel x:Name="ChatActionPanel" Spacing="8" Visibility="Collapsed">
                    <controls:SetupActionCard x:Name="ChatAction" x:Uid="Onboarding_Ready_Chat"
                                              AutomationProperties.Name="Talk to my agent" Header="Talk to my agent"
                                              Description="Open Chat with your agent." IsClickEnabled="True"
                                              Style="{StaticResource ReadyChoice}" InvokeRequested="OpenChat_Click" />
                </StackPanel>
            </StackPanel>
        </controls:SetupPageShell.Body>
        <controls:SetupPageShell.Footer>
            <Grid x:Name="ReadyFooter" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8">
                <ProgressBar x:Name="BusyProgress" Grid.ColumnSpan="2" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" VerticalAlignment="Center" />
                <Button x:Name="RecoveryButton" x:Uid="Onboarding_Ready_Return" Grid.Row="1" Grid.Column="1"
                        Content="Back to AI setup" MinWidth="100" MinHeight="40" HorizontalAlignment="Right"
                        Visibility="Collapsed"
                        Click="Return_Click" ContentTemplate="{StaticResource WrappedAction}" />
            </Grid>
        </controls:SetupPageShell.Footer>
    </controls:SetupPageShell>
</Page>
