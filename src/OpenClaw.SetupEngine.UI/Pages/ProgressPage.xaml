<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled">

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel x:Name="InstallHeader" Grid.Row="0" Padding="40,4,40,0" Spacing="4">
            <controls:OnboardingMascot x:Name="ProgressMascot" Mood="Working"
                                      HorizontalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="Setting up OpenClaw"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer x:Name="InstallContent" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="40,24,40,16" Spacing="16" VerticalAlignment="Top">

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="0">
                        <tk:SettingsCard x:Name="PreparePhase" x:Uid="Onboarding_V4_PhasePrepare"
                                         Header="Prepare your PC" Background="Transparent" BorderThickness="0" CornerRadius="0">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="PrepareActivity" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </tk:SettingsCard.Description>
                            <controls:SetupPhaseStatus x:Name="PrepareStatus" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="InstallPhase" x:Uid="Onboarding_V4_PhaseInstall"
                                         Header="Install the Gateway" Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="InstallActivity" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </tk:SettingsCard.Description>
                            <controls:SetupPhaseStatus x:Name="InstallStatus" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="ConnectPhase" x:Uid="Onboarding_V4_PhaseConnect"
                                         Header="Start and check connection" Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="ConnectActivity" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </tk:SettingsCard.Description>
                            <controls:SetupPhaseStatus x:Name="ConnectStatus" />
                        </tk:SettingsCard>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DownloadActivity" Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>

                <InfoBar x:Name="TailscaleAuthorizationPanel" Visibility="Collapsed" IsOpen="True" IsClosable="False"
                         Severity="Informational" Title="Authorize Tailscale">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TailscaleAuthorizationText" TextWrapping="Wrap" />
                        <HyperlinkButton x:Name="TailscaleAuthorizationLink" Content="Open Tailscale authorization"
                                         HorizontalAlignment="Left" Click="TailscaleAuthorization_Click" />
                    </StackPanel>
                </InfoBar>

                <Expander x:Name="DetailedActivity" x:Uid="Onboarding_V4_DetailedActivity" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="48"
                          Header="Detailed activity">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <Grid RowDefinitions="*,Auto" Padding="12,8">
                        <Border Grid.Row="0" CornerRadius="4" MinHeight="120" MaxHeight="200" Padding="12,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ScrollViewer x:Name="LogScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="NoWrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                        <HyperlinkButton x:Name="OpenLogButton" Grid.Row="1"
                                Content="Open log file"
                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                Click="OpenLog_Click" Padding="8,4" />
                    </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="MilestonePanel" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="16" MaxWidth="480" Padding="48,0">
            <Grid Width="{x:Bind controls:OnboardingMascot.HeroSize}" Height="{x:Bind controls:OnboardingMascot.HeroSize}"
                  HorizontalAlignment="Center" Margin="0,0,0,4">
                <controls:OnboardingMascot Mood="Happy" />
                <Border Width="36" Height="36" CornerRadius="18"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                        BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="3">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" IsTextScaleFactorEnabled="False"
                              Foreground="#FFFFFF"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw" />
                </Border>
            </Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="Gateway installed"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="Your private OpenClaw gateway is up and running on this PC."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="MilestoneStatusText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           AutomationProperties.LiveSetting="Assertive"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16,14" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <FontIcon Grid.Column="0" Glyph="&#xE72A;" FontSize="18" IsTextScaleFactorEnabled="False"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Up next: OpenClaw onboard" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="A few quick questions. Choose your AI provider, model, and key to connect your agent."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,16">
            <controls:SetupProgressIndicator x:Name="FlowProgress" Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="OnboardButton" Grid.Column="1" Content="Start OpenClaw onboard"
                    Visibility="Collapsed" MinWidth="100" HorizontalAlignment="Right"
                    Margin="48,0" Style="{StaticResource AccentButtonStyle}"
                    Click="Onboard_Click" />
        </Grid>

    </Grid>
</Page>
