<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled">

    <controls:SetupPageShell x:Name="InstallationShell">
        <controls:SetupPageShell.Hero>
            <StackPanel Spacing="16">
                <Grid MaxWidth="280" HorizontalAlignment="Center" RowDefinitions="Auto,10">
                    <Border Padding="16,12" CornerRadius="12" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <TextBlock x:Name="ProgressSpeech" x:Uid="Onboarding_V4_InstallationSpeech"
                                   Text="Working on it..." FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <Path Grid.Row="1" Data="M0,0 L10,10 L20,0" HorizontalAlignment="Center"
                          Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <controls:OnboardingMascot x:Name="ProgressMascot" Mood="Working" HorizontalAlignment="Center" />
                <controls:SetupStepIndicator x:Name="FlowProgress" Margin="24,8,0,0" />
            </StackPanel>
        </controls:SetupPageShell.Hero>
        <controls:SetupPageShell.Header>
        <StackPanel x:Name="InstallHeader" Spacing="12">
            <TextBlock x:Name="TitleText" Text="Setting up OpenClaw"
                       FontFamily="Segoe UI Variable" FontSize="40" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText"
                       FontFamily="Segoe UI Variable" FontSize="18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite"
                       TextWrapping="Wrap" />
        </StackPanel>
        </controls:SetupPageShell.Header>
        <controls:SetupPageShell.Body>
        <Grid>
            <StackPanel x:Name="InstallContent" Spacing="16" VerticalAlignment="Top">
                    <StackPanel Spacing="0">
                        <tk:SettingsCard x:Name="PreparePhase" x:Uid="Onboarding_V4_PhasePrepare"
                                         Header="Prepare your PC" Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,14">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="PrepareActivity" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </tk:SettingsCard.Description>
                            <controls:SetupPhaseStatus x:Name="PrepareStatus" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="InstallPhase" x:Uid="Onboarding_V4_PhaseInstall"
                                         Header="Install the Gateway" Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,14">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="InstallActivity" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </tk:SettingsCard.Description>
                            <controls:SetupPhaseStatus x:Name="InstallStatus" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="ConnectPhase" x:Uid="Onboarding_V4_PhaseConnect"
                                         Header="Start and check connection" Background="Transparent" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,14">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="ConnectActivity" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </tk:SettingsCard.Description>
                            <controls:SetupPhaseStatus x:Name="ConnectStatus" />
                        </tk:SettingsCard>
                    </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DownloadActivity" Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="1" Visibility="Collapsed"
                                 AutomationProperties.LabeledBy="{x:Bind DownloadActivity}" />
                </StackPanel>

                <InfoBar x:Name="TailscaleAuthorizationPanel" Visibility="Collapsed" IsOpen="True" IsClosable="False"
                         Severity="Informational" Title="Authorize Tailscale">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TailscaleAuthorizationText" TextWrapping="Wrap" />
                        <HyperlinkButton x:Name="TailscaleAuthorizationLink" Content="Open Tailscale authorization"
                                         HorizontalAlignment="Left" Click="TailscaleAuthorization_Click" />
                    </StackPanel>
                </InfoBar>

                <Expander x:Name="DetailedActivity" x:Uid="Onboarding_V4_DetailedActivity" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="48"
                          Background="Transparent" BorderThickness="0"
                          Header="Detailed activity">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <Grid RowDefinitions="*,Auto" Padding="12,8">
                        <Border Grid.Row="0" CornerRadius="4" MinHeight="120" MaxHeight="200" Padding="12,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ScrollViewer x:Name="LogScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="NoWrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                        <HyperlinkButton x:Name="OpenLogButton" Grid.Row="1"
                                Content="Open log file"
                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                Click="OpenLog_Click" Padding="8,4" />
                    </Grid>
                </Expander>

            </StackPanel>

        <StackPanel x:Name="MilestonePanel" Visibility="Collapsed" Spacing="16">
                <TextBlock x:Name="MilestoneStatusText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           AutomationProperties.LiveSetting="Assertive"
                           TextWrapping="Wrap" />
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    Padding="0,14" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <FontIcon Grid.Column="0" Glyph="&#xE72A;" FontSize="18" IsTextScaleFactorEnabled="False"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Onboarding_V4_MilestoneNext" Text="Up next: OpenClaw onboard"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="Onboarding_V4_MilestoneNextDescription"
                                   Text="A few quick questions. Choose your AI provider, model, and key to connect your agent."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
        </controls:SetupPageShell.Body>
        <controls:SetupPageShell.Footer>
        <Grid x:Name="NavigationFooter" ColumnDefinitions="*,Auto">
            <Button x:Name="OnboardButton" x:Uid="Onboarding_V4_MilestoneContinue" Grid.Column="1" Content="Start OpenClaw onboard"
                    Visibility="Collapsed" MinWidth="100" MinHeight="40" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Onboard_Click" />
        </Grid>
        </controls:SetupPageShell.Footer>
    </controls:SetupPageShell>
</Page>
