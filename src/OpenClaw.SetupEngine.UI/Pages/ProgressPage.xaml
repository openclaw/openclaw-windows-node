<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    xmlns:themes="using:OpenClaw.SetupEngine.UI.Themes"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:SetupResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="{StaticResource SetupPagePadding}" RowDefinitions="Auto,*,Auto">

        <StackPanel x:Name="InstallHeader" Grid.Row="0" Style="{StaticResource SetupHeroPanelStyle}">
            <TextBlock x:Name="TitleText" Text="Making room for your agent"
                       Style="{StaticResource SetupHeroTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource SetupHeroSubtitleTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <ScrollViewer x:Name="InstallContent" Grid.Row="1" Margin="{StaticResource SetupBodyMargin}"
                      VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="{StaticResource SetupGutterMargin}" Spacing="16" VerticalAlignment="Top">

                <StackPanel x:Name="PhaseRows" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SetupHairlineBrush}">
                    <controls:SetupPhaseStatus x:Name="PrepareStatus" x:Uid="Onboarding_V4_PhasePrepare" Header="Prepare your PC" />
                    <controls:SetupPhaseStatus x:Name="InstallStatus" x:Uid="Onboarding_V4_PhaseInstall" Header="Install the Gateway" />
                    <controls:SetupPhaseStatus x:Name="ConnectStatus" x:Uid="Onboarding_V4_PhaseConnect" Header="Start and check connection" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="DownloadActivity" Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>

                <InfoBar x:Name="TailscaleAuthorizationPanel" Visibility="Collapsed" IsOpen="True" IsClosable="False"
                         Severity="Informational" Title="Authorize Tailscale">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TailscaleAuthorizationText" TextWrapping="Wrap" />
                        <HyperlinkButton x:Name="TailscaleAuthorizationLink" Content="Open Tailscale authorization"
                                         HorizontalAlignment="Left" Click="TailscaleAuthorization_Click" />
                    </StackPanel>
                </InfoBar>

                <StackPanel x:Name="DetailedActivity" Spacing="8">
                    <HyperlinkButton x:Name="DetailsToggle" Style="{StaticResource SetupLinkButtonStyle}" Click="DetailsToggle_Click" />
                    <StackPanel x:Name="DetailsPanel" Spacing="4" Visibility="Collapsed">
                        <Border CornerRadius="6" MinHeight="120" MaxHeight="200" Padding="12,10"
                                Background="{ThemeResource SetupConsoleBackgroundBrush}">
                            <ScrollViewer x:Name="LogScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="NoWrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                        <HyperlinkButton x:Name="OpenLogButton" x:Uid="Onboarding_Progress_OpenLog" Content="Open log file"
                                         Style="{StaticResource SetupLinkButtonStyle}" Click="OpenLog_Click" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Gateway-installed milestone: the companion shows the success badge. -->
        <StackPanel x:Name="MilestonePanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                    Margin="{StaticResource SetupGutterMargin}" Spacing="24">
            <StackPanel Spacing="10">
                <TextBlock Text="Gateway installed" Style="{StaticResource SetupHeroTitleTextStyle}"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="Your private OpenClaw gateway is up and running on this PC."
                           Style="{StaticResource SetupHeroSubtitleTextStyle}" />
                <TextBlock x:Name="MilestoneStatusText"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="0,12"
                  BorderThickness="0,1" BorderBrush="{ThemeResource SetupHairlineBrush}">
                <controls:SetupGlyphTile Glyph="&#xE72A;" IsActive="True" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Up next: OpenClaw onboard" Style="{StaticResource SetupRowTitleTextStyle}" />
                    <TextBlock Text="A few quick questions. Choose your AI provider, model, and key to connect your agent."
                               Style="{StaticResource SetupRowDescriptionTextStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupNavPanelStyle}">
            <Button x:Name="OnboardButton" Content="Start OpenClaw onboard"
                    Visibility="Collapsed" Style="{StaticResource SetupPrimaryButtonStyle}"
                    Click="Onboard_Click" />
        </StackPanel>

    </Grid>
</Page>
