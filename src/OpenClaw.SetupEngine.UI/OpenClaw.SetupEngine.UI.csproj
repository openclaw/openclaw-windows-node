<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenClaw.SetupEngine.UI</RootNamespace>
    <AssemblyName>OpenClaw.SetupEngine.UI</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefineConstants>$(DefineConstants);OPENCLAW_SETUP_UI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MicrosoftWindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(MicrosoftWindowsSdkBuildToolsVersion)" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClaw.SetupEngine\OpenClaw.SetupEngine.csproj" />
    <ProjectReference Include="..\OpenClaw.Shared\OpenClaw.Shared.csproj" />
  </ItemGroup>

  <!-- Reuse Setup assets from the Tray project -->
  <ItemGroup>
    <Compile Include="..\OpenClaw.Tray.WinUI\Helpers\FluentIconCatalog.cs" Link="FluentIconCatalog.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\OpenClaw.Tray.WinUI\Assets\Setup\**\*"
             Link="Assets\Setup\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Bundle default config -->
  <ItemGroup>
    <Content Include="..\OpenClaw.SetupEngine\default-config.json"
             Link="default-config.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    WinUI's resource pipeline relocates linked setup assets into the
    library-qualified output directory, but a clean build can expose those
    files to a consuming project before every relocated file exists. Re-copy
    the source assets after this project's Build completes so both the loose
    content contract and the ms-appx library-qualified contract are complete
    before OpenClaw.Tray.WinUI copies project-reference outputs.
  -->
  <Target Name="CopySetupAssetsAfterResourceBuild" AfterTargets="Build">
    <ItemGroup>
      <_SetupAssetOutputSource Include="..\OpenClaw.Tray.WinUI\Assets\Setup\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SetupAssetOutputSource)"
          DestinationFiles="@(_SetupAssetOutputSource->'$(TargetDir)Assets\Setup\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SetupAssetOutputSource)"
          DestinationFiles="@(_SetupAssetOutputSource->'$(TargetDir)$(AssemblyName)\Assets\Setup\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
